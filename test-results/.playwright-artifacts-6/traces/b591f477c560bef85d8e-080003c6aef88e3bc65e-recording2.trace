"Visuele bouwblokken"],"\n              ",["H2",{"id":"workspaceTitle"},"Nieuwe leerbox"],"\n            "],"\n            ",["DIV",{"class":"workspace-actions","aria-label":"Snelle bouwcommando's"},"\n              ",["BUTTON",{"class":"secondary-action","type":"button","id":"addObjectButton","title":"Nieuw object","aria-label":"Nieuw object"},["SPAN",{"aria-hidden":"true"},"⬡"],["SMALL",{},"Object"]],"\n              ",["BUTTON",{"class":"secondary-action","type":"button","id":"addStepButton","title":"Nieuwe routestap","aria-label":"Nieuwe routestap"},["SPAN",{"aria-hidden":"true"},"➜"],["SMALL",{},"Stap"]],"\n              ",["BUTTON",{"class":"secondary-action","type":"button","id":"addDependencyButton","title":"Nieuwe conditionele afhankelijkheid","aria-label":"Nieuwe conditionele afhankelijkheid"},["SPAN",{"aria-hidden":"true"},"▣"],["SMALL",{},"Voorwaarde"]],"\n            "],"\n          "],"\n\n          ",["NAV",{"class":"workspace-view-tabs","aria-label":"Synchrone views"},"\n            ",["BUTTON",{"class":"workspace-view-button","type":"button","data-workspace-view":"latex","title":"LaTeX-plan"},["SPAN",{"aria-hidden":"true"},"▤"],["SMALL",{},"Plan"]],"\n            ",["BUTTON",{"class":"workspace-view-button","type":"button","data-workspace-view":"architecture","title":"Leerarchitectuur"},["SPAN",{"aria-hidden":"true"},"⌘"],["SMALL",{},"Structuur"]],"\n            ",["BUTTON",{"class":"workspace-view-button is-active","type":"button","data-workspace-view":"vat","title":"Gevatte leerbox"},["SPAN",{"aria-hidden":"true"},"⌬"],["SMALL",{},"Kaart"]],"\n            ",["BUTTON",{"class":"workspace-view-button","type":"button","data-workspace-view":"statements","title":"Computertaal-statements"},["SPAN",{"aria-hidden":"true"},"{ }"],["SMALL",{},"Code"]],"\n          "],"\n\n          ",["SECTION",{"class":"workspace-view","data-workspace-view":"latex"},"\n            ",["HEADER",{"class":"workspace-floating-header"},["DIV",{},["SPAN",{"aria-hidden":"true"},"▤"],["STRONG",{},"Plan"]],["BUTTON",{"type":"button","data-workspace-close":"","aria-label":"Plan inklappen","title":"Inklappen"},"−"]],"\n            ",["DIV",{"class":"latex-toolbar"},"\n              ",["DIV",{"class":"plan-view-switch","role":"group","aria-label":"Weergave van het ontwerpplan"},"\n                ",["BUTTON",{"type":"button","class":"plan-view-button is-active","data-plan-view":"source"},"TeX"],"\n                ",["BUTTON",{"type":"button","class":"plan-view-button","data-plan-view":"pdf"},"PDF"],"\n                ",["BUTTON",{"type":"button","class":"plan-view-button","data-plan-view":"json"},"JSON"],"\n              "],"\n              ",["BUTTON",{"class":"secondary-action","type":"button","id":"downloadLatexButton"},"Download .tex"],"\n            "],"\n            ",["DIV",{"id":"latexPreview","class":"latex-preview"},"\n      ",["ARTICLE",{"class":"enrichment-plan"},"\n        ",["HEADER",{},"\n          ",["SPAN",{},"Verrijkingsplan · bestaande leerattractie"],"\n          ",["H3",{},"Van bestaande leerattractie naar een gevatte leerbox"],"\n          ",["P",{},"We willen de bestaande leerattractie vatten in een leerbox. Dat betekent dat we de aanwezige onderwijsarchitectuur eerst herkenbaar vastleggen en haar daarna doelgericht verrijken met handelingsmogelijkheden, feedback, vrijheid, herstel en observeerbaar succes."],"\n        "],"\n        ",["SECTION",{},"\n          ",["H4",{},"Werkwijze en rol van de Leerpretarchitect"],"\n          ",["P",{},"De Leerpretarchitect bewaakt de bedoeling van de bestaande praktijk, controleert of de herkenning klopt, kiest welke verrijkingen passend zijn en voorkomt dat techniek of spelvorm het leerdoel overneemt. De architect accordeert dus zowel de vertaling als de verwachte bijdrage aan Leerpret."],"\n          ",["OL",{},["LI",{},"Herkennen: beschrijven wat al aanwezig is in bedoeling, doelgroep, start, route, weerstand en succes."],["LI",{},"Herleiden: verbinden van bronuitspraken aan velden in de onderwijsarchitectuur."],["LI",{},"Vatten: vertalen naar leerobjecten, acties, routes, afhankelijkheden en meetbare succesmomenten."],["LI",{},"Verrijken: toevoegen wat nog ontbreekt voor tijd, activiteit, variatie, veerkracht en succes."],["LI",{},"Toetsen: observeren van echte actiereeksen en vergelijken van de gemeten Leerpret met de verwachting."]],"\n        "],"\n        ",["SECTION",{},"\n          ",["H4",{},"Herkende onderwijsarchitectuur"],"\n          ",["P",{},"Dit is wat in de huidige leerattractie en de beschikbare bronnen is herkend."],"\n          ",["DIV",{"class":"plan-recognized-grid"},"\n            \n              ",["ARTICLE",{},"\n                ",["H5",{},"Gevatte structuur"],"\n                ",["DL",{},["DIV",{},["DT",{},"Leerobjecten"],["DD",{},"0"]],["DIV",{},["DT",{},"Routestappen"],["DD",{},"0"]],["DIV",{},["DT",{},"Afhankelijkheden"],["DD",{},"0"]]],"\n              "],"\n          "],"\n        "],"\n        ",["SECTION",{},"\n          ",["H4",{},"Bronvermelding"],"\n          ",["P",{},"Voor dit plan beschikbare en in de capture geregistreerde bronnen:"],"\n          ",["UL",{},["LI",{},"leerbox.nl"],["LI",{},"articles/Leerpret gevat.tex"],["LI",{},"wikibooks/collections/leerpret-bronnen"],["LI",{},"wikibooks/books"]],"\n        "],"\n        ",["SECTION",{},"\n          ",["H4",{},"Voorgestelde verrijkingen"],"\n          ",["P",{},"Deze onderdelen zijn nog niet aanwezig. De Leerpretarchitect beoordeelt, concretiseert en accordeert iedere verrijking."],"\n          ",["DIV",{"class":"plan-enrichment-list"},"\n            \n              ",["ARTICLE",{},"\n                ",["SPAN",{},"1"],"\n                ",["DIV",{},["H5",{},"Leerdoel expliciteren"],["P",{},"Formuleer het beoogde leren als waarneembare verandering, zodat keuzes en succes eraan getoetst kunnen worden."]],"\n                ",["ASIDE",{},["B",{},"A · S"],["SMALL",{},"Meer gerichte activiteit en beter herkenbaar succes."]],"\n              "],"\n            