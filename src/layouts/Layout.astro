  /* Operations-center theme: dark analytical dashboard with cyan instrumentation. */
  :root {
    color-scheme: dark;
    --bg: #07161c;
    --panel: #0d252d;
    --surface-soft: #113038;
    --ink: #e7f7f5;
    --muted: #8aabb0;
    --line: #28515a;
    --green: #63e6bd;
    --green-light: #123c3d;
    --green-border: #2a8d85;
    --blue: #66c7e8;
    --coral: #ff8f70;
    --plum: #9ee7e2;
    --amber: #e6c56b;
    --violet: #a6a5f5;
    --teal: #42d8d0;
    --bad: #3c2025;
    --bad-line: #9f4b59;
    --warn: #3a321d;
    --warn-line: #9d8138;
  }

  body {
    background-color: var(--bg);
    background-image:
      linear-gradient(rgba(76, 187, 190, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(76, 187, 190, .035) 1px, transparent 1px),
      radial-gradient(circle at 50% -10%, rgba(48, 143, 150, .2), transparent 48%);
