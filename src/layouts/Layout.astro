---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Proof of Concept Leerpretengine - Mobile-First Dashboard" } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const usesParkMetrics = currentPath.startsWith('/park') || currentPath.startsWith(`${base}/park`);
const usesHomeMetrics = currentPath === '/' || currentPath === '/index.html' || currentPath === `${base}` || currentPath === `${base}/`;
const usesArticleMetrics = currentPath.startsWith('/article') || currentPath.startsWith(`${base}/article`);
const usesHelpMetrics = currentPath.startsWith('/help') || currentPath.startsWith(`${base}/help`);
const usesDataMetrics = currentPath.startsWith('/data') || currentPath.startsWith(`${base}/data`);
const usesServiceMetrics = currentPath.startsWith('/service') || currentPath.startsWith(`${base}/service`);

// Active state helper for server-side templates
const isActive = (path) => {
  const target = `${base}${path}`;
  if (path === '/') return currentPath === '/' || currentPath === '/index.html' || currentPath === `${base}` || currentPath === `${base}/`;
  return currentPath.startsWith(target);
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} | Leerpret Dashboard</title>
    <script is:inline src={`${import.meta.env.BASE_URL}runtime-config.js`}></script>
    <script is:inline src={`${import.meta.env.BASE_URL}role-routing.js`}></script>
    
    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">

    <!-- MathJax for TeX rendering -->
    <script is:inline>
      window.MathJax = {
        tex: { inlineMath: [["$", "$"], ["\\(", "\\)"]] },
        svg: { fontCache: "global" }
      };
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  </head>
  <body>
    <!-- Persistent Header app-titlebar (Universal Structure) -->
    <header class="app-titlebar">
      <h1>Proof of Concept - Leerpretengine</h1>
      <p>{description}</p>
      
      <!-- Universal Status & Metrics Bar (All in 1 Row) -->
      <div class="universal-status-bar offline" id="universal-status-bar">
        <div class="status-page" id="status-active-page" title="Actieve pagina" data-i18n-title="status.activePage">
          <strong>{title}</strong>
        </div>
        <span class="status-divider">|</span>
        <div class="status-role" id="status-active-role" title="Actieve rol" data-i18n-title="status.activeRole">
          <strong>Leerpretarchitect</strong>
        </div>
        <span class="status-divider">|</span>
        <div class="status-connection">
          <span class="status-dot"></span>
          <span class="status-message" data-i18n="status.connecting">Verbinding maken...</span>
        </div>
        <span class="status-divider">|</span>
        <div class="status-metric" id="status-metric-attractions">
          <span class="metric-num">-</span>
          <span class="metric-lbl">{usesServiceMetrics ? 'Gedragsmarkers' : usesDataMetrics ? 'Groepen' : usesHelpMetrics ? "Pagina's" : usesArticleMetrics ? 'Artikelen' : usesHomeMetrics ? 'Onderdelen' : usesParkMetrics ? 'Leerpretparken' : 'Leerboxen'}</span>
        </div>
        <span class="status-divider">|</span>
        <div class="status-metric" id="status-metric-objects">
          <span class="metric-num">-</span>
          <span class="metric-lbl">{usesServiceMetrics ? 'Archetypen' : usesDataMetrics ? 'JSON-bestanden' : usesHelpMetrics ? 'Afbeeldingen' : usesArticleMetrics ? 'Gepubliceerd' : usesHomeMetrics ? 'Rollen' : usesParkMetrics ? 'Leerattracties' : 'Leerobjecten'}</span>
        </div>
        {usesDataMetrics ? (
          <>
            <span class="status-divider">|</span>
            <div class="status-metric" id="status-metric-routes">
              <span class="metric-num">-</span>
              <span class="metric-lbl">Datasetgroepen</span>
            </div>
            <span class="status-divider">|</span>
            <div class="status-metric" id="status-metric-code-fragments">
              <span class="metric-num">-</span>
              <span class="metric-lbl">Codefragmenten</span>
            </div>
          </>
        ) : (
          <>
            <span class="status-divider">|</span>
            <div class="status-metric" id="status-metric-routes">
              <span class="metric-num">-</span>
              <span class="metric-lbl">{usesServiceMetrics ? 'Leerobjecttypen' : usesHelpMetrics ? 'Onderwerpen' : usesArticleMetrics ? 'Open' : usesHomeMetrics ? "Pagina's" : usesParkMetrics ? 'Leerboxen' : 'Routes'}</span>
            </div>
            {!usesServiceMetrics && !usesHelpMetrics && !usesArticleMetrics && !usesHomeMetrics && !usesParkMetrics && (
              <>
                <span class="status-divider">|</span>
                <div class="status-metric" id="status-metric-sources">
                  <span class="metric-num">0</span>
                  <span class="metric-lbl">Bronnen</span>
                </div>
              </>
            )}
          </>
        )}
      </div>
    </header>

    <!-- Persistent Control Dock Menu (Original Dock Layout) -->
    <section class="control-dock" aria-label="Dashboardmenu" data-i18n-aria-label="dock.title">
      
      <!-- Role Popover -->
      <div class="dock-popover" id="role-popover">
        <button class="icon-button person-button" type="button" aria-label="Kies rolperspectief" title="Rolperspectief" data-i18n-aria-label="dock.role.aria" data-i18n-title="dock.role" data-dock-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="nav-btn-icon" style="width: 22px; height: 22px;">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </button>
        <nav class="dock-menu role-menu" id="role-menu" aria-label="Rolperspectief" data-i18n-aria-label="dock.role">
          <a href={`${base}/article?role=architect`} class="role-link">
            <svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5z"/>
              <path d="m6 6 12 12M13 6l5 5M8 11l5 5"/>
            </svg>
            <strong>Leerpretarchitect</strong>
          </a>
          <a href={`${base}/article?role=technologist`} class="role-link">
            <svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <strong>Leerprettechnoloog</strong>
          </a>
          <a href={`${base}/article?role=user`} class="role-link">
            <svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18h12M3 22h18M18 10a6 6 0 0 0-12 0c0 4 6 8 6 8s6-4 6-8z"/>
              <circle cx="12" cy="10" r="2"/>
            </svg>
            <strong data-i18n="role.attraction">Leerattractie</strong>
          </a>
          <a href={`${base}/article?role=learner`} class="role-link">
            <svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <strong data-i18n="role.learner">Lerende</strong>
          </a>
          <a href={`${base}/article?role=guest`} class="role-link">
            <svg class="role-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 21a8 8 0 0 1 16 0"/>
            </svg>
            <strong data-i18n="role.guest">Gast</strong>
          </a>
        </nav>
      </div>

      <!-- Hamburger Navigation Menu -->
      <div class="dock-popover">
        <button class="icon-button hamburger-button" type="button" aria-label="Kies onderdeel" title="Menu" data-i18n-aria-label="dock.menu.aria" data-i18n-title="dock.menu" data-dock-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="nav-btn-icon" style="width: 22px; height: 22px;">
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </button>
        <nav class="dock-menu view-menu nav" aria-label="Werkbanken" data-i18n-aria-label="dock.workbenches">
          <a href={`${base}/`} data-route="/" class={`nav-button ${isActive('/') ? 'active' : ''}`} data-i18n="nav.home">Home</a>
          <a href={`${base}/park`} data-route="/park" class={`nav-button ${isActive('/park') ? 'active' : ''}`} data-i18n="nav.park">Leerpretpark</a>
          <a href={`${base}/article`} data-route="/article" class={`nav-button ${isActive('/article') ? 'active' : ''}`} id="nav-link-article" data-i18n="nav.article">Artikel</a>
          <a href={`${base}/learningbox`} data-route="/learningbox" class={`nav-button ${isActive('/learningbox') ? 'active' : ''}`} data-i18n="nav.learningbox">Leerbox</a>
          <a href={`${base}/editor`} data-route="/editor" class={`nav-button ${isActive('/editor') ? 'active' : ''}`} id="nav-link-editor" data-i18n="nav.editor">Editor</a>
          <a href={`${base}/preview`} data-route="/preview" class={`nav-button ${isActive('/preview') ? 'active' : ''}`} id="nav-link-preview" data-i18n="nav.preview">Preview</a>
          <a href={`${base}/engine`} data-route="/engine" class={`nav-button ${isActive('/engine') ? 'active' : ''}`} id="nav-link-engine" data-i18n="nav.engine">Engine</a>
          <a href={`${base}/snn-innovation-test`} data-route="/snn-innovation-test" class={`nav-button ${isActive('/snn-innovation-test') ? 'active' : ''}`} id="nav-link-snn-innovation-test" data-i18n="nav.snnInnovationTest">SNN Innovatietest</a>
          <a href={`${base}/data`} data-route="/data" class={`nav-button ${isActive('/data') ? 'active' : ''}`} id="nav-link-data" data-i18n="nav.data">Data</a>
          <a href={`${base}/service`} data-route="/service" class={`nav-button ${isActive('/service') ? 'active' : ''}`} data-i18n="nav.service">Service</a>
          <a href={`${base}/help`} data-route="/help" class={`nav-button ${isActive('/help') ? 'active' : ''}`} id="nav-link-help" data-i18n="nav.help">Help</a>
        </nav>
      </div>

      <!-- Settings Gear Popover -->
      <div class="dock-popover settings-popover">
        <button class="icon-button gear-button" type="button" aria-label="Instellingen" title="Instellingen" data-i18n-aria-label="settings.title" data-i18n-title="settings.title" data-dock-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="nav-btn-icon" style="width: 22px; height: 22px;">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </button>
        <section class="dock-menu api-panel">
          <label for="settings-language" data-i18n="settings.language">Taal</label>
          <select id="settings-language">
            <option value="nl">Nederlands</option>
            <option value="en">English</option>
            <option value="es">Español</option>
            <option value="de">Deutsch</option>
          </select>
          <label for="api-base" data-i18n="settings.service">Service</label>
          <input id="api-base" type="url" value="" />
          <div class="settings-actions">
            <button id="auth-login" class="btn-sm" type="button" data-i18n="auth.login">Login</button>
            <button id="auth-logout" class="btn-sm" type="button" data-i18n="auth.logout">Logout</button>
          </div>
          <a class="settings-access-link" href="/settings?block=access_management" data-i18n="settings.access">Toegang</a>
          <a class="settings-access-link privacy-access-link" href="/privacy" data-i18n="settings.privacy">Privacy &amp; data</a>
          <details class="engine-refinement-panel" id="engine-refinement-panel" hidden>
            <summary>Engine-verfijningen</summary>
            <label class="engine-refinement-toggle" for="activity-threshold-enabled">
              <input id="activity-threshold-enabled" type="checkbox" />
              <span>Activiteitsdrempel toepassen</span>
            </label>
            <label for="activity-threshold-slider">θ<sub>A</sub> (activiteitsdrempel)</label>
            <div class="engine-refinement-slider-row">
              <input id="activity-threshold-slider" type="range" min="0.10" max="0.20" step="0.01" value="0.15" />
              <strong id="activity-threshold-value">0.15</strong>
            </div>
            <p class="engine-refinement-caption" id="activity-threshold-caption"></p>
          </details>
        </section>
      </div>

    </section>



    <!-- Main View Shell -->
    <main class="app-shell">
      <slot />
    </main>

    <!-- Script to Hydrate API and Connection Health -->
    <script>
      import { state, initSettings, checkHealth, establishSession, logoutSession, clearServerSession, apiGet } from '../js/api.js';
      import { authUiState } from '../js/authUi.js';
      import { initializePageBlocks } from '../js/pageBlocks.js';
      import { applyTranslations, currentLanguage, setLanguage } from '../js/i18n.js';

      const PUBLIC_ROLE = 'guest';

      async function applySharedThemeTokens() {
        const configured = localStorage.getItem('api_base')
          || localStorage.getItem('leerpret.apiBase')
          || window.LEERPRET_CONFIG.apiBase;
        try {
          const { tokens = {}, version = 'api' } = await apiGet('/ui/theme-tokens?surface=dashboard');
          const variables = {
            bg: '--bg',
            panel: '--panel',
            surface_soft: '--surface-soft',
            ink: '--ink',
            muted: '--muted',
            line: '--line',
            accent: '--teal',
            accent_soft: '--green-light',
            accent_border: '--green-border',
            blue: '--blue',
            coral: '--coral',
            amber: '--amber',
            violet: '--violet',
            font_heading: '--font-heading',
            font_body: '--font-body',
            touch_target: '--touch-target'
          };
          Object.entries(variables).forEach(([key, variable]) => {
            if (tokens[key]) document.documentElement.style.setProperty(variable, tokens[key]);
          });
          document.documentElement.dataset.themeSource = version;
        } catch {
          // De lokaal meegebouwde tokens blijven de offline fallback.
        }
      }

      function storedApiKey() {
        return localStorage.getItem('api_key') || localStorage.getItem('leerpret.apiKey') || '';
      }

      function isLoggedOut() {
        return localStorage.getItem('leerpret.loggedOut') === 'true' || !storedApiKey();
      }

      function setActiveRole(role) {
        localStorage.setItem('active_role', role);
        localStorage.setItem('leerpret.poc.role', role);
        state.activeRole = role;
      }

      function enforcePublicRole() {
        setActiveRole(PUBLIC_ROLE);
        updateActiveRoleStatus(PUBLIC_ROLE);
      }

      function updateAuthButtons(authorized) {
        const loginButton = document.getElementById('auth-login');
        const logoutButton = document.getElementById('auth-logout');
        const loggedIn = authorized === true;
        if (loginButton) {
          loginButton.hidden = loggedIn;
          loginButton.disabled = loggedIn;
        }
        if (logoutButton) {
          logoutButton.hidden = !loggedIn;
          logoutButton.disabled = !loggedIn;
        }
      }

      async function updateConnectionUI() {
        const bar = document.getElementById('universal-status-bar');
        const messageEl = bar?.querySelector('.status-message');
        const attractionsNum = document.querySelector('#status-metric-attractions .metric-num');
        const objectsNum = document.querySelector('#status-metric-objects .metric-num');
        const routesNum = document.querySelector('#status-metric-routes .metric-num');
        const sourcesNum = document.querySelector('#status-metric-sources .metric-num');
        const setSourcesMetric = (count) => {
          if (!sourcesNum) return;
          const value = Number(count);
          sourcesNum.textContent = Number.isFinite(value) ? String(value) : '0';
        };
        let sourceMetricRefreshTimer = 0;
        const refreshSourcesMetric = async () => {
          if (!sourcesNum) return;
          try {
            const summary = await apiGet('/project-buckets/summary');
            setSourcesMetric(summary.source_count);
          } catch (error) {
            setSourcesMetric(0);
          }
        };
        window.addEventListener('message', (event) => {
          if (event?.data?.type !== 'leerpret-source-count') return;
          window.clearTimeout(sourceMetricRefreshTimer);
          sourceMetricRefreshTimer = window.setTimeout(refreshSourcesMetric, 80);
        });
        const clientPath = window.LeerpretRoleRouting?.normalizePath(window.location.pathname) || window.location.pathname;
        const usesParkMetrics = clientPath.startsWith('/park');
        const usesHomeMetrics = clientPath === '/' || clientPath === '/index.html';
        const usesArticleMetrics = clientPath.startsWith('/article');
        const usesHelpMetrics = clientPath.startsWith('/help');
        const usesDataMetrics = clientPath.startsWith('/data');
        const usesServiceMetrics = clientPath.startsWith('/service');
        const setServiceMetrics = () => {
          if (attractionsNum) attractionsNum.textContent = '5';
          if (objectsNum) objectsNum.textContent = '5';
          if (routesNum) routesNum.textContent = '13';
        };
        if (usesServiceMetrics) setServiceMetrics();
        const setHomeMetrics = () => {
          const pages = document.querySelectorAll('.view-menu .nav-button').length;
          const roles = document.querySelectorAll('.role-menu .role-link').length;
          const componentPaths = new Set(
            [...document.querySelectorAll('.app-shell [data-href]')]
              .map((element) => element.getAttribute('data-href'))
              .filter(Boolean)
              .map((href) => new URL(href, window.location.origin).pathname)
          );
          if (attractionsNum) attractionsNum.textContent = String(componentPaths.size || Math.max(0, pages - 1));
          if (objectsNum) objectsNum.textContent = String(roles);
          if (routesNum) routesNum.textContent = String(pages);
        };

        if (usesHomeMetrics) setHomeMetrics();

        if (!bar || !messageEl) return;

        initSettings();
        const healthResult = await checkHealth();
        const isScopedLeerboxLogin =
          new URLSearchParams(window.location.search).get('auth_scope') === 'leerbox';

        if (healthResult.online) {
          const authResult = isScopedLeerboxLogin || isLoggedOut()
            ? { authorized: false, error: 'Niet ingelogd.' }
            : await establishSession();
          state.authorized = authResult.authorized === true;
          if (!authResult.authorized) enforcePublicRole();
          updateAuthButtons(state.authorized);
          
          bar.classList.toggle('online', authResult.authorized);
          bar.classList.toggle('offline', !authResult.authorized);
          messageEl.textContent = authResult.authorized ? 'Ingelogd' : 'Niet ingelogd';
          
          try {
            const response = await apiGet('/simulator/datasets');
            const twins = (response.leerbox_twins || []).filter(
              (t) => !["archief", "archived", "inactive", "inactief"].includes(String(t.status || "").toLowerCase()) &&
                     !["engine", "service"].includes(String(t.id || "").toLowerCase())
            );

            if (usesArticleMetrics || usesHelpMetrics || usesDataMetrics) {
              // De actieve pagina vult deze tellers vanuit de eigen workflow.
            } else if (usesServiceMetrics) {
              setServiceMetrics();
            } else if (usesHomeMetrics) {
              setHomeMetrics();
            } else if (usesParkMetrics) {
              const distinctCount = (fields) => new Set(
                twins
                  .map((twin) => fields.map((field) => twin[field]).find(Boolean))
                  .filter(Boolean)
                  .map(String)
              ).size;
              const parks = distinctCount(['leerpretpark_id', 'leerpretpark', 'park_id', 'park']) || 4;
              const attractions = distinctCount(['leerattractie_id', 'leerattractie', 'attraction_id', 'attraction', 'experience_id']) || twins.length;
              if (attractionsNum) attractionsNum.textContent = String(parks);
              if (objectsNum) objectsNum.textContent = String(attractions);
              if (routesNum) routesNum.textContent = String(twins.length);
            } else {
              if (attractionsNum) attractionsNum.textContent = twins.length.toString();

              const totalObjects = twins.reduce((sum, t) => sum + Number(t.metrics?.objects || t.objects?.length || 0), 0);
              if (objectsNum) objectsNum.textContent = totalObjects.toString();

              const totalRoutes = twins.reduce((sum, t) => sum + Number(t.metrics?.route_steps || t.route?.length || 0), 0);
              if (routesNum) routesNum.textContent = totalRoutes.toString();

              await refreshSourcesMetric();
            }
          } catch (e) {
            if (usesArticleMetrics || usesHelpMetrics || usesDataMetrics) {
              // Behoud de waarden die door de actieve pagina zijn gezet.
            } else if (usesServiceMetrics) {
              setServiceMetrics();
            } else if (usesHomeMetrics) {
              setHomeMetrics();
            } else {
              if (attractionsNum) attractionsNum.textContent = '0';
              if (objectsNum) objectsNum.textContent = usesParkMetrics ? '0' : '-';
              if (routesNum) routesNum.textContent = usesParkMetrics ? '0' : '-';
            }
          }

          window.dispatchEvent(new CustomEvent('service-connection-changed', { detail: { online: true, authorized: authResult.authorized } }));
          setupRoleMenu(state.authorized);
          setupAccessControl();
        } else {
          state.authorized = false;
          enforcePublicRole();
          updateAuthButtons(false);
          bar.classList.add('offline');
          bar.classList.remove('online');
          messageEl.textContent = 'Offline';
          
          if (usesArticleMetrics || usesHelpMetrics || usesDataMetrics) {
            // Paginaspecifieke statistiek is onafhankelijk van de healthstatus.
          } else if (usesHomeMetrics) {
            setHomeMetrics();
          } else {
            if (attractionsNum) attractionsNum.textContent = '0';
            if (objectsNum) objectsNum.textContent = usesParkMetrics ? '0' : '-';
            if (routesNum) routesNum.textContent = usesParkMetrics ? '0' : '-';
          }

          window.dispatchEvent(new CustomEvent('service-connection-changed', { detail: { online: false } }));
          setupRoleMenu(false);
          setupAccessControl();
        }
      }

      function setupRoleMenu(authorized) {
        const router = window.LeerpretRoleRouting;
        const urlParams = new URLSearchParams(window.location.search);
        const requestedRole = urlParams.get('role') || localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'architect';
        const sessionKnown = typeof authorized === 'boolean';
        const presentation = sessionKnown
          ? authUiState(authorized, requestedRole, PUBLIC_ROLE)
          : authUiState(!isLoggedOut(), requestedRole, PUBLIC_ROLE);
        const activeRole = presentation.activeRole;
        setActiveRole(activeRole);
        if (!presentation.loggedIn && urlParams.get('role') && urlParams.get('role') !== PUBLIC_ROLE) {
          urlParams.set('role', PUBLIC_ROLE);
          window.history.replaceState({}, '', `${window.location.pathname}?${urlParams.toString()}`);
        }
        updateActiveRoleStatus(activeRole);

        document.querySelectorAll('#role-menu a').forEach(link => {
          const roleAttr = new URL(link.getAttribute('href'), window.location.origin).searchParams.get('role');
          const roleAvailable = presentation.loggedIn || roleAttr === PUBLIC_ROLE;
          link.classList.toggle('disabled', !roleAvailable);
          link.setAttribute('aria-disabled', roleAvailable ? 'false' : 'true');
          link.tabIndex = roleAvailable ? 0 : -1;
          
          // Stay on the current page only when that page exists for the target role.
          link.setAttribute('href', router?.routeForRole(window.location.pathname, roleAttr) || `/?role=${roleAttr}`);

          link.onclick = !roleAvailable
            ? (event) => {
              event.preventDefault();
            }
            : null;

          if (roleAttr === activeRole) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      function updateActiveRoleStatus(activeRole) {
        const target = document.querySelector('#status-active-role strong');
        if (!target) return;
        const labels = {
          architect: 'Leerpretarchitect',
          technologist: 'Leerprettechnoloog',
          user: 'Leerattractie',
          learner: 'Lerende',
          guest: 'Gast',
          gebruiker: 'Leerattractie',
          lerende: 'Lerende'
        };
        target.textContent = labels[activeRole] || activeRole || 'Leerpretarchitect';
      }

      function setupAccessControl() {
        const activeRole = localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'architect';
        const router = window.LeerpretRoleRouting;
        const isTechnologist = activeRole === 'technologist';

        document.querySelectorAll('.view-menu [data-route]').forEach((link) => {
          const path = link.getAttribute('data-route') || '/';
          const allowed = router?.routeAllowed(path, activeRole) ?? true;
          link.style.display = allowed ? 'block' : 'none';
          link.setAttribute('href', router?.routeForRole(path, activeRole) || `${path}?role=${activeRole}`);
        });

        const refinementPanel = document.getElementById('engine-refinement-panel');
        if (refinementPanel) refinementPanel.hidden = !isTechnologist;
        const canSeeGovernanceSettings = ['architect', 'technologist'].includes(activeRole);
        document.querySelectorAll('.settings-access-link').forEach((link) => {
          link.hidden = !canSeeGovernanceSettings;
        });
      }

      // Taalkeuze: vertaalt het dashboard en geeft de taal door aan de ingebedde editor.
      function setupLanguageSetting() {
        const languageSelect = document.getElementById('settings-language');
        if (!languageSelect) return;
        languageSelect.value = currentLanguage();
        languageSelect.addEventListener('change', () => setLanguage(languageSelect.value));
        applyTranslations();
      }

      function setupSettingsPanel() {
        setupLanguageSetting();
        const apiBaseInput = document.getElementById('api-base');
        const thresholdEnabled = document.getElementById('activity-threshold-enabled');
        const thresholdSlider = document.getElementById('activity-threshold-slider');
        const thresholdValue = document.getElementById('activity-threshold-value');
        const thresholdCaption = document.getElementById('activity-threshold-caption');

        if (!apiBaseInput) return;

        apiBaseInput.value = localStorage.getItem('api_base') || window.LEERPRET_CONFIG.apiBase;
        if (thresholdEnabled) {
          thresholdEnabled.checked = localStorage.getItem('leerpret.engine.activityThresholdEnabled') !== 'false';
        }
        if (thresholdSlider) {
          thresholdSlider.value = localStorage.getItem('leerpret.engine.activityThreshold') || '0.15';
        }

        const updateThresholdUI = () => {
          const enabled = thresholdEnabled?.checked ?? true;
          const value = thresholdSlider?.value || '0.15';
          if (thresholdSlider) thresholdSlider.disabled = !enabled;
          if (thresholdValue) thresholdValue.textContent = Number(value).toFixed(2);
          if (thresholdCaption) {
            thresholdCaption.textContent = enabled
              ? 'Deze verfijning geldt in de handmatige analyse, simulaties en validatierapporten.'
              : 'De baseline-engine wordt gebruikt: T telt altijd volledig mee.';
          }
        };

        const saveThreshold = () => {
          if (thresholdEnabled) {
            localStorage.setItem('leerpret.engine.activityThresholdEnabled', String(thresholdEnabled.checked));
          }
          if (thresholdSlider) {
            localStorage.setItem('leerpret.engine.activityThreshold', thresholdSlider.value);
          }
          updateThresholdUI();
        };

        const save = () => {
          localStorage.setItem('api_base', apiBaseInput.value);
          localStorage.setItem('leerpret.apiBase', apiBaseInput.value);
          localStorage.setItem('org_id', localStorage.getItem('org_id') || 'local-dev');
          localStorage.setItem('leerpret.organization', localStorage.getItem('leerpret.organization') || 'local-dev');
          initSettings();
          updateAuthButtons(state.authorized);
          setupRoleMenu(state.authorized);
          setupAccessControl();
        };

        apiBaseInput.addEventListener('input', save);
        thresholdEnabled?.addEventListener('change', saveThreshold);
        thresholdSlider?.addEventListener('input', saveThreshold);
        updateAuthButtons(state.authorized);
        updateThresholdUI();

        document.getElementById('auth-login')?.addEventListener('click', () => {
          if (!state.authorized) {
            const base = window.location.pathname.startsWith('/LeerpretDashboard') ? '/LeerpretDashboard' : '';
            window.location.href = `${base}/login?role=${PUBLIC_ROLE}`;
            return;
          }
          save();
          window.location.reload();
        });

        document.getElementById('auth-logout')?.addEventListener('click', async () => {
          await clearServerSession();
          logoutSession();
          enforcePublicRole();
          updateAuthButtons(false);
          setupRoleMenu(false);
          setupAccessControl();
          const bar = document.getElementById('universal-status-bar');
          const messageEl = bar?.querySelector('.status-message');
          if (bar) {
            bar.classList.add('offline');
            bar.classList.remove('online');
          }
          if (messageEl) messageEl.textContent = 'Niet ingelogd';
          window.dispatchEvent(new CustomEvent('service-connection-changed', { detail: { online: state.online, authorized: false } }));
          const currentUrl = new URL(window.location.href);
          currentUrl.searchParams.set('role', PUBLIC_ROLE);
          window.location.href = currentUrl.pathname + currentUrl.search;
        });

      }

      function setupPopoverToggles() {
        document.querySelectorAll('[data-dock-toggle]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const popover = btn.closest('.dock-popover');
            document.querySelectorAll('.dock-popover').forEach(p => {
              if (p !== popover) p.classList.remove('open');
            });
            popover?.classList.toggle('open');
            e.stopPropagation();
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.dock-popover')) {
            document.querySelectorAll('.dock-popover').forEach(p => p.classList.remove('open'));
          }
        });
      }

      window.addEventListener('DOMContentLoaded', () => {
        applySharedThemeTokens();
        initializePageBlocks().catch((error) => console.warn('Bloknavigatie kon niet worden geladen', error));
        updateConnectionUI();
        setupPopoverToggles();
        setupRoleMenu();
        setupAccessControl();
        setupSettingsPanel();
        setInterval(updateConnectionUI, 15000);
      });
    </script>
  </body>
</html>

