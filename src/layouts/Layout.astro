    display: block;
  }

  .section-title {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 4px;
    background: var(--line);
    color: var(--muted);
  }

  .badge.passed {
    background: #ccfbf1;
    color: #115e59;
  }

  .badge.failed {
    background: #fee2e2;
    color: #991b1b;
  }

  .badge.missing, .badge.not_run {
    background: #f1f5f9;
    color: #475569;
  }

  /* Form Fields */
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 12px;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .input-group input, 
  .input-group select {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    background: white;
    width: 100%;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-group input:focus,
  .input-group select:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: white;
    color: var(--ink);
    padding: 12px 18px;
    font-weight: 600;
    transition: all 0.2s ease;
    text-decoration: none;
    text-align: center;
    width: 100%;
    margin-bottom: 8px;
  }

  .btn-primary {
    background: var(--green);
    border-color: var(--green);
    color: white;
    box-shadow: 0 4px 10px rgba(15, 118, 110, 0.2);
  }

  .btn-secondary {
    background: var(--bg);
    border-color: var(--line);
  }

  .btn-sm {
    min-height: 36px;
    padding: 6px 12px;
    font-size: 0.85rem;
    border-radius: 6px;
    width: auto;
  }

  .muted-text {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .stale-warning {
    background: var(--warn);
    border: 1px solid var(--warn-line);
    color: #854d0e;
    padding: 10px;
    border-radius: 10px;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }


