    function renderChecklist(roleId, step) {
      /* Het beoordelingsblok, inclusief de publicatieteller erboven, is er voor de
         rollen die het artikel beoordelen en vrijgeven. De overige rollen lezen
         alleen mee en krijgen het hele blok niet te zien. */
      const beoordeelt = ['architect', 'technologist'].includes(roleId);
      const checklistSection = document.getElementById('review-checklist-section');
      if (checklistSection) checklistSection.hidden = !beoordeelt;
      if (!beoordeelt) return;
      const reviewState = state.poc?.review_state?.reviews?.[roleId]?.[step.id] || null;
      const accepted = Boolean(reviewState?.accepted);
      const publisher = ['architect', 'technologist'].includes(roleId);
      const workflow = state.poc?.article_workflow?.[step.id] || {};
      const workflowStatus = workflowStatusFor(step.id);

      const workflowElement = document.getElementById('article-workflow-status');
      if (workflowElement) {
        const publisherCount = Object.values(workflow.publishers || {}).filter(Boolean).length;
        const reviewerCount = Object.values(workflow.reviewers || {}).filter(Boolean).length;
        workflowElement.className = `article-workflow-status ${workflowStatus.key}`;
        workflowElement.innerHTML = `
          <strong>${escapeHtml(workflowStatus.label)}</strong>
          <span>Publicatie ${publisherCount}/2 · verificatie ${reviewerCount}/2</span>
        `;
      }

      const checklistTitle = document.getElementById('review-checklist-title');
      if (checklistTitle) checklistTitle.textContent = publisher ? 'Publicatiebesluit' : 'Reviewvragen';
      const actionLabel = document.getElementById('review-action-label');
      if (actionLabel) actionLabel.textContent = publisher ? 'Publiceer vanuit deze rol' : 'Akkoord vanuit deze rol';
      const saveButton = document.getElementById('btn-save-review');
      if (saveButton) stelReviewKnopIn(saveButton, roleId, accepted);

      const label = document.getElementById('review-status-label');
      if (label) {
        label.textContent = accepted
          ? (publisher ? 'Publicatie akkoord' : 'Akkoord gegeven')
          : (publisher ? 'Nog niet gepubliceerd' : 'Nog te reviewen');
        label.className = `review-status-label ${accepted ? 'accepted' : 'pending'}`;
      }

      const checkbox = document.getElementById('review-checkbox-agree') as HTMLInputElement;
      if (checkbox) checkbox.checked = accepted;

      const noteInput = document.getElementById('review-note-input') as HTMLInputElement;
      if (noteInput) noteInput.value = reviewState?.note || '';

      const questionsList = document.getElementById('review-questions-list');
      if (questionsList) {
        const prompts = getRoleDetails(roleId).review_prompts || ["Is deze stap gerealiseerd?"];
        questionsList.innerHTML = prompts.map(prompt => `
          <li>
            <svg class="checklist-bullet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>${prompt}</span>
          </li>
        `).join('');
      }
    }

    /* Zet de knop onder de vragenlijst in de stand die past bij het bewaarde besluit.
       Zolang er niets ligt, bewaart de knop; ligt er een akkoord, dan trekt hij dat
       weer in. Zo is aan de knop zelf te zien of het opslaan gelukt is, in plaats van
       alleen aan de teller rechtsboven in het venster. */
    function stelReviewKnopIn(knop, roleId, akkoord) {
      const publicerend = ['architect', 'technologist'].includes(roleId);
      knop.dataset.trektIn = akkoord ? 'ja' : '';
      knop.textContent = akkoord
        ? (publicerend ? 'Trek publicatiebesluit in' : 'Trek review in')
        : (publicerend ? 'Bewaar publicatiebesluit' : 'Bewaar review');
      knop.classList.toggle('btn-primary', !akkoord);
      knop.classList.toggle('btn-secondary', akkoord);
    }

    function bewaardAkkoord(roleId, articleId) {
      return Boolean(state.poc?.review_state?.reviews?.[roleId]?.[articleId]?.accepted);
    }

    async function handleSaveReview() {
      const checkbox = document.getElementById('review-checkbox-agree') as HTMLInputElement;
      const noteInput = document.getElementById('review-note-input') as HTMLInputElement;
      
      if (!checkbox || !noteInput) return;

      const btn = document.getElementById('btn-save-review') as HTMLButtonElement;
      const trektIn = btn.dataset.trektIn === 'ja';

      const payload = {
        accepted: trektIn ? false : checkbox.checked,
        note: noteInput.value,
        reviewer: currentRole
      };

      btn.disabled = true;
      btn.textContent = trektIn ? 'Intrekken...' : 'Opslaan...';

      try {
        const response = await apiPut(
          `/proof-of-concept/reviews/${encodeURIComponent(currentRole)}/${encodeURIComponent(currentArticleId)}`,
          payload
        );
        state.poc.review_state = response.review_state;
        state.poc.review_summary = response.review_summary;
        state.poc.article_workflow = state.poc.article_workflow || {};
        state.poc.article_workflow[currentArticleId] = response.article_workflow;
        
        // Refresh UI
        renderCockpitContent();
        renderArticleNavigation();
        updateArticleMetrics();
      } catch (error) {
        const label = document.getElementById('review-status-label');
        if (label) {
          label.textContent = 'Opslaan geweigerd';
          label.className = 'review-status-label rejected';
        }
      } finally {
        btn.disabled = false;
        // Ook na een mislukte poging de knop op het werkelijk bewaarde besluit zetten.
        stelReviewKnopIn(btn, currentRole, bewaardAkkoord(currentRole, currentArticleId));
      }
    }

    function linkedLeerboxTwinsForStep(step, twins) {
      if (!twins.length) return [];
      const terms = [
        step.id,
        step.article,
        step.title,
        ...(step.concepts || []).map((concept) => concept.title),
      ]
        .filter(Boolean)
        .flatMap((value) => {
          const text = String(value).toLowerCase();
          return [text, text.replace(/^leerpret\s+/, ''), text.replaceAll(' ', '-'), text.replaceAll('-', ' ')]
            .filter((item) => item.length >= 4);
        });

      const matched = twins.filter((twin) => {
        const haystack = [
          twin.id,
          twin.title,
          twin.summary,
          twin.domain,
          ...(twin.source_paths || []),
          ...(twin.declarations || []),
        ].filter(Boolean).join(' ').toLowerCase();
        return terms.some((term) => haystack.includes(term));
      });

      return (matched.length ? matched : twins).slice(0, 3);
    }

    /* Voer de staptest uit en toon het resultaat naast de knop die erom vroeg.
       Het uitvoervak wordt vanuit de knop opgezocht in plaats van via een id: zo
       landt het antwoord altijd in het blok waarop geklikt is. */
    async function runVisualStepTest(stepId, knop) {
      const output = knop?.closest('.proof-stacked-layout')?.querySelector('.visual-test-output')
        || document.getElementById(`proof-visual-output-${stepId}`);
      if (!output) return;

      output.innerHTML = '<div class="visual-test-loading">Test wordt uitgevoerd...</div>';
      output.style.display = 'block';

      try {
        const response = await apiGet(`/developer/step-tests/${encodeURIComponent(stepId)}`);
        output.innerHTML = renderVisualStepTestResult(stepId, response);
      } catch (err) {
        output.innerHTML = `<div class="visual-test-error">Fout bij uitvoeren test: ${escapeHtml(err.message || err)}</div>`;
      }
    }

    function renderVisualStepTestResult(stepId, response) {
      const status = response.status || "unknown";
      return `
        <div class="visual-card-result ${escapeHtml(status)}">
          <div class="result-header">
            <span class="badge ${escapeHtml(status)}">${escapeHtml(status)}</span>
            <strong>Resultaat: ${escapeHtml(response.label || stepId)}</strong>
          </div>
          <pre class="json-preview">${escapeHtml(JSON.stringify(response.response || {}, null, 2))}</pre>
          <ul class="assertions-bullet-list">
            ${(response.assertions || []).map(a => `
              <li class="${a.passed ? 'passed' : 'failed'}">
                <span class="assert-badge">${a.passed ? 'OK' : 'FAIL'}</span>
                <span>${escapeHtml(a.label || a.path || "")}</span>
              </li>
            `).join('')}
          </ul>
        </div>
      `;
    }

    // PDF Actions
    function articlePdfPath(mode, articleId = currentArticleId) {
      const url = new URL(`${state.apiBase}/help/articles/${encodeURIComponent(articleId)}/pdf`);
      url.searchParams.set(mode, '1');
      url.searchParams.set('role', currentRole);
      return `${url.pathname}${url.search}`.replace(/^\/api/, '');
    }

    /* PDF en TeX hebben een eigen tabblad en staan daar altijd klaar. Er valt dus
       niets meer te tonen of te verbergen; alleen het ophalen gebeurt op het moment
       dat het tabblad wordt gekozen, zodat de pagina niet onnodig laadt. */
    let pdfGeladenVoor = null;
    let pdfBlobUrl = null;
    let pdfLoadVersion = 0;
    let texGeladenVoor = null;

    function stelPdfActiesBeschikbaar(beschikbaar) {
      document.getElementById('btn-open-pdf')?.toggleAttribute('disabled', !beschikbaar);
      document.getElementById('btn-download-pdf')?.toggleAttribute('disabled', !beschikbaar);
    }

    async function vulPdfPaneel({ opnieuw = false } = {}) {
      const container = document.getElementById('pdf-iframe-container');
      if (!container) return;
      if (!opnieuw && pdfGeladenVoor === currentArticleId && pdfBlobUrl && container.querySelector('iframe')) return;
      const articleId = currentArticleId;
      const loadVersion = ++pdfLoadVersion;
      stelPdfActiesBeschikbaar(false);
      container.textContent = 'PDF laden…';
      try {
        const pdf = await apiBlob(articlePdfPath('view', articleId));
        if (loadVersion !== pdfLoadVersion || articleId !== currentArticleId) return;
        if (pdfBlobUrl) URL.revokeObjectURL(pdfBlobUrl);
        pdfBlobUrl = URL.createObjectURL(pdf);
        pdfGeladenVoor = articleId;
        container.innerHTML = `<iframe src="${pdfBlobUrl}" title="Artikel PDF" class="pdf-iframe"></iframe>`;
        stelPdfActiesBeschikbaar(true);
      } catch (error) {
        if (loadVersion !== pdfLoadVersion) return;
        pdfGeladenVoor = null;
        container.textContent = error?.message || 'De artikel-PDF kon niet worden geladen.';
      }
    }

    async function vulTexPaneel({ opnieuw = false } = {}) {
      const container = document.getElementById('tex-source-container');
      const titel = document.getElementById('tex-drawer-title');
      if (!container) return;
      if (!opnieuw && texGeladenVoor === currentArticleId) return;
      texGeladenVoor = currentArticleId;
      container.textContent = 'Laden…';
      try {
        const bron = await apiGet(`/help/articles/${encodeURIComponent(currentArticleId)}/source?role=${encodeURIComponent(currentRole)}`);
        container.textContent = bron.latex || '';
        if (titel) titel.textContent = bron.filename || 'LaTeX-bron';
      } catch (error) {
        texGeladenVoor = null;
        container.textContent = 'De LaTeX-bron kon niet worden geladen.';
      }
    }

    /* De PDF opnieuw laten compileren wanneer de bron nieuwer is dan de publicatie. */
    async function handlePublishPdf() {
      const knop = document.getElementById('btn-publish-pdf');
      const status = document.getElementById('publish-status');
      if (!knop || !status) return;
      knop.disabled = true;
      status.hidden = false;
      status.textContent = 'Bezig met compileren…';
      try {
        await apiPost(`/help/articles/${encodeURIComponent(currentArticleId)}/publish?role=${encodeURIComponent(currentRole)}`, {});
        status.textContent = 'De PDF is opnieuw gepubliceerd.';
        await loadArticlesAndSteps();
        // De vorige PDF zit nog in de iframe; opnieuw opbouwen toont de nieuwe.
        vulPdfPaneel({ opnieuw: true });
      } catch (error) {
        status.textContent = error?.message || 'Publiceren is niet gelukt.';
      } finally {
        knop.disabled = false;
      }
    }

    function texBestandsnaam() {
      const titel = document.getElementById('tex-drawer-title');
      return (titel?.textContent || 'artikel.tex').trim() || 'artikel.tex';
    }

    function handleDownloadTex() {
      const bron = document.getElementById('tex-source-container')?.textContent || '';
      const blob = new Blob([bron], { type: 'application/x-tex' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = texBestandsnaam();
      link.click();
      URL.revokeObjectURL(url);
    }

    function handleOpenTex() {
      const bron = document.getElementById('tex-source-container')?.textContent || '';
      const venster = window.open('', '_blank', 'noopener');
      if (!venster) return;
      venster.document.write(`<pre style="white-space:pre-wrap;word-break:break-word;font:13px/1.5 monospace;padding:16px">${escapeHtml(bron)}</pre>`);
      venster.document.title = texBestandsnaam();
      venster.document.close();
    }

    function handleOpenPdf() {
      if (pdfBlobUrl && pdfGeladenVoor === currentArticleId) {
        window.open(pdfBlobUrl, '_blank', 'noopener');
      }
    }

    function handleDownloadPdf() {
      if (!pdfBlobUrl || pdfGeladenVoor !== currentArticleId) return;
      const step = loadedSteps.find((item) => item.id === currentArticleId);
      const link = document.createElement('a');
      link.href = pdfBlobUrl;
      link.download = step?.pdf?.filename || `${currentArticleId}.pdf`;
      link.click();
    }

    /* Niet elke rol heeft alle tabbladen nodig. De Leerpretarchitect werkt aan de
       onderwijsarchitectuur en niet aan de code, dus de drie codetabbladen blijven
       daar buiten beeld. Wisselt de rol, dan wordt dit opnieuw toegepast. */
    const CODETABBLADEN = ['tex', 'codecontrole', 'codefragmenten', 'libraryfuncties'];

    function pasTabbladzichtbaarheidAan() {
      /* De Leerprettechnoloog werkt aan de code en ziet alles. De Leerpretarchitect
         houdt Concept, PDF, Proof en Controlelijn over. Voor de overige rollen valt
         ook de Controlelijn af: dat is een werkinstrument voor de bouwers. */
      let verborgen = [];
      if (currentRole !== 'technologist') verborgen = [...CODETABBLADEN];
      if (!['architect', 'technologist'].includes(currentRole)) verborgen.push('controlelijn');
      let actieveIsVerborgen = false;
      document.querySelectorAll('[data-cockpit-pane]').forEach((tab) => {
        const naam = tab.getAttribute('data-cockpit-pane');
        const uit = verborgen.includes(naam);
        tab.hidden = uit;
        if (uit && tab.classList.contains('is-active')) actieveIsVerborgen = true;
      });
      // Stond de architect op een tabblad dat nu verdwijnt, breng hem dan naar Concept.
      if (actieveIsVerborgen) {
        document.querySelector('[data-cockpit-pane="concept"]')?.click();
      }
    }

    function setupCockpitPaneTabs() {
      const tabs = [...document.querySelectorAll('[data-cockpit-pane]')];
      const panes = {
        concept: document.getElementById('cockpit-concept-pane'),
        pdf: document.getElementById('cockpit-pdf-pane'),
        tex: document.getElementById('cockpit-tex-pane'),
        proof: document.getElementById('cockpit-proof-pane'),
        controlelijn: document.getElementById('cockpit-controlelijn-pane'),
        codecontrole: document.getElementById('cockpit-codecontrole-pane'),
        codefragmenten: document.getElementById('cockpit-codefragmenten-pane'),
        libraryfuncties: document.getElementById('cockpit-libraryfuncties-pane')
      };
      if (!tabs.length) return;

      const toon = (naam) => {
        const gekozen = panes[naam] ? naam : 'concept';
        Object.entries(panes).forEach(([sleutel, pane]) => {
          if (pane) pane.hidden = sleutel !== gekozen;
        });
        tabs.forEach((tab) => {
          const actief = tab.getAttribute('data-cockpit-pane') === gekozen;
          tab.classList.toggle('is-active', actief);
          tab.setAttribute('aria-selected', String(actief));
        });
        localStorage.setItem('leerpret.article.pane', gekozen);
        // De inhoud pas ophalen wanneer het tabblad in beeld komt.
        if (gekozen === 'pdf') vulPdfPaneel();
        if (gekozen === 'tex') vulTexPaneel();
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => toon(tab.getAttribute('data-cockpit-pane'))));
      toon(localStorage.getItem('leerpret.article.pane') || 'concept');
      pasTabbladzichtbaarheidAan();
    }

    function setupArticlePaneToggles() {
      document.querySelectorAll('[data-article-pane-toggle]').forEach((button) => {
        const pane = button.getAttribute('data-article-pane-toggle') || '';
        const body = document.querySelector(`[data-article-pane-body="${pane}"]`);
        if (!body) return;

        const applyExpanded = (expanded) => {
          body.toggleAttribute('hidden', !expanded);
          button.setAttribute('aria-expanded', String(expanded));
          button.querySelector('span').textContent = expanded ? 'Verberg' : 'Toon';
          button.querySelector('b').textContent = expanded ? '▲' : '▼';
          localStorage.setItem(`leerpret.article.pane.${pane}`, expanded ? 'expanded' : 'collapsed');
        };

        applyExpanded(localStorage.getItem(`leerpret.article.pane.${pane}`) !== 'collapsed');
        button.addEventListener('click', () => applyExpanded(button.getAttribute('aria-expanded') !== 'true'));
      });
    }

    document.querySelectorAll('.article-view-tab').forEach((button) => {
      button.addEventListener('click', () => {
        switchArticleView(button.getAttribute('data-article-view') || 'dashboard', true);
      });
    });

    // Bind event listeners
    window.addEventListener('DOMContentLoaded', () => {
      setupArticlePaneToggles();
      setupCockpitPaneTabs();
      initCockpit();
      
      document.getElementById('btn-save-review')?.addEventListener('click', handleSaveReview);
      document.getElementById('btn-publish-pdf')?.addEventListener('click', handlePublishPdf);
      document.getElementById('btn-download-tex')?.addEventListener('click', handleDownloadTex);
      document.getElementById('btn-open-tex')?.addEventListener('click', handleOpenTex);
      document.getElementById('btn-open-pdf')?.addEventListener('click', handleOpenPdf);
      document.getElementById('btn-download-pdf')?.addEventListener('click', handleDownloadPdf);
    });

    window.addEventListener('service-connection-changed', () => {
      loadArticlesAndSteps();
    });
  </script>
</Layout>

