    function workbenchHrefForRole(roleId) {
      const role = getRoleDetails(roleId);
      const view = role.workbench_view || "";
      if (view === "simulator") return "/learningbox";
      if (view === "code") return "/article?role=technologist&view=detail";
      if (view === "steps") return "/help";
      if (view === "park") return "/park";
      return "/article";
    }

    function switchArticleView(view, updateUrl = false) {
      currentView = view === 'detail' ? 'detail' : 'dashboard';
      applyArticleView();
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('role', currentRole);
        url.searchParams.set('view', currentView);
        if (currentView === 'detail' && currentArticleId) url.searchParams.set('article', currentArticleId);
        if (currentView === 'dashboard') url.searchParams.delete('article');
        window.history.replaceState({}, '', url.toString());
      }
    }

    function applyArticleView() {
      const dashboard = document.getElementById('role-dashboard-panel');
      const detail = document.getElementById('article-detail-panel');
      if (dashboard) dashboard.hidden = currentView !== 'dashboard';
      if (detail) detail.hidden = currentView !== 'detail';
      document.querySelectorAll('.article-view-tab').forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-article-view') === currentView);
