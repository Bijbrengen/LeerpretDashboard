---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Artikel" description="Bekijk de publicatiestatus, lees artikelen en voer beoordelingen uit vanuit je rol.">
  
  <div class="cockpit-header">
    <span class="eyebrow">Concept + Proof</span>
    <div class="cockpit-title-row">
      <h2 class="section-title">Artikelreview</h2>
      
      <!-- Compact selector for small screens; desktop navigation lives in the workspace menu. -->
      <select id="cockpit-article-select" class="spacious-select" aria-label="Kies artikel">
        <option value="">Laden...</option>
      </select>
    </div>
  </div>

  <div class="page-block-layout">
  <aside class="page-block-menu article-view-tabs" aria-label="Artikelnavigatie">
    <div class="article-menu-heading">
      <span class="eyebrow">Werkruimte</span>
      <strong>Artikelen</strong>
    </div>
    <div class="article-nav-list" id="article-nav-list" aria-live="polite">
      <span class="article-nav-loading">Artikelen laden...</span>
    </div>
  </aside>
  <div class="page-block-content">

  <section class="article-detail-panel" id="article-detail-panel" hidden>
    <!-- The selected article uses the full workspace canvas. -->
    <!-- Concept en Proof staan naast elkaar als tabblad in plaats van onder elkaar:
         zo hoef je niet langs het hele conceptpaneel te scrollen om te beoordelen. -->
    <div class="cockpit-pane-tabs" role="tablist" aria-label="Artikelpanelen">
      <button class="cockpit-pane-tab groep-concept is-active" type="button" role="tab" data-cockpit-pane="concept" aria-selected="true">Concept</button>
      <button class="cockpit-pane-tab groep-concept" type="button" role="tab" data-cockpit-pane="pdf" aria-selected="false">PDF</button>
      <button class="cockpit-pane-tab groep-concept" type="button" role="tab" data-cockpit-pane="tex" aria-selected="false">TeX</button>
      <button class="cockpit-pane-tab groep-proof" type="button" role="tab" data-cockpit-pane="proof" aria-selected="false">Proof</button>
      <button class="cockpit-pane-tab groep-proof" type="button" role="tab" data-cockpit-pane="controlelijn" aria-selected="false">Controlelijn</button>
      <button class="cockpit-pane-tab groep-proof" type="button" role="tab" data-cockpit-pane="codecontrole" aria-selected="false">Codecontrole</button>
      <button class="cockpit-pane-tab groep-proof" type="button" role="tab" data-cockpit-pane="codefragmenten" aria-selected="false">Codefragmenten</button>
      <button class="cockpit-pane-tab groep-proof" type="button" role="tab" data-cockpit-pane="libraryfuncties" aria-selected="false">Libraryfuncties</button>
    </div>
    <div class="cockpit-layout-grid">
    
    <!-- CONCEPT PANE -->
    <article class="mobile-card concept-pane" id="cockpit-concept-pane">
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Concept</span>
          <h3 id="concept-title">Artikel</h3>
        </div>

      </div>
      <div class="article-pane-body" data-article-pane-body="concept">
      <p id="concept-question" class="concept-question-text">Selecteer een artikel om te beginnen.</p>
      
      <!-- MathJax container -->
      <div id="concept-math" class="concept-math-block"></div>

      <div class="stale-warning" id="concept-pdf-stale-warning" hidden>
        <span>Artikelbron is nieuwer dan de gepubliceerde PDF.</span>
        <button class="btn btn-sm btn-publish" id="btn-publish-pdf" type="button">PDF opnieuw publiceren</button>
        <p class="publish-status" id="publish-status" hidden></p>
      </div>

      </div>
    </article>

    <!-- PDF PANE: staat altijd klaar, dus niets meer te tonen of te verbergen. -->
    <article class="mobile-card document-pane" id="cockpit-pdf-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Concept</span>
          <h3>Artikel PDF</h3>
        </div>
        <div class="document-actions" role="group" aria-label="PDF-acties">
          <button class="document-action" type="button" id="btn-download-pdf" title="Download de PDF" aria-label="Download de PDF">&#10515;</button>
          <button class="document-action" type="button" id="btn-open-pdf" title="Open extern" aria-label="Open extern">&#8599;</button>
        </div>
      </div>
      <div class="document-body" id="pdf-iframe-container"></div>
    </article>

    <!-- TEX PANE -->
    <article class="mobile-card document-pane" id="cockpit-tex-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Concept</span>
          <h3 id="tex-drawer-title">LaTeX-bron</h3>
        </div>
        <div class="document-actions" role="group" aria-label="TeX-acties">
          <button class="document-action" type="button" id="btn-download-tex" title="Download de LaTeX-bron" aria-label="Download de LaTeX-bron">&#10515;</button>
          <button class="document-action" type="button" id="btn-open-tex" title="Open extern" aria-label="Open extern">&#8599;</button>
        </div>
      </div>
      <pre class="tex-source" id="tex-source-container">Laden…</pre>
    </article>

    <!-- CONTROLELIJN PANE -->
    <article class="mobile-card proof-pane" id="cockpit-controlelijn-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Proof</span>
          <h3>Controlelijn</h3>
        </div>
      </div>
      <div class="article-pane-body">
        <div class="control-line-steps" data-control-line-block>
          <div class="park-empty-state">
            <strong>Controlelijn laden...</strong>
            <span>Verbinding maken met de service...</span>
          </div>
        </div>
      </div>
    </article>

    <!-- CODECONTROLE PANE: alleen de code die aan dit artikel hangt. -->
    <article class="mobile-card proof-pane" id="cockpit-codecontrole-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Proof</span>
          <h3>Gekoppelde code &amp; snippets</h3>
        </div>
      </div>
      <div class="article-pane-body">
        <div class="code-locations-grid" id="codecontrole-locations"></div>
      </div>
    </article>

    <!-- CODEFRAGMENTEN PANE: de bronfragmenten per artikelstap. -->
    <article class="mobile-card proof-pane" id="cockpit-codefragmenten-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Proof</span>
          <h3>Codefragmenten</h3>
        </div>
      </div>
      <div class="article-pane-body">
        <div data-code-overview-block data-code-overview-sections="metrics,articles">
          <div class="park-empty-state">
            <strong>Codefragmenten laden...</strong>
            <span>Verbinding maken met de service...</span>
          </div>
        </div>
      </div>
    </article>

    <!-- LIBRARYFUNCTIES PANE: per type uitklapbaar. -->
    <article class="mobile-card proof-pane" id="cockpit-libraryfuncties-pane" hidden>
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Proof</span>
          <h3>Libraryfuncties</h3>
        </div>
      </div>
      <div class="article-pane-body">
        <div data-code-overview-block data-code-overview-sections="library">
          <div class="park-empty-state">
            <strong>Libraryfuncties laden...</strong>
            <span>Verbinding maken met de service...</span>
          </div>
        </div>
      </div>
    </article>

    <!-- PROOF PANE -->
    <article class="mobile-card proof-pane" id="cockpit-proof-pane">
      <div class="pane-header">
        <div class="pane-heading-copy">
          <span class="eyebrow">Proof</span>
          <h3 id="proof-role-title">Beoordeling</h3>
        </div>

      </div>
      <div class="article-pane-body" data-article-pane-body="proof">
      
      <!-- Focus Focus Label -->
      <div class="proof-focus-box">
        <span class="muted-text">Beoordelingsfocus</span>
        <strong id="proof-focus-text">focus</strong>
      </div>

      <!-- Dynamic Role Proof Outputs container -->
      <div class="role-proof-output-container" id="role-proof-output">
        <!-- Will be loaded dynamically with custom elements -->
      </div>

      <!-- Role Review Checklist Card (Always visible, input elements 48px height) -->
      <section class="review-checklist-card" id="review-checklist-section">
        <div class="article-workflow-status" id="article-workflow-status"></div>
        <div class="checklist-header">
          <h4 id="review-checklist-title">Vragenlijst</h4>
          <span class="review-status-label" id="review-status-label">Nog te reviewen</span>
        </div>
        
        <ul class="checklist-questions" id="review-questions-list">
          <li>Laden...</li>
        </ul>

        <div class="checklist-actions">
          <label class="touch-checkbox-label">
            <input type="checkbox" id="review-checkbox-agree" class="touch-checkbox">
            <span id="review-action-label">Akkoord vanuit deze rol</span>
          </label>
          
          <div class="input-group">
            <label for="review-note-input">Reviewnotitie</label>
            <input type="text" id="review-note-input" placeholder="Korte reviewnotitie" autocomplete="off">
          </div>

          <button class="btn btn-primary" id="btn-save-review">Bewaar review</button>
        </div>
      </section>
      </div>
    </article>

    </div>
  </section>
  </div>
  </div>

  <script>
    import { state, apiBlob, apiGet, apiPost, apiPut, initSettings, apiRootUrl, editorRootUrl, escapeHtml, renderMath } from '../js/api.js';
    import { initControlLineBlock } from '../js/controlLineBlock.js';
    import { initCodeOverviewBlock } from '../js/codeOverviewBlock.js';

    let currentArticleId = '';
    let currentRole = 'architect';
    let currentView = 'detail';
    let loadedSteps = [];
    let allLoadedSteps = [];
    let loadedConcepts = [];

    async function initCockpit() {
      initSettings();
      
      // Load current path options
      const urlParams = new URLSearchParams(window.location.search);
      const urlRole = urlParams.get('role');
      const urlArticle = urlParams.get('article');

      if (urlRole) currentRole = urlRole;
      else currentRole = localStorage.getItem('leerpret.poc.role') || 'architect';
      currentView = 'detail';

      if (urlArticle) currentArticleId = urlArticle;
      else currentArticleId = localStorage.getItem('leerpret.poc.article') || '';

      await loadArticlesAndSteps();
    }

    async function loadArticlesAndSteps() {
      const select = document.getElementById('cockpit-article-select') as HTMLSelectElement;
      if (!select) return;

      try {
        const publicGuest = localStorage.getItem('leerpret.loggedOut') === 'true';
        if (publicGuest) {
          currentRole = 'guest';
          const response = await apiGet('/help/articles?role=guest');
          allLoadedSteps = response.articles || [];
          state.poc = {
            review_state: { reviews: {} },
            article_workflow: Object.fromEntries(allLoadedSteps.map(step => [
              step.id,
              { status: 'published', published: true, verified: false }
            ]))
          };
        } else {
          const response = await apiGet(`/developer/steps?role=${encodeURIComponent(currentRole)}`);
          allLoadedSteps = response.steps || [];
          state.poc = await apiGet('/proof-of-concept');
        }
        loadedSteps = visibleStepsForRole(currentRole);

        // Load help concepts
        try {
          const conceptsResponse = await apiGet('/help/concepts');
          loadedConcepts = conceptsResponse.concepts || [];
        } catch (conceptsError) {
          console.warn('Failed to load help concepts', conceptsError);
        }

        if (loadedSteps.length === 0) {
          select.innerHTML = '<option value="">Nog geen gepubliceerde artikelen</option>';
          currentArticleId = '';
          document.getElementById('article-detail-panel').hidden = true;
          /* Ook zonder artikelen de rest van de pagina afmaken. Zonder deze aanroepen
             bleef de navigatiebalk op "Artikelen laden..." staan, alsof er nog iets
             onderweg was, terwijl er voor deze rol simpelweg niets is. */
          renderArticleNavigation();
          updateArticleMetrics();
          return;
        }

        if (!loadedSteps.some(step => step.id === currentArticleId)) {
          currentArticleId = loadedSteps[0].id;
        }

        // Hydrate dropdown
        select.innerHTML = loadedSteps.map(step => `
          <option value="${step.id}" ${step.id === currentArticleId || (!currentArticleId && step.order === 1) ? 'selected' : ''}>
            Stap ${step.order}. ${step.article || step.title}
          </option>
        `).join('');

        // Bind events
        select.addEventListener('change', (e) => {
          currentArticleId = select.value;
          localStorage.setItem('leerpret.poc.article', currentArticleId);
          renderCockpitContent();
          switchArticleView('detail', true);
        });

        renderCockpitContent();
        renderArticleNavigation();
        updateArticleMetrics();
        applyArticleView();
      } catch (error) {
        select.innerHTML = '<option value="">Fout bij laden van artikelen</option>';
        loadedSteps = [];
        renderArticleNavigation();
      }
    }

    function renderCockpitContent() {
      const step = loadedSteps.find(s => s.id === currentArticleId) || loadedSteps[0];
      if (!step) return;
      currentArticleId = step.id;

      // 1. Render Concept Pane
      document.getElementById('concept-title').textContent = step.article || step.title;
      document.getElementById('concept-question').textContent = step.core_question || step.summary;
      /* De melding over een verouderde PDF hoort alleen bij de rollen die mogen
         publiceren. Voor de andere rollen is het ruis: zij kunnen er niets mee. */
      const magPubliceren = ['architect', 'technologist'].includes(currentRole);
      const staleWarning = document.getElementById('concept-pdf-stale-warning');
      if (staleWarning) {
        staleWarning.hidden = !step.pdf?.source_stale || !magPubliceren;
      }
      
      const mathBlock = document.getElementById('concept-math');
      if (mathBlock) {
        mathBlock.innerHTML = (step.latex || []).map(latex => `
          <div class="math-expr">\\(${latex}\\)</div>
        `).join('');
        // Meteen laten zetten. Deze formules worden bij elke aanroep opnieuw
        // geschreven, ook wanneer het proofpaneel blijft staan, en onopgemaakte
        // LaTeX-bron in beeld is het gevolg als dit zetten wordt overgeslagen.
        renderMath(mathBlock);
      }

      // 2. Render Proof Pane
      const roleDetails = getRoleDetails(currentRole);
      document.getElementById('proof-role-title').textContent = roleDetails.label;
      document.getElementById('proof-focus-text').textContent = roleDetails.proof_focus;

      /* Render Proof dynamic content.
         Alleen opnieuw opbouwen wanneer artikel of rol wijzigt. De verbindings-
         controle roept deze functie elke 15 seconden aan; bij onvoorwaardelijk
         hertekenen verdween het resultaat van "Run visueel" weer uit beeld,
         waardoor de knop niets leek te doen. */
      const outputContainer = document.getElementById('role-proof-output');
      const proofSleutel = `${currentRole}::${currentArticleId}`;
      if (outputContainer && outputContainer.dataset.opgebouwdVoor !== proofSleutel) {
        outputContainer.dataset.opgebouwdVoor = proofSleutel;
        outputContainer.innerHTML = getProofHTML(currentRole, step);
        renderMath(document.querySelector('.split-screen-dashboard'));

        // Attach click events to concept toggles
        outputContainer.querySelectorAll('.btn-toggle-concept').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const targetId = btn.getAttribute('data-target');
            const details = document.getElementById(targetId);
            if (details) {
              const isHidden = details.hidden;
              details.hidden = !isHidden;
              btn.classList.toggle('expanded', isHidden);
              const label = btn.querySelector('span');
              if (label) {
                label.textContent = isHidden ? 'Verberg uitleg' : 'Toon uitleg';
              }
            }
            e.stopPropagation();
          });
        });

        // Attach click events to code toggles
        outputContainer.querySelectorAll('.btn-toggle-code').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const targetId = btn.getAttribute('data-target');
            const details = document.getElementById(targetId);
            if (details) {
              const isHidden = details.hidden;
              details.hidden = !isHidden;
              btn.classList.toggle('expanded', isHidden);
              const label = btn.querySelector('span');
              if (label) {
                label.textContent = isHidden ? 'Verberg code fragment' : 'Toon code fragment';
              }
            }
            e.stopPropagation();
          });
        });

        outputContainer.querySelectorAll('[data-run-test-step]').forEach(btn => {
          btn.addEventListener('click', () => {
            const stepId = btn.getAttribute('data-run-test-step');
            if (stepId) runVisualStepTest(stepId, btn);
          });
        });

        outputContainer.querySelectorAll('[data-control-line-block]').forEach((block) => {
          initControlLineBlock({ root: block });
        });

        outputContainer.querySelectorAll('[data-code-overview-block]').forEach((block) => {
          initCodeOverviewBlock({ root: block });
        });
      }

      /* De gekoppelde code heeft een eigen tabblad met ruimte zat: alles staat open. */
      const codeDoel = document.getElementById('codecontrole-locations');
      if (codeDoel && codeDoel.dataset.opgebouwdVoor !== proofSleutel) {
        codeDoel.dataset.opgebouwdVoor = proofSleutel;
        codeDoel.innerHTML = renderCodeLocationCards(step);
      }

      /* Controlelijn en de codetabbladen staan buiten het proofpaneel en worden
         hier apart opgebouwd, één keer per artikel. */
      document.querySelectorAll('#cockpit-controlelijn-pane [data-control-line-block]').forEach((block) => {
        if (block.dataset.geinitialiseerdVoor === currentArticleId) return;
        block.dataset.geinitialiseerdVoor = currentArticleId;
        initControlLineBlock({ root: block });
      });
      document.querySelectorAll('[data-code-overview-block]').forEach((block) => {
        if (block.dataset.geinitialiseerdVoor === currentArticleId) return;
        block.dataset.geinitialiseerdVoor = currentArticleId;
        initCodeOverviewBlock({ root: block, sections: block.dataset.codeOverviewSections });
      });

      // Van artikel gewisseld: PDF en TeX opnieuw ophalen zodra hun tabblad opengaat.
      if (pdfGeladenVoor !== currentArticleId) vulPdfPaneel({ opnieuw: true });
      if (texGeladenVoor !== currentArticleId) texGeladenVoor = null;

      // Render Checklist
      renderChecklist(currentRole, step);
      pasTabbladzichtbaarheidAan();
    }

    function renderRoleDashboard() {
      const hero = document.getElementById('role-dashboard-hero');
      const grid = document.getElementById('role-article-grid');
      if (!hero || !grid) return;

      const role = getRoleDetails(currentRole);
      const publishedCount = loadedSteps.filter(step => workflowStatusFor(step.id).key === 'published').length;
      const openCount = Math.max(loadedSteps.length - publishedCount, 0);
      document.querySelector('#status-metric-attractions .metric-num')?.replaceChildren(String(loadedSteps.length));
      document.querySelector('#status-metric-objects .metric-num')?.replaceChildren(String(publishedCount));
      document.querySelector('#status-metric-routes .metric-num')?.replaceChildren(String(openCount));
      renderArticleNavigation();

      hero.innerHTML = `
        <div>
          <p class="eyebrow">Roloverzicht</p>
          <h3>${escapeHtml(role.label)}</h3>
          <p>${escapeHtml(role.summary || role.proof_focus || "")}</p>
        </div>
      `;

      grid.innerHTML = loadedSteps.length ? `
        <div class="article-overview-guide">
          <span class="overview-guide-index">01</span>
          <div><strong>Kies een artikel</strong><p>Gebruik het menu links om direct een artikel in deze werkruimte te openen.</p></div>
        </div>
        <div class="article-overview-guide">
          <span class="overview-guide-index">02</span>
          <div><strong>Lees en vergelijk</strong><p>Bekijk het concept en de rolgebonden onderbouwing naast elkaar.</p></div>
        </div>
        <div class="article-overview-guide">
          <span class="overview-guide-index">03</span>
          <div><strong>Beoordeel</strong><p>Leg je besluit en reviewnotitie vast zonder de werkruimte te verlaten.</p></div>
        </div>
        <button class="btn btn-primary article-open-current" type="button" data-open-current-article>Open geselecteerd artikel</button>
      ` : '<div class="article-publication-empty"><strong>Nog geen gepubliceerde artikelen</strong><p>Een artikel verschijnt hier nadat zowel de Leerpretarchitect als de Leerprettechnoloog het hebben gepubliceerd.</p></div>';
      grid.querySelector('[data-open-current-article]')?.addEventListener('click', () => {
        renderCockpitContent();
        switchArticleView('detail', true);
      });
    }

    function renderArticleNavigation() {
      const navigation = document.getElementById('article-nav-list');
      if (!navigation) return;
      navigation.innerHTML = loadedSteps.length ? loadedSteps.map(step => {
        const workflow = workflowStatusFor(step.id);
        return `
          <button class="page-block-menu-item article-nav-item" type="button" data-article-id="${escapeHtml(step.id)}">
            <span class="article-nav-copy">
              <small>${escapeHtml(String(step.order || ''))}</small>
              <span class="article-nav-icon ${escapeHtml(String(step.id || 'article'))}" aria-hidden="true">${articleIconFor(step.id)}</span>
              <span>${escapeHtml(shortArticleTitle(step.article || step.title || 'Artikel'))}</span>
            </span>
            <span class="article-nav-status ${workflow.key}" aria-label="${escapeHtml(workflow.label)}"></span>
          </button>
        `;
      }).join('') : '<span class="article-nav-loading">Geen artikelen beschikbaar</span>';

      navigation.querySelectorAll('[data-article-id]').forEach(button => {
        button.addEventListener('click', () => {
          currentArticleId = button.getAttribute('data-article-id') || currentArticleId;
          localStorage.setItem('leerpret.poc.article', currentArticleId);
          const select = document.getElementById('cockpit-article-select') as HTMLSelectElement;
          if (select) select.value = currentArticleId;
          renderCockpitContent();
          switchArticleView('detail', true);
        });
      });
      updateArticleNavigationState();
    }

    function updateArticleMetrics() {
      const publishedCount = loadedSteps.filter(step => workflowStatusFor(step.id).key === 'published').length;
      const openCount = Math.max(loadedSteps.length - publishedCount, 0);
      document.querySelector('#status-metric-attractions .metric-num')?.replaceChildren(String(loadedSteps.length));
      document.querySelector('#status-metric-objects .metric-num')?.replaceChildren(String(publishedCount));
      document.querySelector('#status-metric-routes .metric-num')?.replaceChildren(String(openCount));
    }

    function updateArticleNavigationState() {
      document.querySelectorAll('.article-nav-item').forEach(button => {
        button.classList.toggle('active', currentView === 'detail' && button.getAttribute('data-article-id') === currentArticleId);
      });
    }

    function renderRoleArticleCard(roleId, step) {
      const status = reviewStatusFor(roleId, step.id);
      const workflow = workflowStatusFor(step.id);
      return `
        <article class="role-article-card ${status.key}">
          <div class="role-article-card-top">
            <span class="badge">${escapeHtml(step.order || "")}. ${escapeHtml(shortArticleTitle(step.article || step.title || "Artikel"))}</span>
            <div class="article-status-stack">
              <span class="review-state-pill ${workflow.key}">${escapeHtml(workflow.label)}</span>
              <span class="review-state-pill ${status.key}">${escapeHtml(status.label)}</span>
            </div>
          </div>
          <h3>${escapeHtml(step.title || step.article || "Artikel")}</h3>
          <p>${escapeHtml(step.core_question || step.summary || "")}</p>
          <div class="test-actions">
            <button class="btn btn-secondary btn-sm" type="button" data-open-role-article data-article-id="${escapeHtml(step.id)}">Bekijk artikel</button>
            <a class="btn btn-secondary btn-sm" href="${escapeHtml(workbenchHrefForRole(roleId))}">${escapeHtml(getRoleDetails(roleId).workbench_label || "Werkbank")}</a>
          </div>
        </article>
      `;
    }

    function visibleStepsForRole(roleId) {
      if (['architect', 'technologist'].includes(roleId)) return [...allLoadedSteps];
      return allLoadedSteps.filter(step => Boolean(state.poc?.article_workflow?.[step.id]?.published));
    }

    function workflowStatusFor(articleId) {
      const workflow = state.poc?.article_workflow?.[articleId] || {};
      if (workflow.verified) return { key: 'verified', label: 'Geverifieerd' };
      if (workflow.published) return { key: 'published', label: 'Gepubliceerd' };
      return { key: 'draft', label: 'Concept' };
    }

    function reviewStatusFor(roleId, articleId) {
      const review = state.poc?.review_state?.reviews?.[roleId]?.[articleId] || null;
      const publisher = ['architect', 'technologist'].includes(roleId);
      if (!review) return { key: 'pending', label: publisher ? 'Nog niet gepubliceerd' : 'Nog niet beoordeeld' };
      if (review.accepted) return { key: 'accepted', label: publisher ? 'Publicatie akkoord' : 'Akkoord' };
      return { key: 'rejected', label: publisher ? 'Niet gepubliceerd' : 'Afgewezen' };
    }

    function shortArticleTitle(title) {
      return String(title || "Artikel").replace(/^Leerpret\s+/i, "");
    }

    function articleIconFor(articleId) {
      const icons = {
        definition: '<svg viewBox="0 0 24 24"><path d="M7 4H4v16h3M17 4h3v16h-3"/><circle cx="12" cy="12" r="3"/></svg>',
        activation: '<svg viewBox="0 0 24 24"><path d="m13 2-7 12h6l-1 8 7-12h-6l1-8Z"/></svg>',
        typing: '<svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path d="M10 9.5 7.5 14M14 9.5l2.5 4.5M8.5 17h7"/></svg>',
        formula: '<svg viewBox="0 0 24 24"><path d="M18 4H7l6 8-6 8h11M15 8h4M15 16h4"/></svg>',
        measurement: '<svg viewBox="0 0 24 24"><path d="M4 18a8 8 0 0 1 16 0"/><path d="m12 18 4-7M7 15l-2-1M12 10V7M17 15l2-1"/><circle cx="12" cy="18" r="1"/></svg>',
        'learning-box': '<svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM2 4h20v4H2zM9 12h6"/></svg>',
        simulation: '<svg viewBox="0 0 24 24"><path d="M4 16c3-8 5 8 8 0s5 8 8 0M4 6h5M15 6h5"/><path d="m7 3 3 3-3 3M17 3l-3 3 3 3"/></svg>',
      };
      return icons[String(articleId || '')] || '<svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM9 11h6M9 15h6"/></svg>';
