---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SNN Innovatietest" description="Dedicated simulatietest voor de live koppeling LOM en Phile → LeerpretEngine → Dashboard.">
  <div class="snn-test-layout">
    <aside class="snn-test-menu" aria-label="SNN-testsoorten">
      <div class="snn-menu-heading">
        <span class="eyebrow">SNN-subsidietraject</span>
        <h2>Innovatietest</h2>
        <p>Volg de technische bewijslijn van leerbox tot meting.</p>
      </div>
      <nav class="snn-test-types">
        <button type="button" data-test-type="validation">
          <span class="snn-test-index">01</span>
          <span><strong>Validatietest</strong><small>Nog in ontwikkeling</small></span>
        </button>
        <button type="button" data-test-type="integration">
          <span class="snn-test-index">02</span>
          <span><strong>Integratietest</strong><small>Nog in ontwikkeling</small></span>
        </button>
        <button type="button" class="active" data-test-type="practice" aria-current="page">
          <span class="snn-test-index">03</span>
          <span><strong>Simulatietest</strong><small>Actieve omgeving</small></span>
        </button>
      </nav>
      <div class="snn-chain-note">
        <span class="live-dot" aria-hidden="true"></span>
        <div><strong>Testketen</strong><p>LOM / Phile → Engine → Dashboard</p></div>
      </div>
    </aside>

    <section class="snn-test-content">
      <section class="snn-placeholder" data-test-panel="validation" hidden>
        <nav class="snn-tabs" aria-label="Validatietest-tabbladen"><button class="active" type="button">Overzicht</button></nav>
        <div class="development-message" role="status"><span>01</span><div><h2>Validatietest</h2><p>Nog in ontwikkeling</p></div></div>
      </section>

      <section class="snn-placeholder" data-test-panel="integration" hidden>
        <nav class="snn-tabs" aria-label="Integratietest-tabbladen"><button class="active" type="button">Overzicht</button></nav>
        <div class="development-message" role="status"><span>02</span><div><h2>Integratietest</h2><p>Nog in ontwikkeling</p></div></div>
      </section>

      <section data-test-panel="practice">
        <nav class="snn-tabs game-tabs" id="open-game-tabs" aria-label="Historische Open Game-tabbladen">
          <span class="tabs-loading">Open Game-data laden...</span>
        </nav>

        <div class="phile-live-panel historical-panel">
          <header class="live-header">
            <div>
              <span class="eyebrow">Simulatietest · eerder gespeelde data</span>
              <h2 id="simulation-game-title">Open Game-resultaten</h2>
              <p id="simulation-game-description">Kies een game om de historische actiereeks en Engine-uitkomst te bekijken.</p>
            </div>
            <div class="live-header-actions">
              <div class="live-person-control" id="live-person-control" hidden>
                <label for="live-person-select">Persoon-ID uit actiereeks</label>
                <select id="live-person-select" aria-describedby="live-person-selection-status" disabled>
                  <option value="">Wachten op Persoon-ID…</option>
                </select>
                <small id="live-person-selection-status" aria-live="polite">Nog geen geldige LOM-actiereeks ontvangen.</small>
              </div>
              <span class="connection-pill historical" id="simulation-status" role="status" aria-live="polite"><i aria-hidden="true"></i> Historisch archief</span>
              <a class="open-phile-button" id="open-live-test" href="#" target="_blank" rel="noopener" hidden>Open Leerbox ↗</a>
            </div>
          </header>

          <p class="live-contract-error" id="simulation-contract-error" role="alert" aria-live="assertive" hidden></p>

          <section class="live-metrics" aria-label="Omvang historische brondata">
            <article><span id="metric-label-1">Bronacties</span><strong id="simulation-source-actions">—</strong><small id="metric-detail-1">alle geregistreerde events</small></article>
            <article><span id="metric-label-2">Actiereeksen</span><strong id="simulation-source-sequences">—</strong><small id="metric-detail-2">na splitsing op actiepauze</small></article>
            <article><span id="metric-label-3">Deelnemers</span><strong id="simulation-source-people">—</strong><small id="metric-detail-3">pseudonieme broncodes</small></article>
            <article><span id="metric-label-4">Engineverwerking</span><strong id="simulation-processing-time">—</strong><small id="metric-detail-4">representatieve reeks</small></article>
          </section>

          <section class="processing-pipeline" aria-label="Verwerkingsstappen">
            <article class="pipeline-step receiving" data-simulation-step="1">
              <header><span class="step-number">1</span><div><small>Actie-ontvangst</small><h3 id="simulation-step-one-title">Historische actiereeks geladen</h3></div><i class="step-state"></i></header>
              <dl>
                <div><dt id="simulation-field-label-1">Game</dt><dd id="simulation-game">—</dd></div>
                <div><dt id="simulation-field-label-2">Dataset</dt><dd id="simulation-dataset">—</dd></div>
                <div><dt id="simulation-field-label-3">Periode</dt><dd id="simulation-period">—</dd></div>
                <div><dt>Pseudonieme sessie</dt><dd id="simulation-session-id">—</dd></div>
              </dl>
            </article>

            <div class="pipeline-arrow" aria-hidden="true">→</div>

            <article class="pipeline-step transforming" data-simulation-step="2">
              <header><span class="step-number">2</span><div><small>Verwerking &amp; transformatie</small><h3>Actiereeks naar markers</h3></div><i class="step-state"></i></header>
              <div class="marker-grid" aria-label="Gedragsmarkers">
                <div><span>T</span><strong data-marker="T">—</strong><small>Tijd</small></div>
                <div><span>F</span><strong data-marker="A">—</strong><small>Frequentie (A)</small></div>
                <div><span>V</span><strong data-marker="V">—</strong><small>Variatie</small></div>
                <div><span>R</span><strong data-marker="R">—</strong><small>Resilience</small></div>
                <div><span>S</span><strong data-marker="S">—</strong><small>Succes</small></div>
              </div>
              <p class="series-status" id="simulation-series-status">Historische actiereeks wordt geladen.</p>
            </article>

            <div class="pipeline-arrow" aria-hidden="true">→</div>

            <article class="pipeline-step measuring" data-simulation-step="3">
              <header><span class="step-number">3</span><div><small>Leerpret-meting</small><h3>Score na voldoende bewijs</h3></div><i class="step-state"></i></header>
              <p class="measurement-person-context" id="simulation-measurement-person" aria-live="polite">Nog geen Persoon-ID geselecteerd.</p>
              <div class="score-result">
                <div class="score-orb" id="simulation-score-orb"><strong id="simulation-score">—</strong><small>Leerpret</small></div>
                <div><span id="simulation-measurement-state">Wachten op markers</span><strong id="simulation-archetype">Nog onbepaald</strong><p id="simulation-measurement-detail">De Engine berekent pas na voldoende gedragsbewijs een meting.</p></div>
              </div>
              <div class="evidence-progress"><span id="simulation-evidence-progress"></span></div>
            </article>
          </section>

          <section class="live-feed-card">
            <header><div><span class="eyebrow" id="simulation-feed-eyebrow">OpenGameData · Field Day Lab</span><h3 id="simulation-feed-title">Historische actiereeks</h3></div><span id="simulation-feed-count">0 acties</span></header>
            <ol class="live-feed" id="simulation-action-feed" aria-live="polite">
              <li class="empty-feed">Een game-actiereeks wordt geladen.</li>
            </ol>
          </section>
        </div>
      </section>
    </section>
  </div>
</Layout>

<script>
  import '../js/snnInnovationTest.js';
</script>

<style>
  .snn-test-layout{align-items:start;display:grid;gap:18px;grid-template-columns:minmax(220px,270px) minmax(0,1fr)}
  .snn-test-menu,.snn-test-content{min-width:0}.snn-test-menu{background:linear-gradient(165deg,#07191f,#0c2930);border:1px solid #28505a;border-radius:16px;color:#e6fbfb;display:grid;gap:18px;padding:18px;position:sticky;top:16px}
  .snn-menu-heading{display:grid;gap:5px}.snn-menu-heading h2{font-size:1.3rem;margin:0}.snn-menu-heading p{color:#9dc1c7;font-size:.69rem;line-height:1.55;margin:0}.snn-menu-heading .eyebrow{color:#55d6cb}
  .snn-test-types{display:grid;gap:8px}.snn-test-types button{align-items:center;background:#102c34;border:1px solid #2b4e57;border-radius:12px;color:#d8eff1;cursor:pointer;display:grid;font:inherit;gap:10px;grid-template-columns:34px 1fr;min-height:62px;padding:9px;text-align:left}.snn-test-types button:hover{background:#153740;border-color:#4b7780}.snn-test-types button.active{background:linear-gradient(135deg,#0c494c,#123d46);border-color:#48c7bb;box-shadow:inset 4px 0 #4ee2d3}.snn-test-types button>span:last-child{display:grid;gap:2px}.snn-test-types strong{font-size:.76rem}.snn-test-types small{color:#91afb5;font-size:.61rem}.snn-test-types button.active small{color:#a8e9e3}.snn-test-index{align-items:center;background:#071b21;border:1px solid #315660;border-radius:8px;color:#63d8cd;display:flex;font-family:'Share Tech Mono',monospace;font-size:.7rem;height:32px;justify-content:center;width:32px}.snn-chain-note{align-items:center;border-top:1px solid #2b4e57;display:flex;gap:10px;padding-top:14px}.snn-chain-note .live-dot{background:#34d399;border-radius:50%;box-shadow:0 0 0 5px rgba(52,211,153,.12);height:8px;width:8px}.snn-chain-note strong{font-size:.68rem}.snn-chain-note p{color:#99bec4;font-family:'Share Tech Mono',monospace;font-size:.62rem;margin:2px 0 0}
  .snn-test-content{display:grid}.snn-tabs{align-items:end;border-bottom:1px solid var(--line);display:flex;gap:4px;min-height:47px;padding:0 10px}.snn-tabs button{background:transparent;border:0;border-bottom:3px solid transparent;color:var(--muted);font:inherit;font-size:.72rem;font-weight:800;padding:13px 17px 11px}.snn-tabs button.active{border-color:var(--teal);color:var(--ink)}
  .development-message{align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:16px;display:flex;gap:18px;margin-top:18px;min-height:260px;padding:30px}.development-message>span{align-items:center;background:#e6fffb;border:1px solid #99f6e4;border-radius:50%;color:#0f766e;display:flex;font-family:'Share Tech Mono',monospace;font-size:1.2rem;height:68px;justify-content:center;width:68px}.development-message h2{margin:0}.development-message p{color:var(--muted);margin:5px 0 0}
  .phile-live-panel{display:grid;gap:14px;padding-top:18px}.live-header{align-items:center;background:linear-gradient(135deg,#082127,#0e333a);border:1px solid #2a5660;border-radius:16px;color:#eaffff;display:flex;gap:20px;justify-content:space-between;padding:18px}.live-header h2{font-size:1.35rem;margin:3px 0}.live-header p{color:#a4c5ca;font-size:.71rem;margin:0}.live-header .eyebrow{color:#58dace}.live-header-actions{align-items:center;display:flex;gap:9px}.connection-pill,.open-phile-button{align-items:center;border-radius:999px;display:flex;font-size:.66rem;font-weight:800;gap:7px;padding:8px 11px;white-space:nowrap}.connection-pill{background:#1b3940;border:1px solid #41636a;color:#bdd4d8}.connection-pill i{background:#f59e0b;border-radius:50%;height:7px;width:7px}.connection-pill.live{background:#0d453f;border-color:#2aa99e;color:#c9fff9}.connection-pill.live i{animation:pulse 1.6s infinite;background:#34d399}.connection-pill.error{background:#4a2026;border-color:#9f4451;color:#ffd5da}.connection-pill.error i{background:#fb7185}.open-phile-button{background:#e8fffc;border:1px solid #83e8df;color:#075e59;text-decoration:none}.open-phile-button:hover{background:white}
  .live-metrics{display:grid;gap:10px;grid-template-columns:repeat(4,minmax(0,1fr))}.live-metrics article{background:var(--panel);border:1px solid var(--line);border-radius:12px;display:grid;gap:2px;padding:12px}.live-metrics span{color:var(--muted);font-size:.59rem;font-weight:800;text-transform:uppercase}.live-metrics strong{font-family:'Share Tech Mono',monospace;font-size:1.05rem}.live-metrics small{color:var(--muted);font-size:.58rem}
  .processing-pipeline{align-items:stretch;display:grid;gap:8px;grid-template-columns:minmax(0,1fr) 24px minmax(0,1.08fr) 24px minmax(0,1fr)}.pipeline-step{background:var(--panel);border:1px solid var(--line);border-radius:15px;display:grid;gap:14px;padding:14px;position:relative}.pipeline-step.active{border-color:color-mix(in srgb,var(--step-color) 55%,var(--line));box-shadow:0 8px 28px color-mix(in srgb,var(--step-color) 11%,transparent)}.pipeline-step.receiving{--step-color:#2563eb}.pipeline-step.transforming{--step-color:#7c3aed}.pipeline-step.measuring{--step-color:#0d9488}.pipeline-step>header{align-items:center;border-bottom:1px solid var(--line);display:grid;gap:9px;grid-template-columns:32px 1fr 8px;padding-bottom:11px}.step-number{align-items:center;background:color-mix(in srgb,var(--step-color) 11%,white);border-radius:9px;color:var(--step-color);display:flex;font-family:'Share Tech Mono',monospace;font-weight:800;height:32px;justify-content:center}.pipeline-step header small{color:var(--muted);font-size:.55rem;font-weight:850;letter-spacing:.04em;text-transform:uppercase}.pipeline-step h3{font-size:.78rem;margin:2px 0 0}.step-state{background:#cbd5e1;border-radius:50%;height:7px;width:7px}.pipeline-step.active .step-state{background:var(--step-color);box-shadow:0 0 0 4px color-mix(in srgb,var(--step-color) 12%,transparent)}.pipeline-arrow{align-items:center;color:#94a3b8;display:flex;font-size:1.2rem;justify-content:center}.pipeline-step dl{display:grid;gap:8px;margin:0}.pipeline-step dl div{display:grid;gap:2px}.pipeline-step dt{color:var(--muted);font-size:.55rem;font-weight:800;text-transform:uppercase}.pipeline-step dd{font-family:'Share Tech Mono',monospace;font-size:.68rem;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.marker-grid{display:grid;gap:5px;grid-template-columns:repeat(5,1fr)}.marker-grid div{background:var(--surface-soft);border:1px solid var(--line);border-radius:9px;display:grid;gap:2px;justify-items:center;padding:7px 3px}.marker-grid span{color:#6d28d9;font-family:'Share Tech Mono',monospace;font-size:.7rem;font-weight:900}.marker-grid strong{font-family:'Share Tech Mono',monospace;font-size:.73rem}.marker-grid small{color:var(--muted);font-size:.46rem;text-align:center}.series-status{background:#f8fafc;border-radius:8px;color:var(--muted);font-size:.59rem;line-height:1.45;margin:0;padding:8px}.score-result{align-items:center;display:grid;gap:12px;grid-template-columns:76px 1fr}.score-orb{align-items:center;background:conic-gradient(var(--teal) var(--score-angle,0deg),#e2e8f0 0);border-radius:50%;display:flex;height:74px;justify-content:center;position:relative;width:74px}.score-orb::before{background:var(--panel);border-radius:50%;content:'';inset:7px;position:absolute}.score-orb strong,.score-orb small{position:absolute;z-index:1}.score-orb strong{font-family:'Share Tech Mono',monospace;font-size:1rem;top:20px}.score-orb small{bottom:16px;color:var(--muted);font-size:.48rem}.score-result>div:last-child{display:grid;gap:3px}.score-result span{color:var(--muted);font-size:.57rem;font-weight:800;text-transform:uppercase}.score-result>div:last-child>strong{font-size:.74rem}.score-result p{color:var(--muted);font-size:.55rem;line-height:1.4;margin:0}.evidence-progress{background:#e2e8f0;border-radius:999px;height:6px;overflow:hidden}.evidence-progress span{background:linear-gradient(90deg,#0d9488,#34d399);display:block;height:100%;transition:width .3s;width:0}
  .live-feed-card{background:var(--panel);border:1px solid var(--line);border-radius:15px;overflow:hidden}.live-feed-card>header{align-items:center;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;padding:13px 15px}.live-feed-card h3{font-size:.86rem;margin:2px 0 0}.live-feed-card>header>span{color:var(--muted);font-size:.6rem}.live-feed{display:grid;list-style:none;margin:0;max-height:260px;overflow:auto;padding:0}.live-feed li{align-items:center;border-bottom:1px solid var(--line);display:grid;font-family:'Share Tech Mono',monospace;font-size:.62rem;gap:10px;grid-template-columns:74px 104px minmax(120px,1fr) 75px 75px;padding:9px 15px}.live-feed li:last-child{border-bottom:0}.live-feed time{color:var(--muted)}.feed-action{color:#2563eb;font-weight:800}.feed-object{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.feed-stage{color:#64748b}.feed-score{color:#0f766e;font-weight:800;text-align:right}.live-feed .empty-feed{color:var(--muted);display:block;font-family:inherit;padding:22px;text-align:center}
  .game-tabs{align-items:stretch;overflow-x:auto;padding-inline:10px;scrollbar-width:thin}.game-tabs button{flex:0 0 auto;max-width:220px;white-space:nowrap}.tabs-loading{align-self:center;color:var(--muted);font-size:.68rem;padding:14px}.connection-pill.historical{background:#173d46;border-color:#4b7780;color:#d8eff1}.connection-pill.historical i{background:#60a5fa}.open-phile-button[hidden]{display:none}.historical-panel .pipeline-step{min-width:0}.historical-panel .live-feed li{grid-template-columns:74px 104px minmax(120px,1fr) 96px}.feed-role{color:#64748b;text-align:right}
  /* Zelfde donkere command-huisstijl als de analytics- en datastructuurschermen. */
  .snn-test-content{--snn-panel:#0c2026;--snn-panel-raised:#10262d;--snn-surface:#07171c;--snn-border:#294b54;--snn-track:#1c3941;--snn-ink:#eaf8f7;--snn-muted:#9db4b8;color:var(--snn-ink)}
  .snn-test-content h2,.snn-test-content h3,.snn-test-content strong{color:var(--snn-ink)}
  .development-message{background:var(--snn-panel);border-color:var(--snn-border)}.development-message>span{background:#10343a;border-color:#2f806d;color:#8cece5}
  .snn-tabs{background:var(--snn-surface);border-color:var(--snn-border)}.snn-tabs button{color:var(--snn-muted)}.snn-tabs button:hover{background:#10262d;color:#d9f8f5}.snn-tabs button.active{background:#10343a;border-color:var(--teal);color:#8cece5}
  .live-metrics article,.pipeline-step,.live-feed-card{background:var(--snn-panel);border-color:var(--snn-border);box-shadow:0 8px 22px rgba(0,0,0,.18)}
  .live-metrics span,.live-metrics small,.pipeline-step header small,.pipeline-step dt,.score-result span,.score-result p,.live-feed-card>header>span,.live-feed time,.feed-role{color:var(--snn-muted)}
  .pipeline-step>header,.live-feed-card>header,.live-feed li{border-color:var(--snn-border)}
  .step-number{background:color-mix(in srgb,var(--step-color) 20%,var(--snn-panel));color:color-mix(in srgb,var(--step-color) 72%,white)}
  .marker-grid div,.series-status{background:var(--snn-surface);border:1px solid var(--snn-border);color:var(--snn-muted)}.marker-grid span{color:#c5b3ff}
  .score-orb{background:conic-gradient(var(--teal) var(--score-angle,0deg),var(--snn-track) 0)}.score-orb::before{background:var(--snn-panel)}.evidence-progress{background:var(--snn-track)}
  .live-feed-card>header{background:var(--snn-panel-raised)}.feed-action{color:#66c7e8}.feed-stage,.feed-role{color:#8aa6ac}.live-feed .empty-feed{color:var(--snn-muted)}.open-phile-button{background:#10343a;border-color:#2aa99e;color:#8cece5}.open-phile-button:hover{background:#164d4d;color:#fff}
  .live-header-actions{align-items:flex-end}.live-person-control{display:grid;gap:4px;min-width:min(310px,42vw)}.live-person-control[hidden]{display:none}.live-person-control label{color:#7ee7df;font-size:.56rem;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.live-person-control select{background:#07171c;border:1px solid #3b6972;border-radius:8px;color:var(--snn-ink);font:inherit;font-family:'Share Tech Mono',monospace;font-size:.67rem;min-height:36px;padding:7px 30px 7px 9px;width:100%}.live-person-control select:focus-visible{border-color:#58dace;box-shadow:0 0 0 3px rgba(88,218,206,.2);outline:0}.live-person-control select:disabled{cursor:wait;opacity:.7}.live-person-control small{color:#9dc1c7;font-size:.54rem;line-height:1.35;min-height:.75rem}
  .connection-pill.warning{background:#3a321d;border-color:#9d8138;color:#ffe6a3}.connection-pill.warning i{background:#fbbf24}
  .measurement-person-context{background:#102f38;border:1px solid #31545d;border-radius:8px;color:#8cece5;font-family:'Share Tech Mono',monospace;font-size:.58rem;line-height:1.4;margin:0;padding:7px 8px;overflow-wrap:anywhere}.measurement-person-context.contract-missing{background:#3a2025;border-color:#9f4b59;color:#ffd5da}
  .live-contract-error{background:#3a2025;border:1px solid #9f4b59;border-radius:10px;color:#ffd5da;font-size:.65rem;font-weight:750;line-height:1.45;margin:0;padding:9px 12px}.live-contract-error[hidden]{display:none}
  @keyframes pulse{50%{box-shadow:0 0 0 5px rgba(52,211,153,.16)}}
  @media(max-width:1100px){.processing-pipeline{grid-template-columns:1fr}.pipeline-arrow{height:18px;transform:rotate(90deg)}.live-metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:760px){.snn-test-layout{grid-template-columns:1fr}.snn-test-menu{position:static}.snn-test-types{grid-template-columns:1fr}.live-header{align-items:flex-start;flex-direction:column}.live-header-actions{align-items:stretch;display:grid;width:100%}.live-person-control{min-width:0;width:100%}.live-metrics{grid-template-columns:1fr 1fr}.live-feed li{grid-template-columns:65px 92px minmax(100px,1fr)}.feed-stage,.feed-score{display:none}}
</style>
