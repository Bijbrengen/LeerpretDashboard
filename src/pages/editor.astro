---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Editor" description="Ontwerp een leerbox, importeer bronnen en werk met de AI-assistent aan de inhoud.">
  <div class="editor-page-layout">
    <aside class="mobile-card editor-page-menu" aria-label="Editoronderdelen" data-i18n-aria-label="menu.sections">
      <button class="editor-menu-collapse" id="editor-menu-collapse" type="button" aria-expanded="true" aria-label="Linker gereedschapspaneel inklappen" title="Inklappen" data-i18n-aria-label="menu.collapse.aria" data-i18n-title="menu.collapse">−</button>
      <a class="editor-back-link" id="editor-back-to-learningbox" href="/learningbox" data-i18n="menu.back">← Terug naar Leerbox</a>
      <div class="editor-leerbox-context">
        <span class="eyebrow">Leerbox</span>
        <label for="editor-twin-select" data-i18n="menu.activeLeerbox">Actieve leerbox</label>
        <select id="editor-twin-select" class="spacious-select">
          <option value="" data-i18n="menu.loading">Laden...</option>
        </select>
        <div class="editor-twin-popover" id="editor-twin-popover" hidden></div>
        <div class="editor-context-actions">
          <button class="editor-compact-action editor-description-action" type="button" data-editor-page-view="description" aria-label="Beschrijving bekijken" title="Beschrijving bekijken" data-i18n-aria-label="menu.description" data-i18n-title="menu.description">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6V4a2 2 0 0 1 2-2h8l4 4v11a2 2 0 0 1-2 2h-2"/><rect x="2" y="6" width="16" height="16" rx="2"/><path d="M6 11h8M6 15h8M6 19h5"/></svg>
          </button>
          <button class="editor-compact-action" id="generate-preview-action" type="button" aria-label="Preview genereren" title="Preview genereren" data-i18n-aria-label="hud.preview.title" data-i18n-title="hud.preview.title">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
          <div class="twin-status-badge status-concept" id="editor-twin-status" role="progressbar" aria-label="Voortgang leerbox" data-i18n-aria-label="menu.progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">concept</div>
        </div>
      </div>
      <p class="editor-menu-label" data-i18n="menu.commandCentre">Commandocentrum</p>
      <!-- Groep 1: Beheer - de leerbox aanmaken, voeden en het plan ophalen -->
      <section class="editor-command-cluster editor-command-cluster-file editor-command-cluster-beheer" aria-label="Beheer" data-i18n-aria-label="cluster.beheer" data-i18n-title="cluster.beheer.title" title="Beheer: een leerbox aanmaken, van bronnen voorzien en het plan ophalen">
        <button type="button" data-i18n-title="hud.nieuw.title" id="hud-new-action" title="Nieuwe leerbox"><span aria-hidden="true">+</span><strong data-i18n="hud.nieuw">Nieuw</strong></button>
        <button type="button" data-i18n-title="hud.bronnen.title" data-editor-page-view="sources" title="Bronnen importeren en downloaden"><span aria-hidden="true">⇅</span><strong data-i18n="hud.bronnen">Bronnen</strong></button>
        <button type="button" data-i18n-title="hud.plan.title" data-editor-page-view="build" data-editor-workspace-view="latex" title="Ontwerpplan"><span aria-hidden="true">▤</span><strong data-i18n="hud.plan">Plan</strong></button>
      </section>
      <!-- Groep 2: Onderwijsarchitectuur - wat de leerattractie wenst -->
      <section class="editor-command-cluster editor-command-cluster-oa" aria-label="Onderwijsarchitectuur" title="Onderwijsarchitectuur: wat de leerattractie wenst — de organisatie van het leren" data-i18n-aria-label="cluster.oa" data-i18n-title="cluster.oa.title">
        <button type="button" data-i18n-title="hud.info.title" data-editor-page-view="intake" data-editor-panel="overview" title="Infobox: type Leerbox en sociale setting"><span aria-hidden="true">ℹ️</span><strong data-i18n="hud.info">Info</strong></button>
        <button type="button" data-i18n-title="hud.missie.title" data-editor-page-view="description" data-editor-panel="mission" title="Missie"><span aria-hidden="true">🎯</span><strong data-i18n="hud.missie">Missie</strong></button>
        <button type="button" data-i18n-title="hud.visie.title" data-editor-page-view="description" data-editor-panel="vision" title="Visie: gewenste situatie en onderwijskundige opvattingen"><span aria-hidden="true">🔭</span><strong data-i18n="hud.visie">Visie</strong></button>
        <button type="button" data-i18n-title="hud.strategie.title" data-editor-page-view="description" data-editor-panel="strategy" title="Strategie: aanpak en ontwerp"><span aria-hidden="true">🧭</span><strong data-i18n="hud.strategie">Strategie</strong></button>
        <button type="button" data-i18n-title="hud.doelen.title" data-editor-page-view="description" data-editor-panel="goals" title="Doelen: leerdoelen en leerdoelhiërarchie"><span aria-hidden="true">🏁</span><strong data-i18n="hud.doelen">Doelen</strong></button>
        <button type="button" data-i18n-title="hud.game.title" data-editor-page-view="intake" data-editor-panel="game" title="Game: spelregels en speelruimte"><span aria-hidden="true">🎮</span><strong data-i18n="hud.game">Game</strong></button>
        <button type="button" data-i18n-title="hud.start.title" data-editor-page-view="intake" data-editor-panel="entry" title="Start: onboarding en eerste actie"><span aria-hidden="true">⚑</span><strong data-i18n="hud.start">Start</strong></button>
        <button type="button" data-i18n-title="hud.weerstand.title" data-editor-page-view="description" data-editor-panel="resistance" title="Weerstand: de belangrijkste barrière"><span aria-hidden="true">🧗</span><strong data-i18n="hud.weerstand">Weerstand</strong></button>
        <button type="button" data-i18n-title="hud.succes.title" data-editor-page-view="description" data-editor-panel="success" title="Succes: de succesdefinitie"><span aria-hidden="true">🏆</span><strong data-i18n="hud.succes">Succes</strong></button>
      </section>
      <!-- Groep 3: Analyse - de gevatte leerbox bekijken, controleren en verantwoorden -->
      <section class="editor-command-cluster editor-command-cluster-leerbox editor-command-cluster-analyse" aria-label="Analyse" data-i18n-aria-label="cluster.analyse" data-i18n-title="cluster.analyse.title" title="Analyse: de gevatte leerbox bekijken, controleren en verantwoorden">
        <button type="button" data-i18n-title="hud.structuur.title" data-editor-page-view="build" data-editor-workspace-view="architecture" title="Leerarchitectuur"><span aria-hidden="true">⌘</span><strong data-i18n="hud.structuur">Structuur</strong></button>
        <button type="button" data-i18n-title="hud.code.title" data-editor-page-view="build" data-editor-workspace-view="statements" title="Computertaal-statements"><span aria-hidden="true">&lt;/&gt;</span><strong data-i18n="hud.code">Code</strong></button>
        <button type="button" data-i18n-title="hud.rapport.title" id="hud-report-action" title="Gevatte leerbox als rapport"><span aria-hidden="true">▦</span><strong data-i18n="hud.rapport">Rapport</strong></button>
        <button type="button" data-i18n-title="hud.controle.title" data-editor-page-view="validation" title="Controle en audit"><span aria-hidden="true">✓</span><strong data-i18n="hud.controle">Controle</strong></button>
        <button type="button" data-i18n-title="hud.meten.title" data-editor-page-view="intake" data-editor-panel="measurement" title="Sensoren en Leerpret-meting"><span aria-hidden="true">◉</span><strong data-i18n="hud.meten">Meten</strong></button>
        <button type="button" data-i18n-title="hud.preview.title" id="hud-preview-action" title="Preview genereren"><span aria-hidden="true">▣</span><strong data-i18n="hud.preview">Preview</strong></button>
      </section>
      <!-- Groep 4: Gereedschap - links het vierkant met leerobjecttypes, rechts route en voorwaarde -->
      <section class="editor-command-cluster editor-command-cluster-build" aria-label="Gereedschap" data-i18n-aria-label="cluster.tools" data-i18n-title="cluster.tools.title" title="Gereedschap: leerobjecten, routestappen en voorwaarden toevoegen">
        <div class="editor-object-square" id="editor-object-subtools" aria-label="Leerobject" data-i18n-aria-label="cluster.objectTypes" title="Leerobject: kies het type dat je toevoegt" data-i18n-title="cluster.objectTypes.title">
          <button type="button" data-i18n-title="preset.entry.title" data-object-preset="entry" title="Startobject"><span aria-hidden="true">⚑</span><strong data-i18n="preset.entry">Start</strong></button>
          <button type="button" data-i18n-title="preset.success.title" data-object-preset="success" title="Succesobject"><span aria-hidden="true">★</span><strong data-i18n="preset.success">Succes</strong></button>
          <button type="button" data-i18n-title="preset.resistance.title" data-object-preset="resistance" title="Weerstandsobject"><span aria-hidden="true">▲</span><strong data-i18n="preset.resistance">Weerstand</strong></button>
          <button type="button" data-i18n-title="preset.normal.title" data-object-preset="normal" title="Normaal leerobject"><span aria-hidden="true">⚙</span><strong data-i18n="preset.normal">Normaal</strong></button>
        </div>
        <div class="editor-tool-column">
          <button type="button" data-i18n-title="hud.stap.title" id="hud-step-action" title="Nieuwe routestap"><span aria-hidden="true">➜</span><strong data-i18n="hud.stap">Stap</strong></button>
          <button type="button" data-i18n-title="hud.voorw.title" id="hud-dependency-action" title="Nieuwe voorwaarde"><span aria-hidden="true">▣</span><strong data-i18n="hud.voorw">Voorw.</strong></button>
        </div>
      </section>
      <section class="editor-advisor-dock" id="editor-advisor-dock">
        <button class="editor-advisor-portrait" id="editor-advisor-toggle" type="button" aria-expanded="false" title="Adviseur openen" data-i18n-title="advisor.open">
          <svg viewBox="0 0 80 94" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="advisorCoreGlow" cx="50%" cy="46%" r="55%">
                <stop offset="0" stop-color="#effffd"/>
                <stop offset=".32" stop-color="#4bc7bf"/>
                <stop offset="1" stop-color="#07171c"/>
              </radialGradient>
              <linearGradient id="advisorMetal" x1="18" x2="64" y1="18" y2="76">
                <stop offset="0" stop-color="#d7eeee"/>
                <stop offset=".46" stop-color="#82a9aa"/>
                <stop offset="1" stop-color="#28464c"/>
              </linearGradient>
            </defs>
            <path class="advisor-hood" d="M12 45C12 24 24 11 40 11s28 13 28 34v14c0 15-11 27-28 27S12 74 12 59V45Z"/>
            <path class="advisor-cap" d="M7 18 40 4l33 14-33 15L7 18Z"/>
            <path class="advisor-cap-band" d="M23 28c8 8 26 8 34 0v11c-8 6-26 6-34 0V28Z"/>
            <path class="advisor-face" d="M21 43c0-15 8-24 19-24s19 9 19 24v12c0 13-8 22-19 22s-19-9-19-22V43Z"/>
            <path class="advisor-panel-line" d="M25 39h9M46 39h9M29 60c7 5 15 5 22 0M34 29l-4 9M51 29l4 9"/>
            <circle class="advisor-eye" cx="32" cy="48" r="3.3"/>
            <circle class="advisor-eye" cx="48" cy="48" r="3.3"/>
            <path class="advisor-neck" d="M31 78v11M40 79v13M49 78v11"/>
          </svg>
        </button>
        <aside class="editor-advisor-panel" id="editor-advisor-panel" hidden>
          <button class="editor-advisor-close" id="editor-advisor-close" type="button" aria-label="Adviseur inklappen" title="Inklappen" data-i18n-aria-label="advisor.collapse.aria" data-i18n-title="menu.collapse">−</button>
          <span data-i18n="advisor.title">Adviseur</span>
          <strong data-i18n="advisor.heading">Bouwadvies</strong>
          <p data-i18n="advisor.intro">Ontwerpadvies zonder de leerboxkaart te verlaten.</p>
          <div class="editor-advisor-message"><b data-i18n="advisor.scanLabel">Scan</b><span data-i18n="advisor.scanHint">Controleer eerst of start, succes en route logisch verbonden zijn.</span></div>
          <div class="editor-advisor-actions" aria-label="Adviseurfuncties" data-i18n-aria-label="advisor.actions">
            <button type="button" id="editor-advisor-chat" title="Chat met de agent" data-i18n-title="advisor.chat">☰</button>
            <button type="button" title="Scan de route" data-i18n-title="advisor.scan">⌁</button>
            <button type="button" title="Vraag advies" data-i18n-title="advisor.advice"><svg class="shared-advisor-face-icon" viewBox="0 0 80 94" aria-hidden="true"><path class="advisor-face" d="M21 43c0-15 8-24 19-24s19 9 19 24v12c0 13-8 22-19 22s-19-9-19-22V43Z"/></svg></button>
            <button type="button" title="Waarschuwingen" data-i18n-title="advisor.warnings">!</button>
          </div>
          <small data-i18n="advisor.footnote">Adviseur blijft naast het gereedschap</small>
        </aside>
      </section>
      <section class="editor-tool-flyout" id="editor-tool-flyout" aria-live="polite" hidden>
        <button class="editor-tool-flyout-close" id="editor-tool-flyout-close" type="button" aria-label="Gereedschapspaneel inklappen" title="Inklappen">−</button>
        <span>Gereedschap</span>
        <strong id="editor-tool-flyout-title">Route</strong>
        <p id="editor-tool-flyout-summary">Bouw de spelersroute, objecten en afhankelijkheden.</p>
        <small>Klik om dit scherm te openen</small>
      </section>
      <div class="simulation-clock" data-current-phase="concept" title="Simulatielengte in acties">
        <svg class="simulation-clock-face" viewBox="-18 -18 256 256" role="group" aria-label="Simulatieklok met ontwikkelfasen, duur en aantal acties">
          <defs>
            <filter id="clockGlow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="2.2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <circle class="clock-phase-track" cx="110" cy="110" r="120"/>
          <g class="clock-phase-ring" aria-label="Ontwikkelfase leerbox">
            <circle class="clock-phase-segment phase-concept" data-clock-phase="concept" cx="110" cy="110" r="120" pathLength="100" transform="rotate(-90 110 110)"/>
            <circle class="clock-phase-segment phase-prototype" data-clock-phase="prototype" cx="110" cy="110" r="120" pathLength="100" transform="rotate(0 110 110)"/>
            <circle class="clock-phase-segment phase-pilot" data-clock-phase="pilot" cx="110" cy="110" r="120" pathLength="100" transform="rotate(90 110 110)"/>
            <circle class="clock-phase-segment phase-rollout" data-clock-phase="rollout" cx="110" cy="110" r="120" pathLength="100" transform="rotate(180 110 110)"/>
          </g>
          <circle class="clock-outer-line" cx="110" cy="110" r="102"/>
          <path class="clock-arc-track" d="M110 202 A92 92 0 0 1 110 18"/>
          <path class="clock-arc clock-arc-duration" id="clock-duration-arc" data-clock-slider="duration" role="slider" tabindex="0" aria-label="Duur in minuten" aria-valuemin="0" aria-valuemax="60" aria-valuenow="30" pathLength="100" d="M110 202 A92 92 0 0 1 110 18"/>
          <path class="clock-arc-track" d="M110 202 A92 92 0 0 0 110 18"/>
          <path class="clock-arc clock-arc-actions" id="clock-actions-arc" data-clock-slider="actions" role="slider" tabindex="0" aria-label="Aantal acties" aria-valuemin="0" aria-valuemax="200" aria-valuenow="100" pathLength="100" d="M110 202 A92 92 0 0 0 110 18"/>
          <circle class="clock-dial" cx="110" cy="110" r="72"/>
          <circle class="clock-ticks-major" cx="110" cy="110" r="65" pathLength="60"/>
          <circle class="clock-ticks-minor" cx="110" cy="110" r="60" pathLength="60"/>
          <g class="clock-hands" filter="url(#clockGlow)">
            <line class="clock-hand clock-hand-minute" x1="110" y1="110" x2="110" y2="57"/>
            <line class="clock-hand clock-hand-action" x1="110" y1="110" x2="150" y2="137"/>
          </g>
          <text class="clock-phase-label" id="clock-phase-label" x="110" y="66">CONCEPT</text>
          <g class="clock-segment-icon" transform="translate(18 92)" aria-hidden="true">
            <circle cx="0" cy="0" r="6"/><path d="M0-3.5V0L3 2M-2.5-8H2.5"/>
          </g>
          <text class="clock-segment-value" id="clock-duration-value" x="18" y="115">30</text>
          <text class="clock-segment-unit" x="18" y="128">MIN</text>
          <g class="clock-segment-icon clock-footsteps-icon" transform="translate(202 92) scale(.62)" aria-hidden="true">
            <g transform="rotate(-8 -3 -3)">
              <path d="M-4.8-10C-7.5-9.5-8-6.2-7.2-2.4L-6.1 1.2L-1.2.3C-1.2.3-.6-3.3-.9-5.1C-1.4-8.5-2.6-10.2-4.8-10Z"/>
              <path d="M-5.5 4.1C-6.8 7-5.8 9.1-3.3 9.6C-.8 10.1.5 8.1-.1 4.7L-5.5 4.1Z"/>
            </g>
            <g transform="rotate(8 3 3)">
              <path d="M4.8-7C2.1-6.5 1.3-3.3 1.8.6L2.5 4.3L7.5 3.8C7.5 3.8 8.4.2 8.2-1.5C7.9-5 7-7.3 4.8-7Z"/>
              <path d="M2.4 7.2C1.1 10.1 2 12.2 4.5 12.8C7 13.4 8.4 11.4 7.9 8L2.4 7.2Z"/>
            </g>
          </g>
          <text class="clock-segment-value" id="clock-actions-value" x="202" y="115">100</text>
          <text class="clock-segment-unit clock-actions-unit" x="202" y="128">ACTIES</text>
        </svg>
        <label><span id="simulation-value-label">ACTIES</span><input id="simulation-action-count" type="number" min="0" max="200" step="10" value="100" aria-label="Simulatiewaarde" /></label>
        <button class="simulation-clock-core" id="simulation-clock-play" type="button" data-sim-control="play" aria-label="Simulatie starten" title="Simulatie starten"><svg class="clock-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5L20 12L8 19Z"/></svg></button>
        <input id="simulation-unit" type="hidden" value="actions">
        <input id="simulation-sigma" type="hidden" value="2 sigma - gebalanceerd">
        <aside class="simulation-clock-lock" id="simulation-clock-lock" role="status" hidden>
          <strong>Incompleet</strong>
          <p>Simulatie blijft uitgeschakeld. Maak de gevatte leerbox sluitend.</p>
          <ul id="simulation-clock-lock-reasons"></ul>
        </aside>
      </div>
    </aside>

    <main class="editor-page-content">
      <div class="editor-page-status" id="editor-page-status">Editor laden…</div>
      <iframe id="editor-page-iframe" class="editor-page-iframe" title="Leerbox Editor" src=""></iframe>
    </main>
  </div>

  <script>
    import { apiGet, apiRootUrl, editorRootUrl, escapeHtml, initSettings, state } from '../js/api.js';

    const initialParameters = new URLSearchParams(window.location.search);
    let activeEditorView = initialParameters.get('view') || 'build';
    if (activeEditorView === 'agent') activeEditorView = 'build';
    let activeWorkspaceView = initialParameters.get('workspace') || localStorage.getItem('leerpret.leerbox.editor.workspace') || 'vat';
    let activeTwinId = initialParameters.get('id') || localStorage.getItem('leerpret.leerbox.id') || '';
    let loadedTwins = [];
    let simulationEnabled = false;

    function activeRole() {
      return new URLSearchParams(window.location.search).get('role') || localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'guest';
    }

    function updateEditorMenu() {
      document.querySelectorAll('[data-editor-page-view]').forEach((button) => {
        const sameView = button.getAttribute('data-editor-page-view') === activeEditorView;
        const samePanel = !button.dataset.editorPanel || button.dataset.editorPanel === localStorage.getItem('leerpret.leerbox.editor.panel');
        const sameWorkspace = !button.dataset.editorWorkspaceView || button.dataset.editorWorkspaceView === activeWorkspaceView;
        const active = sameView && samePanel && sameWorkspace;
        button.classList.toggle('active', active);
        button.setAttribute('aria-current', active ? 'page' : 'false');
      });
      document.getElementById('editor-advisor-dock')?.classList.toggle('is-active', activeEditorView === 'agent');
    }

    function leerboxStatus(status) {
      const key = String(status || 'concept').trim().toLowerCase();
      const labels = { proto_leerbox: 'prototype', concept: 'concept', pilot: 'pilot', af: 'af', digital_twin: 'af', active: 'af', actief: 'af', definitief: 'af', afgerond: 'af' };
      const progress = { concept: 0, proto_leerbox: 25, pilot: 60, af: 100, digital_twin: 100, active: 100, actief: 100, definitief: 100, afgerond: 100 };
      return { label: labels[key] || key.replaceAll('_', ' '), className: `status-${key.replaceAll('_', '-')}`, progress: progress[key] ?? 0 };
    }

    function sortTwinsByStatus(twins) {
      const rank = {
        af: 4,
        digital_twin: 4,
        active: 4,
        actief: 4,
        definitief: 4,
        afgerond: 4,
        pilot: 3,
        proto_leerbox: 2,
        prototype: 2,
        concept: 1
      };
      return [...twins].sort((a, b) => {
        const statusDiff = (rank[String(b.status || '').toLowerCase()] || 0) - (rank[String(a.status || '').toLowerCase()] || 0);
        if (statusDiff) return statusDiff;
        return String(a.title || a.id).localeCompare(String(b.title || b.id), 'nl', { sensitivity: 'base' });
      });
    }

    function renderTwinPopover() {
      const popover = document.getElementById('editor-twin-popover');
      if (!popover) return;
      if (!loadedTwins.length) {
        popover.innerHTML = '<p class="editor-twin-empty">Geen leerboxen beschikbaar.</p>';
        return;
      }
      popover.innerHTML = loadedTwins.map((twin) => {
        const status = leerboxStatus(twin.status);
        const title = twin.title || twin.id;
        return `
          <button type="button" data-twin-id="${escapeHtml(twin.id)}" class="${twin.id === activeTwinId ? 'is-active' : ''}">
            <span aria-hidden="true">◫</span>
            <strong>${escapeHtml(title)}</strong>
            <small>${escapeHtml(status.label)}</small>
          </button>`;
      }).join('');
    }

    function applyActiveTwin(twinId, { reload = true } = {}) {
      if (!twinId || !loadedTwins.some((item) => item.id === twinId)) return;
      activeTwinId = twinId;
      localStorage.setItem('leerpret.leerbox.id', activeTwinId);
      const select = document.getElementById('editor-twin-select');
      if (select) select.value = activeTwinId;
      const twin = loadedTwins.find((item) => item.id === activeTwinId);
      updateSimulationAvailability(twin);
      const badge = document.getElementById('editor-twin-status');
      if (badge) {
        const status = leerboxStatus(twin?.status);
        badge.textContent = status.label;
        badge.className = `twin-status-badge ${status.className}`;
        badge.setAttribute('aria-valuenow', String(status.progress));
        badge.setAttribute('aria-valuetext', status.label);
        updateWorldProgress(status.progress);
      }
      renderLeerboxIntel(twin);
      renderTwinPopover();
      const url = new URL(window.location.href);
      url.searchParams.set('id', activeTwinId);
      history.replaceState({}, '', url);
      updatePageLinks(activeRole());
      if (reload) loadEditor();
    }

    function updatePageLinks(role) {
      const backLink = document.getElementById('editor-back-to-learningbox');
      if (!backLink) return;
      const query = new URLSearchParams({ role });
      if (activeTwinId) query.set('id', activeTwinId);
      backLink.href = `/learningbox?${query.toString()}`;
    }

    async function loadTwins() {
      const select = document.getElementById('editor-twin-select');
      const statusBadge = document.getElementById('editor-twin-status');
      if (!select) return;
      const response = await apiGet('/simulator/datasets');
      loadedTwins = sortTwinsByStatus(response.leerbox_twins || []);
      if (!loadedTwins.length) {
        select.innerHTML = '<option value="">Geen leerboxen beschikbaar</option>';
        return;
      }
      if (!loadedTwins.some((twin) => twin.id === activeTwinId)) activeTwinId = loadedTwins[0].id;
      select.innerHTML = loadedTwins.map((twin) => `<option value="${escapeHtml(twin.id)}">${escapeHtml(twin.title || twin.id)}</option>`).join('');
      select.value = activeTwinId;
      const twin = loadedTwins.find((item) => item.id === activeTwinId);
      if (statusBadge) {
        const status = leerboxStatus(twin?.status);
        statusBadge.textContent = status.label;
        statusBadge.className = `twin-status-badge ${status.className}`;
        statusBadge.setAttribute('aria-valuenow', String(status.progress));
        statusBadge.setAttribute('aria-valuetext', status.label);
        updateWorldProgress(status.progress);
      }
      renderLeerboxIntel(twin);
      updateSimulationAvailability(twin);
      localStorage.setItem('leerpret.leerbox.id', activeTwinId);
      renderTwinPopover();
    }

    function updateSimulationAvailability(twin) {
      const validation = twin?.gevat_validation || {};
      const missing = Array.isArray(validation.missing) ? validation.missing.filter(Boolean) : [];
      const twinId = String(twin?.id || activeTwinId || '').toLowerCase();
      const simulationTestOverride = twinId === 'leerbox-learngame-operations-management'
        || twinId.includes('learngame-operations-management');
      simulationEnabled = validation.is_gevat === true || simulationTestOverride;
      const clock = document.querySelector('.simulation-clock');
      const lock = document.getElementById('simulation-clock-lock');
      const reasons = document.getElementById('simulation-clock-lock-reasons');
      const play = document.getElementById('simulation-clock-play');
      const input = document.getElementById('simulation-action-count');
      clock?.classList.toggle('is-disabled', !simulationEnabled);
      clock?.setAttribute('aria-disabled', String(!simulationEnabled));
      clock?.setAttribute('tabindex', simulationEnabled ? '-1' : '0');
      if (clock) clock.title = simulationEnabled ? 'Simulatieduur en aantal acties instellen' : 'Simulatie uitgeschakeld: de leerbox is nog niet gevat';
      if (play) play.disabled = !simulationEnabled;
      if (input) input.disabled = !simulationEnabled;
      document.querySelectorAll('[data-clock-slider]').forEach((slider) => {
        slider.setAttribute('aria-disabled', String(!simulationEnabled));
        slider.setAttribute('tabindex', simulationEnabled ? '0' : '-1');
      });
      if (lock) lock.hidden = simulationEnabled;
      if (reasons) {
        reasons.innerHTML = (simulationTestOverride ? ['testmodus: LEARNGame Operations Management mag simuleren'] : (missing.length ? missing : ['leerboxvalidatie is nog niet afgerond']))
          .map((reason) => `<li>${escapeHtml(reason)}</li>`).join('');
      }
    }

    function renderLeerboxIntel(twin) {
      const panel = document.getElementById('leerbox-intel-panel');
      if (!panel || !twin) return;
      const metrics = twin.metrics || {};
      const validation = twin.gevat_validation || {};
      const markers = twin.marker_mapping || {};
      const query = new URLSearchParams({ role: activeRole(), id: twin.id });
      panel.innerHTML = `
        <header><div><span>ACTIEVE WERELD</span><strong>${escapeHtml(twin.title || twin.id)}</strong><small>${escapeHtml(twin.type || 'onbekend')} · ${escapeHtml(twin.domain || 'geen domein')}</small></div>
          <nav><a href="/learningbox?${query.toString()}" title="Open op Leerbox-pagina">⌂</a><a href="/preview?${query.toString()}" title="Open browserleerbox">◉</a></nav></header>
        <div class="intel-resources">
          <span><i>⬡</i><b>${Number(metrics.objects || twin.objects?.length || 0)}</b><small>Objecten</small></span>
          <span><i>➜</i><b>${Number(metrics.route_steps || twin.route?.length || 0)}</b><small>Route</small></span>
          <span><i>✦</i><b>${Number(metrics.action_types || twin.example_action_types?.length || 0)}</b><small>Acties</small></span>
          <span><i>⌘</i><b>${Number(metrics.source_paths || twin.source_paths?.length || 0)}</b><small>Bronnen</small></span>
          <span class="${validation.is_gevat ? 'is-valid' : 'is-invalid'}"><i>${validation.is_gevat ? '✓' : '!'}</i><b>${validation.is_gevat ? 'Gevat' : 'Open'}</b><small>Validatie</small></span>
        </div>
        <div class="intel-briefing">
          <article><span>Leerdoel</span><p>${escapeHtml(twin.central_learning_goal || 'Nog niet ingevuld.')}</p></article>
          <article><span>Ontdekking</span><p>${escapeHtml(twin.central_discovery || 'Nog niet ingevuld.')}</p></article>
          <article><span>Succes</span><p>${escapeHtml(twin.success_definition || 'Nog niet ingevuld.')}</p></article>
          <article><span>Weerstand</span><p>${escapeHtml(twin.main_barrier || 'Nog niet ingevuld.')}</p></article>
        </div>
        <div class="intel-markers">${['T','A','V','R','S'].map(marker => `<span title="${escapeHtml(markers[marker] || 'Nog niet gemapt')}"><b>${marker}</b><small>${escapeHtml(markers[marker] || 'Niet gemapt')}</small></span>`).join('')}</div>
        ${validation.missing?.length ? `<p class="intel-warning">⚠ ${validation.missing.map(item => escapeHtml(item)).join(' · ')}</p>` : ''}`;
    }

    async function loadEditor() {
      const role = activeRole();
      const status = document.getElementById('editor-page-status');
      const iframe = document.getElementById('editor-page-iframe');
      updatePageLinks(role);
      if (!status || !iframe) return;

      try {
        const editorUrl = new URL(editorRootUrl());
        editorUrl.searchParams.set('api', state.apiBase);
        editorUrl.searchParams.set('role', role);
        editorUrl.searchParams.set('embedded', '1');
        editorUrl.searchParams.set('view', 'build');
        editorUrl.searchParams.set('workspace', activeWorkspaceView);
        editorUrl.searchParams.set('parent_origin', window.location.origin);
        if (activeTwinId) editorUrl.searchParams.set('leerbox_id', activeTwinId);
        iframe.src = editorUrl.toString();
        status.hidden = true;
      } catch (error) {
        status.hidden = false;
        status.textContent = `Editor kon niet worden geladen: ${error.message || error}`;
      }
    }

    function updateWorldProgress(progress) {
      const phaseIndex = progress >= 100 ? 3 : progress >= 60 ? 2 : progress >= 25 ? 1 : 0;
      const phaseLabels = ['Concept', 'Prototype', 'Pilot', 'Uitrol'];
      const phaseColors = ['#c17455', '#6e89c8', '#e6ad43', '#4bc7bf'];
      document.querySelectorAll('[data-clock-phase]').forEach((phase, index) => {
        phase.classList.toggle('is-complete', index < phaseIndex);
        phase.classList.toggle('is-current', index === phaseIndex);
        phase.setAttribute('aria-current', index === phaseIndex ? 'step' : 'false');
      });
      const simulationClock = document.querySelector('.simulation-clock');
      simulationClock?.setAttribute('data-current-phase', ['concept', 'prototype', 'pilot', 'rollout'][phaseIndex]);
      simulationClock?.style.setProperty('--current-phase-color', phaseColors[phaseIndex]);
      const phaseLabel = document.getElementById('clock-phase-label');
      phaseLabel?.replaceChildren(phaseLabels[phaseIndex].toUpperCase());
      if (phaseLabel) {
        phaseLabel.style.fill = phaseColors[phaseIndex];
        phaseLabel.classList.remove('is-popping');
        requestAnimationFrame(() => phaseLabel.classList.add('is-popping'));
      }
    }

    function editorTargetIsActive(view, panel = '', workspaceView = '') {
      const activePanel = localStorage.getItem('leerpret.leerbox.editor.panel') || '';
      const sameView = view === activeEditorView;
      const samePanel = !panel || panel === activePanel;
      const sameWorkspace = !workspaceView || workspaceView === activeWorkspaceView;
      return sameView && samePanel && sameWorkspace;
    }

    function editorHasFloatingWindowOpen() {
      const activePanel = localStorage.getItem('leerpret.leerbox.editor.panel') || '';
      return activeEditorView !== 'build'
        || activeWorkspaceView !== 'vat'
        || Boolean(activePanel);
    }

    function closeEditorWindow() {
      activeEditorView = 'build';
      activeWorkspaceView = 'vat';
      localStorage.setItem('leerpret.leerbox.editor.view', 'build');
      localStorage.setItem('leerpret.leerbox.editor.workspace', 'vat');
      localStorage.removeItem('leerpret.leerbox.editor.panel');
      updateEditorMenu();
      const url = new URL(window.location.href);
      url.searchParams.set('view', 'build');
      url.searchParams.set('workspace', 'vat');
      url.searchParams.delete('panel');
      history.replaceState({}, '', url);
      const iframe = document.getElementById('editor-page-iframe');
      if (iframe?.contentWindow && iframe.src) {
        const origin = new URL(iframe.src).origin;
        iframe.contentWindow.postMessage({ type: 'leerpret-editor-view', view: 'build', panel: '', workspaceView: 'vat' }, origin);
        // Ook de vensters binnen de editor sluiten: het wereldrapport en open dialogen
        // vallen buiten de view-status en bleven anders staan.
        iframe.contentWindow.postMessage({ type: 'leerpret-editor-close-overlays' }, origin);
      }
    }

    function selectEditorView(view, panel = '', workspaceView = '', options = {}) {
      const canToggleClosed = !(view === 'build' && (!workspaceView || workspaceView === 'vat'));
      if (options.toggle && canToggleClosed && editorTargetIsActive(view, panel, workspaceView)) {
        closeEditorWindow();
        return;
      }
      activeEditorView = view;
      localStorage.setItem('leerpret.leerbox.editor.view', view);
      const openToolFlyout = document.getElementById('editor-tool-flyout');
      if (openToolFlyout) {
        openToolFlyout.hidden = true;
        openToolFlyout.classList.remove('is-pinned');
      }
      if (panel) localStorage.setItem('leerpret.leerbox.editor.panel', panel);
      else localStorage.removeItem('leerpret.leerbox.editor.panel');
      if (workspaceView) {
        activeWorkspaceView = workspaceView;
        localStorage.setItem('leerpret.leerbox.editor.workspace', workspaceView);
      } else {
        activeWorkspaceView = 'vat';
        localStorage.setItem('leerpret.leerbox.editor.workspace', 'vat');
      }
      updateEditorMenu();
      const url = new URL(window.location.href);
      url.searchParams.set('view', view);
      url.searchParams.set('workspace', activeWorkspaceView);
      history.replaceState({}, '', url);
      const iframe = document.getElementById('editor-page-iframe');
      if (iframe?.contentWindow && iframe.src) {
        const embeddedView = ['agent', 'sources', 'description', 'intake', 'validation'].includes(view) ? view : 'build';
        iframe.contentWindow.postMessage({ type: 'leerpret-editor-view', view: embeddedView, panel, workspaceView: activeWorkspaceView }, new URL(iframe.src).origin);
      }
    }

    function requestGeneratedPreview() {
      const iframe = document.getElementById('editor-page-iframe');
      if (!iframe?.contentWindow || !iframe.src) return;
      iframe.contentWindow.postMessage({ type: 'leerpret-editor-generate-preview' }, new URL(iframe.src).origin);
    }

    function clickEmbeddedEditorControl(selector) {
      const iframe = document.getElementById('editor-page-iframe');
      if (!iframe?.contentWindow || !iframe.src) return;
      iframe.contentWindow.postMessage({ type: 'leerpret-editor-click-control', selector }, new URL(iframe.src).origin);
    }

    function sendSimulationControl(mode) {
      if (!simulationEnabled) return;
      const iframe = document.getElementById('editor-page-iframe');
      const actionCount = Math.max(1, Number(document.getElementById('simulation-action-count')?.value || 100));
      if (!iframe?.contentWindow || !iframe.src) return;
      const unit = document.getElementById('simulation-unit')?.value || 'actions';
      const sigma = document.getElementById('simulation-sigma')?.value || '2 sigma - gebalanceerd';
      iframe.contentWindow.postMessage({ type: 'leerpret-editor-simulation-control', mode, action_count: actionCount, simulation_unit: unit, sigma }, new URL(iframe.src).origin);
      document.querySelectorAll('[data-sim-control]').forEach((button) => button.classList.toggle('is-active', button.dataset.simControl === mode));
    }

    function showGeneratedPreview(data) {
      if (!data?.capture) return;
      const previewUrl = new URL(data.preview_url, apiRootUrl());
      const apiOrigin = new URL(apiRootUrl()).origin;
      if (previewUrl.origin !== apiOrigin || !previewUrl.pathname.startsWith('/api/previews/')) return;
      const leerboxId = data.capture.metadata?.leerbox_id || activeTwinId;
      sessionStorage.setItem('leerpret.generatedPreview', JSON.stringify({
        leerbox_id: leerboxId,
        preview_url: previewUrl.toString(),
        capture: data.capture
      }));
      const query = new URLSearchParams({ role: activeRole(), id: leerboxId, generated: data.preview_id || previewUrl.pathname.split('/')[3] || '1' });
      window.location.href = `/preview?${query.toString()}`;
    }

    window.addEventListener('message', (event) => {
      const editorFrame = document.getElementById('editor-page-iframe');
      const editorOrigin = editorFrame?.src
        ? new URL(editorFrame.src).origin
        : new URL(editorRootUrl()).origin;
      if (event.origin !== editorOrigin) return;
      if (event.data?.type === 'leerpret-preview-generated' && event.source === editorFrame?.contentWindow) {
        showGeneratedPreview(event.data);
      }
      if (event.data?.type === 'leerpret-simulation-status' && event.source === editorFrame?.contentWindow) {
        const clock = document.querySelector('.simulation-clock');
        clock?.classList.toggle('is-running', event.data.status === 'running');
        clock?.classList.toggle('is-complete', event.data.status === 'complete');
      }
      if (event.data?.type === 'leerpret-editor-panel-closed' && event.source === editorFrame?.contentWindow) {
        closeEditorWindow();
      }
      if (event.data?.type === 'leerpret-editor-workspace-view' && event.source === editorFrame?.contentWindow) {
        activeWorkspaceView = event.data.workspace_view || 'vat';
        localStorage.setItem('leerpret.leerbox.editor.workspace', activeWorkspaceView);
        const url = new URL(window.location.href);
        url.searchParams.set('workspace', activeWorkspaceView);
        history.replaceState({}, '', url);
        updateEditorMenu();
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      initSettings();
      updateEditorMenu();
      document.querySelectorAll('[data-editor-page-view]').forEach((button) => {
        button.addEventListener('click', () => selectEditorView(button.getAttribute('data-editor-page-view') || 'description', button.dataset.editorPanel || '', button.dataset.editorWorkspaceView || '', { toggle: true }));
      });
      const editorToolMenu = document.querySelector('.editor-page-menu');
      const editorMenuCollapse = document.getElementById('editor-menu-collapse');
      const editorToolFlyout = document.getElementById('editor-tool-flyout');
      const editorToolTitle = document.getElementById('editor-tool-flyout-title');
      const editorToolSummary = document.getElementById('editor-tool-flyout-summary');
      const toolSummaries = {
        description: 'Beschrijf missie, visie, doelen, weerstand en succes.',
        sources: 'Importeer, kies of download bronnen voor deze leerbox.',
        intake: 'Leg spelregels, startpunt, route en meetpunten vast.',
        build: 'Werk aan plan, structuur, kaart of code van de leerbox.',
        validation: 'Controleer routes, voorwaarden, issues en adviezen.',
        json: 'Bekijk en exporteer de gevatte leerbox als JSON.'
      };
      let pinnedToolButton = null;
      const setEditorMenuCollapsed = (collapsed) => {
        editorToolMenu?.classList.toggle('is-collapsed', collapsed);
        if (editorMenuCollapse) {
          editorMenuCollapse.setAttribute('aria-expanded', String(!collapsed));
          editorMenuCollapse.setAttribute('aria-label', collapsed ? 'Linker gereedschapspaneel uitklappen' : 'Linker gereedschapspaneel inklappen');
          editorMenuCollapse.title = collapsed ? 'Uitklappen' : 'Inklappen';
          editorMenuCollapse.textContent = collapsed ? '›' : '−';
        }
        if (collapsed) {
          pinnedToolButton = null;
          if (editorToolFlyout) editorToolFlyout.hidden = true;
          document.getElementById('editor-advisor-panel')?.setAttribute('hidden', '');
          document.getElementById('editor-advisor-toggle')?.setAttribute('aria-expanded', 'false');
        }
        localStorage.setItem('leerpret.editor.menu.collapsed', String(collapsed));
      };
      setEditorMenuCollapsed(localStorage.getItem('leerpret.editor.menu.collapsed') === 'true');
      editorMenuCollapse?.addEventListener('click', (event) => {
        event.stopPropagation();
        setEditorMenuCollapsed(!editorToolMenu?.classList.contains('is-collapsed'));
      });
      const showToolFlyout = (button, pin = false) => {
        if (!(button instanceof HTMLElement) || !editorToolFlyout) return;
        if (editorToolMenu?.classList.contains('is-collapsed')) return;
        if (!pin && editorHasFloatingWindowOpen()) {
          pinnedToolButton = null;
          editorToolFlyout.hidden = true;
          return;
        }
        const buttonView = button.dataset.editorPageView || '';
        const buttonWorkspace = button.dataset.editorWorkspaceView || '';
        const buttonPanel = button.dataset.editorPanel || '';
        const sameOpenScreen = buttonView === activeEditorView
          && (!buttonWorkspace || buttonWorkspace === activeWorkspaceView)
          && (!buttonPanel || buttonPanel === localStorage.getItem('leerpret.leerbox.editor.panel'));
        if (!pin && sameOpenScreen) {
          pinnedToolButton = null;
          editorToolFlyout.hidden = true;
          return;
        }
        if (pin) pinnedToolButton = button;
        const title = button.querySelector('strong')?.textContent || button.title || 'Gereedschap';
        editorToolTitle?.replaceChildren(title);
        editorToolSummary?.replaceChildren(button.dataset.toolSummary || button.title || toolSummaries[buttonView] || 'Open dit gereedschap.');
        const maximumTop = Math.max(4, (editorToolMenu?.clientHeight || 500) - 132);
        editorToolFlyout.style.setProperty('--tool-flyout-top', `${Math.min(button.offsetTop, maximumTop)}px`);
        editorToolFlyout.hidden = false;
        editorToolFlyout.classList.toggle('is-pinned', Boolean(pinnedToolButton));
      };
      document.querySelectorAll('.editor-page-menu button[data-editor-page-view]').forEach((button) => {
        button.addEventListener('pointerenter', () => showToolFlyout(button));
        button.addEventListener('focus', () => showToolFlyout(button));
        button.addEventListener('click', (event) => {
          event.stopPropagation();
          const buttonView = button.dataset.editorPageView || '';
          const buttonWorkspace = button.dataset.editorWorkspaceView || '';
          const buttonPanel = button.dataset.editorPanel || '';
          const sameOpenScreen = buttonView === activeEditorView
            && (!buttonWorkspace || buttonWorkspace === activeWorkspaceView)
            && (!buttonPanel || buttonPanel === localStorage.getItem('leerpret.leerbox.editor.panel'));
          if (sameOpenScreen) {
            pinnedToolButton = null;
            if (editorToolFlyout) editorToolFlyout.hidden = true;
            return;
          }
          pinnedToolButton = null;
          if (editorToolFlyout) editorToolFlyout.hidden = true;
        });
      });
      editorToolMenu?.addEventListener('pointerleave', () => {
        if (editorToolFlyout) editorToolFlyout.hidden = true;
      });
      document.getElementById('editor-tool-flyout-close')?.addEventListener('click', (event) => {
        event.stopPropagation();
        pinnedToolButton = null;
        if (editorToolFlyout) editorToolFlyout.hidden = true;
        closeEditorWindow();
      });
      const advisorDock = document.getElementById('editor-advisor-dock');
      const advisorPanel = document.getElementById('editor-advisor-panel');
      const advisorToggle = document.getElementById('editor-advisor-toggle');
      let advisorPinned = false;
      const toggleAdvisorPanel = (open) => {
        advisorDock?.classList.toggle('is-open', open);
        advisorDock?.classList.toggle('is-pinned', advisorPinned && open);
        if (advisorPanel) advisorPanel.hidden = !open;
        advisorToggle?.setAttribute('aria-expanded', String(open));
        if (open && editorToolFlyout) {
          pinnedToolButton = null;
          editorToolFlyout.hidden = true;
        }
      };
      advisorToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        advisorPinned = false;
        toggleAdvisorPanel(false);
        selectEditorView('agent', '', '', { toggle: true });
      });
      advisorDock?.addEventListener('pointerenter', () => {
        if (!advisorPinned) toggleAdvisorPanel(true);
      });
      advisorDock?.addEventListener('pointerleave', () => {
        if (!advisorPinned) toggleAdvisorPanel(false);
      });
      document.getElementById('editor-advisor-close')?.addEventListener('click', (event) => {
        event.stopPropagation();
        advisorPinned = false;
        toggleAdvisorPanel(false);
      });
      document.getElementById('editor-advisor-chat')?.addEventListener('click', (event) => {
        event.stopPropagation();
        advisorPinned = false;
        toggleAdvisorPanel(false);
        selectEditorView('agent', '', '', { toggle: true });
      });
      const embeddedControls = {
        'hud-new-action': '#newCaptureButton',
        'hud-prompt-action': '#promptButton',
        'hud-preview-action': '#previewWebappButton',
        'hud-export-action': '#exportButton',
        'hud-report-action': '#canvasReportToggle',
        'hud-step-action': '#addStepButton',
        'hud-dependency-action': '#addDependencyButton'
      };
      // Gereedschap opent een eigen dialoogvenster; ruim eerst het openstaande venster op,
      // anders stapelen Plan, Structuur of Code zich op achter de dialoog.
      const toolActions = new Set(['hud-step-action', 'hud-dependency-action']);
      Object.entries(embeddedControls).forEach(([id, selector]) => {
        document.getElementById(id)?.addEventListener('click', () => {
          if (toolActions.has(id)) closeEditorWindow();
          clickEmbeddedEditorControl(selector);
        });
      });
      document.getElementById('hud-upload-action')?.addEventListener('click', (event) => {
        event.stopPropagation();
        selectEditorView('sources', '', '', { toggle: true });
      });
      // De leerobjecttypes staan altijd in beeld; er valt niets meer uit te klappen.
      const objectSubtools = document.getElementById('editor-object-subtools');
      objectSubtools?.querySelectorAll('[data-object-preset]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.stopPropagation();
          closeEditorWindow();
          const iframe = document.getElementById('editor-page-iframe');
          if (!iframe?.contentWindow || !iframe.src) return;
          iframe.contentWindow.postMessage({ type: 'leerpret-editor-add-object-preset', preset: button.dataset.objectPreset }, new URL(iframe.src).origin);
        });
      });
      document.getElementById('generate-preview-action')?.addEventListener('click', requestGeneratedPreview);
      const simulationValues = { actions: 100, duration: 30 };
      const simulationInput = document.getElementById('simulation-action-count');
      const simulationUnit = document.getElementById('simulation-unit');
      const clockFace = document.querySelector('.simulation-clock-face');
      const clockRanges = {
        actions: { min: 0, max: 200, step: 10 },
        duration: { min: 0, max: 60, step: 5 }
      };
      const clockProgress = (unit, value) => {
        const range = clockRanges[unit];
        return Math.max(0, Math.min(100, (value - range.min) / (range.max - range.min) * 100));
      };
      const updateClockValue = (unit, rawValue) => {
        const range = clockRanges[unit];
        const value = Math.max(range.min, Math.min(range.max, Math.round(Number(rawValue) / range.step) * range.step));
        simulationValues[unit] = value;
        document.getElementById(`clock-${unit}-value`)?.replaceChildren(String(value));
        const arc = document.getElementById(`clock-${unit}-arc`);
        const progress = clockProgress(unit, value);
        if (arc) {
          arc.style.strokeDasharray = `${progress} 100`;
          arc.setAttribute('aria-valuenow', String(value));
        }
        const hand = document.querySelector(unit === 'duration' ? '.clock-hand-minute' : '.clock-hand-action');
        if (hand) hand.style.transform = `rotate(${unit === 'duration' ? value % 60 * 6 : progress * 3.6}deg)`;
        if (simulationUnit?.value === unit && simulationInput) simulationInput.value = String(value);
      };
      const selectClockUnit = (unit) => {
        const duration = unit === 'duration';
        if (simulationUnit) simulationUnit.value = unit;
        if (simulationInput) {
          simulationInput.min = '0';
          simulationInput.step = duration ? '5' : '10';
          simulationInput.max = duration ? '60' : '200';
          simulationInput.value = String(simulationValues[unit]);
          simulationInput.setAttribute('aria-label', duration ? 'Simulatieduur in minuten' : 'Aantal acties');
        }
        document.querySelector('.simulation-clock')?.setAttribute('data-selected-unit', unit);
        document.querySelectorAll('[data-clock-slider]').forEach((slider) => slider.classList.toggle('is-selected', slider.dataset.clockSlider === unit));
      };
      document.querySelectorAll('[data-sim-step]').forEach((button) => button.addEventListener('click', () => {
        const unit = button.dataset.clockStepUnit || simulationUnit?.value || 'actions';
        const direction = Math.sign(Number(button.dataset.simStep || 0));
        selectClockUnit(unit);
        updateClockValue(unit, simulationValues[unit] + direction * clockRanges[unit].step);
      }));
      const setClockFromPointer = (event, slider) => {
        if (!clockFace || !simulationEnabled) return;
        const unit = slider.dataset.clockSlider;
        const range = clockRanges[unit];
        const rect = clockFace.getBoundingClientRect();
        const y = Math.max(18, Math.min(202, -18 + (event.clientY - rect.top) / rect.height * 256));
        const progress = (202 - y) / 184;
        const value = range.min + progress * (range.max - range.min);
        selectClockUnit(unit);
        updateClockValue(unit, value);
      };
      document.querySelectorAll('[data-clock-slider]').forEach((slider) => {
        slider.addEventListener('pointerdown', (event) => { slider.setPointerCapture(event.pointerId); setClockFromPointer(event, slider); });
        slider.addEventListener('pointermove', (event) => { if (slider.hasPointerCapture(event.pointerId)) setClockFromPointer(event, slider); });
        slider.addEventListener('keydown', (event) => {
          if (!simulationEnabled) return;
          if (!['ArrowUp', 'ArrowRight', 'ArrowDown', 'ArrowLeft'].includes(event.key)) return;
          event.preventDefault();
          const unit = slider.dataset.clockSlider;
          const direction = ['ArrowUp', 'ArrowRight'].includes(event.key) ? 1 : -1;
          selectClockUnit(unit);
          updateClockValue(unit, simulationValues[unit] + direction * clockRanges[unit].step);
        });
      });
      updateClockValue('duration', simulationValues.duration);
      updateClockValue('actions', simulationValues.actions);
      selectClockUnit('actions');
      document.querySelectorAll('[data-sim-control]').forEach((button) => button.addEventListener('click', () => sendSimulationControl(button.dataset.simControl || 'play')));
      const simulationClock = document.querySelector('.simulation-clock');
      if (simulationClock) document.body.appendChild(simulationClock);
      const simulationSettings = document.getElementById('simulation-clock-settings');
      const simulationConfig = document.getElementById('simulation-clock-config');
      const toggleSimulationSettings = (open) => {
        simulationClock?.classList.toggle('is-configuring', open);
        if (simulationConfig) simulationConfig.hidden = !open;
        simulationSettings?.setAttribute('aria-expanded', String(open));
      };
      simulationSettings?.addEventListener('click', () => toggleSimulationSettings(true));
      document.getElementById('simulation-clock-settings-close')?.addEventListener('click', () => toggleSimulationSettings(false));
      document.getElementById('simulation-unit')?.addEventListener('change', (event) => {
        selectClockUnit(event.target.value === 'duration' ? 'duration' : 'actions');
      });
      simulationInput?.addEventListener('change', () => updateClockValue(simulationUnit?.value || 'actions', simulationInput.value));
      const intelToggle = document.getElementById('leerbox-intel-toggle');
      const intelPanel = document.getElementById('leerbox-intel-panel');
      intelToggle?.addEventListener('click', () => {
        const open = intelToggle.getAttribute('aria-expanded') !== 'true';
        intelToggle.setAttribute('aria-expanded', String(open));
        intelPanel.hidden = !open;
      });
      loadTwins().then(() => {
        const url = new URL(window.location.href);
        if (activeTwinId) url.searchParams.set('id', activeTwinId);
        history.replaceState({}, '', url);
        updatePageLinks(activeRole());
        loadEditor();
      }).catch((error) => {
        const status = document.getElementById('editor-page-status');
        if (status) status.textContent = `Leerboxen konden niet worden geladen: ${error.message || error}`;
      });
      document.getElementById('editor-twin-select')?.addEventListener('change', (event) => applyActiveTwin(event.target.value));
      const twinContext = document.querySelector('.editor-leerbox-context');
      const twinPopover = document.getElementById('editor-twin-popover');
      twinContext?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        renderTwinPopover();
        if (twinPopover) twinPopover.hidden = !twinPopover.hidden;
      });
      twinPopover?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-twin-id]');
        if (!button) return;
        event.preventDefault();
        event.stopPropagation();
        applyActiveTwin(button.getAttribute('data-twin-id'));
        twinPopover.hidden = true;
      });
      document.addEventListener('click', (event) => {
        if (!twinPopover || twinPopover.hidden) return;
        if (event.target.closest('.editor-leerbox-context')) return;
        twinPopover.hidden = true;
      });
    });
  </script>
</Layout>

