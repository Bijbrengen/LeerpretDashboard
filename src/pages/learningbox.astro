      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .kapstok-stats-strip {
      grid-template-columns: repeat(4, 1fr);
    }

    .twin-catalog-body {
      flex-direction: row;
    }

    .twin-catalog-body > div {
      flex: 1;
    }
  }
