    border-bottom: 1px solid var(--line);
    padding: 8px;
    text-align: left;
    vertical-align: top;
  }

  .path-event-table th {
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.68rem;
  }

  @media (min-width: 960px) {
