    // Load active step markers
    async function loadCurrentStepSettings() {
      try {
        const response = await apiGet('/developer/steps');
        const steps = response.steps || [];
        const activeStepId = localStorage.getItem('active_step_id') || 'definition';
        const step = steps.find(s => s.id === activeStepId) || steps[0];
        
        if (step) {
          const order = step.order || 1;
          let markers = [0.70, 0.80, 0.50, 0.80, 1.00];
          if (order === 1) markers = [0.20, 0.30, 0.20, 0.10, 0.00];
          if (order === 2) markers = [0.50, 0.60, 0.40, 0.30, 0.20];
          if (order === 3) markers = [0.80, 0.85, 0.70, 0.75, 0.80];
          if (order === 4) markers = [0.90, 0.90, 0.80, 0.90, 1.00];
          
          setStepMarkersUI(markers);
          activeCurrentStepMarkers = markers;
          
          // Calculate step immediately upon loading
          updateCalculatedLeerpret(markers);
        }
      } catch (err) {
        alert('Fout bij inladen huidige instellingen: ' + err.message);
      }
    }

    // Set up active step reset & calculate binds
    function setupCurrentSettingsPanel() {
      document.getElementById('btn-reset-current')?.addEventListener('click', () => {
        setStepMarkersUI([0, 0, 0, 0, 0]);
        activeCurrentStepMarkers = [0, 0, 0, 0, 0];
        resetResultsCardToEmpty();
      });
    }

    // Setup action sequence node clicking
    function setupActionSequence() {
      const ribbon = document.getElementById('action-sequence-ribbon');
      if (!ribbon) return;

      document.querySelectorAll('.btn-action-node').forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-action');
          
          if (sequenceArray.length === 0) {
            ribbon.innerHTML = '';
          }

          let icon = '⚪';
          if (type === 'gewoon') {
            sequenceRaw.actions++;
            sequenceRaw.unique_targets++;
            icon = '🔵';
          } else if (type === 'weerstand') {
            sequenceRaw.frictions++;
            icon = '🔴';
          } else if (type === 'herstel') {
            sequenceRaw.recoveries++;
            icon = '🟢';
          } else if (type === 'succes') {
            sequenceRaw.successes++;
            icon = '🟡';
          } else if (type === 'tijd') {
            sequenceRaw.duration += 30;
            icon = '⚪';
          }

          sequenceArray.push(icon);

          const itemSpan = document.createElement('span');
          itemSpan.className = 'ribbon-item';
          itemSpan.textContent = icon;
          ribbon.appendChild(itemSpan);

          document.getElementById('sequence-counters-label').textContent = `Reeks details: ${sequenceRaw.actions} acties, ${sequenceRaw.frictions} weerstand, ${sequenceRaw.recoveries} herstel, ${sequenceRaw.successes} succes (${sequenceRaw.duration}s)`;

          // Trigger immediate calculation upon adding object
          const markers = convertRawToMarkers();
          updateCalculatedLeerpret(markers);
        });
      });

      document.getElementById('btn-reset-sequence')?.addEventListener('click', () => {
        sequenceRaw = { duration: 0, actions: 0, unique_targets: 0, frictions: 0, recoveries: 0, successes: 0 };
        rebuildRibbonFromRaw();
        resetResultsCardToEmpty();
      });
    }

    // Setup Input Method Dropdown Switcher with values carry over
    function setupInputMethodSwitcher() {
      const select = document.getElementById('learner-input-method-select');
      if (!select) return;

      select.addEventListener('change', () => {
        const method = select.value;
        setServicePaneMode('individual', currentServiceRole());
        const slidersPanel = document.getElementById('input-method-sliders-panel');
        const rawPanel = document.getElementById('input-method-raw-panel');
        const sequencePanel = document.getElementById('input-method-sequence-panel');
        const currentPanel = document.getElementById('input-method-current-panel');

        // Extract currently active markers before hiding panels to carry them over
        let currentMarkers = [0.60, 0.60, 0.33, 0.67, 1.00];

        if (slidersPanel && !slidersPanel.hidden) {
          currentMarkers = [
            Number(document.getElementById('slide-t').value),
            Number(document.getElementById('slide-a').value),
            Number(document.getElementById('slide-v').value),
            Number(document.getElementById('slide-r').value),
            Number(document.getElementById('slide-s').value)
          ];
        } else if (rawPanel && !rawPanel.hidden) {
          const dur = Number(document.getElementById('raw-duration').value || 0);
          const act = Number(document.getElementById('raw-actions').value || 0);
          const tar = Number(document.getElementById('raw-targets').value || 0);
          const fric = Number(document.getElementById('raw-frictions').value || 0);
          const rec = Number(document.getElementById('raw-recoveries').value || 0);
          const succ = Number(document.getElementById('raw-successes').value || 0);
          currentMarkers = calculateMarkersFromRaw(dur, act, tar, fric, rec, succ);
        } else if (sequencePanel && !sequencePanel.hidden) {
          currentMarkers = convertRawToMarkers();
        } else if (currentPanel && !currentPanel.hidden) {
          currentMarkers = activeCurrentStepMarkers;
        }

        // Hide all
        if (slidersPanel) slidersPanel.hidden = true;
        if (rawPanel) rawPanel.hidden = true;
        if (sequencePanel) sequencePanel.hidden = true;
        if (currentPanel) currentPanel.hidden = true;

        // Load active view and populate carried over markers
        if (method === 'sliders') {
          if (slidersPanel) slidersPanel.hidden = false;
          setSlidersUI(currentMarkers);
          updateCalculatedLeerpret(currentMarkers);
        } else if (method === 'raw') {
          if (rawPanel) rawPanel.hidden = false;
          const raw = convertMarkersToRaw(currentMarkers[0], currentMarkers[1], currentMarkers[2], currentMarkers[3], currentMarkers[4]);
          setRawInputsUI({
            duration: raw.duration,
            actions: raw.actions,
            targets: raw.unique_targets,
            frictions: raw.frictions,
            recoveries: raw.recoveries,
            successes: raw.successes
          });
          updateCalculatedLeerpret(currentMarkers);
        } else if (method === 'sequence') {
          if (sequencePanel) sequencePanel.hidden = false;
          sequenceRaw = convertMarkersToRaw(currentMarkers[0], currentMarkers[1], currentMarkers[2], currentMarkers[3], currentMarkers[4]);
          rebuildRibbonFromRaw();
          updateCalculatedLeerpret(currentMarkers);
        } else if (method === 'current') {
          if (currentPanel) currentPanel.hidden = false;
          setStepMarkersUI(currentMarkers);
          activeCurrentStepMarkers = currentMarkers;
          updateCalculatedLeerpret(currentMarkers);
        }
      });
    }

    // --- VIEW 2: ATTRACTION GROUPS SIMULATION ---
    let loadedSimulatorTwins = [];
    let loadedSimulatorGroups = [];

    // Helper: Parse profile markers from JSON
    function extractMarkers(p) {
      if (Array.isArray(p.markers)) {
        return p.markers;
      } else if (p.markers && typeof p.markers === 'object') {
        return [
          p.markers.T ?? p.markers.time ?? 0,
          p.markers.A ?? p.markers.activity ?? 0,
          p.markers.V ?? p.markers.variety ?? 0,
          p.markers.R ?? p.markers.resilience ?? 0,
          p.markers.S ?? p.markers.success ?? 0
        ];
      } else {
        const duration = p.duration ?? p.duration_seconds ?? 0;
        const actions = p.actions ?? p.action_count ?? 1;
        const unique_targets = p.unique_targets ?? p.unique_objects ?? 0;
        const frictions = p.frictions ?? p.friction_count ?? 1;
        const recoveries = p.recoveries ?? p.recovery_count ?? 0;
        const successes = p.successes ?? p.success_count ?? 0;
        return [
          Math.max(0, Math.min(1, duration / 600.0)),
          Math.max(0, Math.min(1, actions / 40.0)),
          Math.max(0, Math.min(1, unique_targets / Math.max(actions, 1.0))),
          Math.max(0, Math.min(1, recoveries / Math.max(frictions, 1.0))),
          Math.max(0, Math.min(1, successes))
        ];
      }
    }

    /* Herkomst van een Leerbox: welk park en welke attractie erbij horen. Deze indeling
       stond eerder verspreid over de twee weggevallen keuzelijsten; hij voedt nu de
       broodkruimel boven het tabblad Concept. */
    function herkomstVanLeerbox(twin) {
      const id = String(twin?.id || "").toLowerCase();
      let park = 'Proefopstelling';
      if (id.includes('drukwerkplaats')) park = 'Drenthe';
      else if (id.includes('growing-emmen') || id.includes('operations-management')) park = 'LE-Network';
      else if (id.includes('phile')) park = 'Bijbrengen';
      return { park, attractie: twin?.title || twin?.id || '-' };
    }

    /* Leerboxnamen tonen we met een hoofdletter. De id's zijn kleingeschreven met
       koppeltekens, en dat leest in een keuzelijst als een technische sleutel. */
    function leerboxNaam(twin) {
      const ruw = String(twin?.id || "").replace(/^leerbox-/, "").replaceAll("-", " ").trim();
      if (!ruw) return String(twin?.title || "Leerbox");
      return ruw.charAt(0).toUpperCase() + ruw.slice(1);
    }

    let simulatieGegevensBezig = false;

    async function loadSimulationData() {
      const select = document.getElementById('attraction-twin-select') as HTMLSelectElement;
      if (!select) return;
      if (loadedSimulatorTwins.length > 0 || simulatieGegevensBezig) return;
      simulatieGegevensBezig = true;

      try {
        const response = await apiGet('/simulator/datasets');
        loadedSimulatorTwins = response.leerbox_twins || [];
        loadedSimulatorGroups = response.groups || [];

        if (loadedSimulatorTwins.length === 0) {
          select.innerHTML = '<option value="">Geen Leerboxen beschikbaar</option>';
          return;
        }

        const gesorteerd = [...loadedSimulatorTwins].sort((a, b) =>
          leerboxNaam(a).localeCompare(leerboxNaam(b), 'nl')
        );

        select.innerHTML = gesorteerd
          .map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(leerboxNaam(t))}</option>`)
          .join('');

        select.addEventListener('change', () => renderAttractionSimulation(select.value));
        renderAttractionSimulation(select.value);
      } catch (error) {
        select.innerHTML = '<option value="">Fout bij laden van Leerboxen</option>';
      } finally {
        simulatieGegevensBezig = false;
      }
    }

    async function renderAttractionSimulation(twinId) {
      const twin = loadedSimulatorTwins.find(t => t.id === twinId);
      if (!twin) return;

      // Broodkruimel: bij welk park en welke attractie hoort deze Leerbox.
      const herkomst = herkomstVanLeerbox(twin);
      const kruimelPark = document.getElementById('kruimel-park');
      const kruimelAttractie = document.getElementById('kruimel-attractie');
      const kruimelLeerbox = document.getElementById('kruimel-leerbox');
      if (kruimelPark) kruimelPark.textContent = herkomst.park;
      if (kruimelAttractie) kruimelAttractie.textContent = herkomst.attractie;
      if (kruimelLeerbox) kruimelLeerbox.textContent = leerboxNaam(twin);

      document.getElementById('attraction-twin-details').hidden = false;
      document.getElementById('attraction-twin-status').textContent = twin.status || 'concept';
      document.getElementById('attraction-twin-status').className = `eyebrow twin-status-badge status-${String(twin.status || "").toLowerCase()}`;
      document.getElementById('attraction-twin-title').textContent = twin.title || twin.id;
      document.getElementById('attraction-twin-summary').textContent = twin.summary || "Geen samenvatting.";
      document.getElementById('attraction-twin-goal').textContent = twin.central_learning_goal || "-";
      document.getElementById('attraction-twin-discovery').textContent = twin.central_discovery || "-";
      document.getElementById('attraction-twin-success').textContent = twin.central_success_definition || twin.success_definition || "-";
      document.getElementById('attraction-twin-barrier').textContent = twin.main_barrier || "-";
      updateDetailedRunsVisibility();
      renderTechnologistFormulaPanel(twin);

      const slug = String(twin.id || "").replace(/^leerbox-/, "");
      let selectedGroup = null;
      let selectedFile = null;

      const matchedGroup = loadedSimulatorGroups.find(g => {
        const groupId = String(g.id || "").toLowerCase();
        const groupTitle = String(g.title || "").toLowerCase();
        return groupId.includes(slug) || groupTitle.includes(slug.replaceAll("-", " "));
      });

      if (matchedGroup && matchedGroup.files && matchedGroup.files.length > 0) {
        selectedGroup = matchedGroup;
        selectedFile = matchedGroup.files[0];
      } else {
        const allFiles = loadedSimulatorGroups.flatMap(g => 
          (g.files || []).map(f => ({ ...f, groupId: g.id }))
        );
        
        const directMatch = allFiles.find(f => {
          const name = String(f.name || "").toLowerCase();
          return name.includes(slug) || name.includes(slug.replaceAll("-", "_"));
        });

        if (directMatch) {
          selectedGroup = loadedSimulatorGroups.find(g => g.id === directMatch.groupId);
          selectedFile = directMatch;
        } else {
          let hashCode = 0;
          for (let i = 0; i < slug.length; i++) {
            hashCode = slug.charCodeAt(i) + ((hashCode << 5) - hashCode);
          }
          if (allFiles.length > 0) {
            const picked = allFiles[Math.abs(hashCode) % allFiles.length];
            selectedGroup = loadedSimulatorGroups.find(g => g.id === picked.groupId);
            selectedFile = picked;
          }
        }
      }

      if (!selectedGroup || !selectedFile) {
        document.getElementById('attraction-runs-table-body').innerHTML = `
          <tr><td colspan="8" class="text-center muted-text" style="padding:20px;">Geen simulatiebestanden gevonden voor deze leerbox.</td></tr>
        `;
        renderTechnologistFormulaPanel(twin, []);
        return;
      }

      try {
        const data = await apiGet(`/simulator/datasets/${selectedGroup.id}/files/${selectedFile.name}`);
        const profiles = data.profiles || data.profielen || [];
        renderTechnologistFormulaPanel(twin, profiles);

        if (profiles.length === 0) {
          document.getElementById('attraction-runs-table-body').innerHTML = `
            <tr><td colspan="8" class="text-center muted-text" style="padding:20px;">Simulatiebestand bevat geen profielen.</td></tr>
          `;
          return;
        }

        let totalScore = 0;
        const archCounts = {
          "Veroveraar": 0,
          "Verwerver": 0,
          "Verkenner": 0,
          "Volger": 0,
          "Verlater": 0
        };

        const rowsHtml = profiles.map((p, idx) => {
          const m = extractMarkers(p);
          const result = calculateLeerpretJs(m);
          totalScore += result.learning_value;
          
          if (result.dominant_archetype) {
            archCounts[result.dominant_archetype]++;
          }

          const badgeColor = {
            "Veroveraar": "#FF4B4B",
            "Verwerver": "#0068C9",
            "Verkenner": "#FF8C00",
            "Volger": "#29B09D",
            "Verlater": "#808495"
          }[result.dominant_archetype] || 'var(--muted)';

          const fullName = p.name || p.naam || "Simulant";
          let displayName = fullName;
          let isLong = false;
          if (fullName.length > 25) {
            displayName = fullName.substring(0, 22) + "...";
            isLong = true;
          }

          const nameCellHtml = isLong 
            ? `<div class="collapsible-name-cell" data-idx="${idx}" data-full="${escapeHtml(fullName)}" data-short="${escapeHtml(displayName)}" style="cursor: pointer; color: var(--green); font-weight: 700; display: inline-flex; align-items: center; gap: 4px;" title="Klik om uit/in te klappen">
                 <span class="name-text">${escapeHtml(displayName)}</span>
                 <span class="toggle-icon" style="font-size: 0.65rem; color: var(--muted);">▼</span>
               </div>`
            : `<strong>${escapeHtml(fullName)}</strong>`;

          return `
            <tr>
              <td>${nameCellHtml}</td>
              <td>${m[0].toFixed(2)}</td>
              <td>${m[1].toFixed(2)}</td>
              <td>${m[2].toFixed(2)}</td>
              <td>${m[3].toFixed(2)}</td>
              <td>${m[4].toFixed(2)}</td>
              <td><strong>${Math.round(result.learning_value * 100)}%</strong></td>
              <td><span class="badge-arch" style="background-color: ${badgeColor};">${result.dominant_archetype || 'Geen'}</span></td>
            </tr>
          `;
        }).join('');

        const avgScore = totalScore / profiles.length;

        document.getElementById('attraction-stat-users').textContent = profiles.length.toString();
        document.getElementById('attraction-stat-score').textContent = `${Math.round(avgScore * 100)}%`;

        const distHtml = Object.entries(archCounts).map(([name, count]) => {
          const pct = profiles.length > 0 ? Math.round((count / profiles.length) * 100) : 0;
          const colors = {
            "Veroveraar": "#FF4B4B",
            "Verwerver": "#0068C9",
            "Verkenner": "#FF8C00",
            "Volger": "#29B09D",
            "Verlater": "#808495"
          };
          return `
            <div class="archetype-mix-row" style="margin-top: 8px;">
              <div class="archetype-mix-label">
                <strong>${name}</strong>
                <span>${pct}% (${count})</span>
              </div>
              <div class="archetype-mix-bar-bg">
                <div class="archetype-mix-bar-fill" style="width: ${pct}%; background-color: ${colors[name]};"></div>
              </div>
            </div>
          `;
        }).join('');
        document.getElementById('attraction-archetype-dist-target').innerHTML = distHtml;
        document.getElementById('attraction-runs-table-body').innerHTML = rowsHtml;

      } catch (err) {
        renderTechnologistFormulaPanel(twin, []);
        document.getElementById('attraction-runs-table-body').innerHTML = `
          <tr><td colspan="8" class="text-center muted-text" style="padding:20px;">Fout bij inladen en berekenen van simulatiebestand: ${err.message}</td></tr>
        `;
      }
    }

    function setupProtocolTester() {
      const form = document.getElementById('protocol-evaluate-form');
      const output = document.getElementById('protocol-evaluate-output');
      if (!form || !output || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const payload = {
          STATEMENT: {
            ACTOR: { TYPE: "ACTOR", id: "developer-dashboard" },
            CONTEXT: { TYPE: "CONTEXT", id: "local-development" },
            ACTION: {
              TYPE: "ACTION",
              id: "evaluate-marker-request",
              data: {
                duration: Number(data.get('duration') || 0),
                actions: Number(data.get('actions') || 0),
                unique_targets: Number(data.get('unique_targets') || 0),
                frictions: Number(data.get('frictions') || 0),
                recoveries: Number(data.get('recoveries') || 0),
                successes: Number(data.get('successes') || 0),
              },
            },
            WITH: [{ TYPE: "RESOURCE", id: "dashboard-form" }],
            IN: [{ TYPE: "CONTEXT", id: "local-development" }],
            WHEN: [{ TYPE: "TIME", id: "submit-time" }],
          },
        };

        output.textContent = "Bezig met versturen...";
        renderProtocolArchetypeOverlap(null);
        try {
          const response = await apiPost('/engine/evaluate', payload);
          output.textContent = JSON.stringify(response, null, 2);
          await renderProtocolArchetypeOverlap(
            response,
            response?.personal_result_available === false
              ? 'Geen persoonsuitkomst beschikbaar: deze acties zijn pseudoniem ontvangen.'
              : undefined
          );
        } catch (error) {
          output.textContent = `Fout bij versturen: ${error.message || error}`;
          renderProtocolArchetypeOverlap(null, 'Geen archetype-overlap beschikbaar door een fout in de evaluatie.');
        }
      });
    }

    function extractArchetypeMix(response) {
      return response?.STATEMENT?.ANALYSIS?.archetype_mix
        || response?.statement?.analysis?.archetype_mix
        || response?.analysis?.archetype_mix
        || response?.archetype_mix
        || null;
    }

    async function renderProtocolArchetypeOverlap(response, emptyText = 'Voer een engine-evaluatie uit om de archetype-overlap te tonen.') {
      const plot = document.getElementById('protocol-archetype-overlap-plot');
      if (!plot) return;

      const mix = response ? extractArchetypeMix(response) : null;
      const entries = mix
        ? Object.entries(mix)
            .map(([name, value]) => [name, Number(value || 0)])
            .sort((a, b) => b[1] - a[1])
        : [];

      if (!entries.length) {
        plot.innerHTML = `<p class="muted-text">${escapeHtml(emptyText)}</p>`;
        return;
      }

      const colors = ["#1982C4", "#29B09D", "#FF8C00", "#7C3AED", "#64748B"];
      const labels = entries.map(([name]) => name);
      const values = entries.map(([, value]) => value);
      const Plotly = await loadPlotly();

      Plotly.newPlot(plot, [{
        type: 'bar',
        orientation: 'h',
        y: labels.slice().reverse(),
        x: values.slice().reverse(),
        marker: { color: colors.slice(0, entries.length).reverse() },
        text: values.slice().reverse().map(value => `${Math.round(value * 100)}%`),
        textposition: 'auto',
        hovertemplate: '%{y}<br>%{x:.0%}<extra></extra>',
      }], {
        height: 250,
        margin: { t: 12, b: 36, l: 104, r: 16 },
        xaxis: { tickformat: '.0%', range: [0, Math.max(1, Math.max(...values) * 1.08)] },
        yaxis: { automargin: true },
        paper_bgcolor: 'rgba(0,0,0,0)',
        plot_bgcolor: 'rgba(0,0,0,0)',
      }, { responsive: true, displayModeBar: false });
    }

    async function loadPlotly() {
      if (window.__leerpretPlotly) return window.__leerpretPlotly;
      const module = await import('plotly.js-dist-min');
      window.__leerpretPlotly = module.default || module;
      return window.__leerpretPlotly;
    }

    function setAttractionServiceHeader(activeRole) {
      const eyebrow = document.getElementById('service-eyebrow');
      const title = document.getElementById('service-title');
      const desc = document.getElementById('service-desc');
      if (!eyebrow || !title || !desc) return;

      if (activeRole === 'guest') {
        eyebrow.textContent = 'Gastmodus';
        title.textContent = 'Lever acties pseudoniem aan';
        desc.textContent = 'Zonder login verwerkt de API iedere aanvraag losstaand en zonder betrouwbare person_id.';
        return;
      }

      if (activeRole === 'technologist') {
        eyebrow.textContent = 'Formules';
        title.textContent = 'Formules naar Leerpret';
        desc.textContent = 'Bekijk per leerbox hoe actiedata via markers, archetypen en weegvector tot de leerpretuitkomst leidt.';
        return;
      }

      eyebrow.textContent = 'Groepssimulatie';
      title.textContent = 'Leerattractie Simulator';
      desc.textContent = 'Simuleer leerpretuitkomsten over een grote groep gebruikers voor de geselecteerde leerbox.';
    }

    let isInitialized = false;

    function initServiceView() {
      if (isInitialized) {
        const urlParams = new URLSearchParams(window.location.search);
        const activeRole = urlParams.get('role') || localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'architect';
        const serviceMode = currentServiceMode(activeRole);
        localStorage.setItem('active_role', activeRole);
        localStorage.setItem('leerpret.poc.role', activeRole);
        setServicePaneMode(serviceMode, activeRole);
        return;
      }
      isInitialized = true;

      initSettings();
      mountUnifiedServiceWorkbench();
      setupSliders();
      setupRawInputs();
      setupCurrentSettingsPanel();
      setupActionSequence();
      setupInputMethodSwitcher();
      setupServiceBlockPicker();
      setupServiceTabs();
      setupProtocolTester();

      const urlParams = new URLSearchParams(window.location.search);
      const activeRole = urlParams.get('role') || localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'architect';
      const serviceMode = currentServiceMode(activeRole);
      localStorage.setItem('active_role', activeRole);
      localStorage.setItem('leerpret.poc.role', activeRole);
      
      const learnerContainer = document.getElementById('learner-service-view');
      const attractionContainer = document.getElementById('attraction-service-view');

      if (learnerContainer) learnerContainer.hidden = true;
      if (attractionContainer) attractionContainer.hidden = false;
      
      const methodSelect = document.getElementById('learner-input-method-select');
      if (methodSelect) methodSelect.value = 'sliders';

      setSlidersUI([0.60, 0.60, 0.33, 0.67, 1.00]);
      setRawInputsUI({
        duration: 360,
        actions: 24,
        targets: 8,
        frictions: 3,
        recoveries: 2,
        successes: 1
      });
      sequenceRaw = {
        duration: 360,
        actions: 24,
        unique_targets: 8,
        frictions: 3,
        recoveries: 2,
        successes: 1
      };
      rebuildRibbonFromRaw();
      resetResultsCardToEmpty();

      const requestedMethod = urlParams.get('input');
      const allowedMethods = new Set(['sliders', 'raw', 'sequence', 'current']);
      if (methodSelect && allowedMethods.has(requestedMethod)) {
        methodSelect.value = requestedMethod;
        methodSelect.dispatchEvent(new Event('change'));
      }

      setServicePaneMode(serviceMode, activeRole);

      // Bind Huidige Instellingen click
      document.getElementById('btn-load-current-settings')?.addEventListener('click', loadCurrentStepSettings);

      // Bind event delegation for collapsible name cells in runs table
      document.getElementById('attraction-runs-table-body')?.addEventListener('click', (e) => {
        const cell = e.target.closest('.collapsible-name-cell');
        if (!cell) return;

        const nameTextEl = cell.querySelector('.name-text');
        const iconEl = cell.querySelector('.toggle-icon');
        const isExpanded = cell.getAttribute('data-expanded') === 'true';

        if (isExpanded) {
          nameTextEl.textContent = cell.getAttribute('data-short');
          iconEl.textContent = '▼';
          cell.setAttribute('data-expanded', 'false');
        } else {
          nameTextEl.textContent = cell.getAttribute('data-full');
          iconEl.textContent = '▲';
          cell.setAttribute('data-expanded', 'true');
        }
      });

      // De runtabel heeft geen knop meer om uit te klappen: hij vult het hele tabblad.
    }

    /* Een Gast kan op deze pagina niets betekenisvols doen: zonder login koppelt de
       engine de acties niet aan een persoon en komt er geen uitkomst terug. Daarom
       sturen we hem meteen door naar het inlogscherm in plaats van hem een pagina
       te tonen die alleen maar kan teleurstellen. */
    function stuurGastNaarInloggen() {
      if (currentServiceRole() !== 'guest') return false;
      const base = window.location.pathname.startsWith('/LeerpretDashboard') ? '/LeerpretDashboard' : '';
      const doel = new URL(`${base}/login/`, window.location.origin);
      doel.searchParams.set('next', `${base}/service/`);
      window.location.replace(`${doel.pathname}${doel.search}`);
      return true;
    }

    window.addEventListener('DOMContentLoaded', () => {
      if (stuurGastNaarInloggen()) return;
      initServiceView();
    });

    window.addEventListener('service-connection-changed', () => {
      // Ook bij een rolwissel tijdens de sessie geldt de doorverwijzing.
      if (stuurGastNaarInloggen()) return;
      initServiceView();
    });
  </script>
</Layout>

