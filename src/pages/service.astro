    function triggerRawCalculation() {
      const duration = Number(document.getElementById('raw-duration').value || 0);
      const actions = Number(document.getElementById('raw-actions').value || 0);
      const targets = Number(document.getElementById('raw-targets').value || 0);
      const frictions = Number(document.getElementById('raw-frictions').value || 0);
