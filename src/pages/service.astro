    // Convert T, A, V, R, S back to raw action counts
    function convertMarkersToRaw(T, A, V, R, S) {
      const duration = Math.round(T * 600);
      const actions = Math.round(A * 40);
      const unique_targets = Math.round(V * actions);
      const frictions = actions > 0 ? Math.max(1, Math.round(actions * 0.15)) : 0;
      const recoveries = Math.round(R * frictions);
      const successes = Math.round(S);
      return { duration, actions, unique_targets, frictions, recoveries, successes };
    }

    // Calculate T, A, V, R, S markers from sequence raw counters or manual inputs
    function calculateMarkersFromRaw(duration, actions, unique_targets, frictions, recoveries, successes) {
      const T = Math.max(0, Math.min(1, duration / 600.0));
      const A = Math.max(0, Math.min(1, actions / 40.0));
      const V = Math.max(0, Math.min(1, unique_targets / Math.max(actions, 1.0)));
      const R = Math.max(0, Math.min(1, recoveries / Math.max(frictions, 1.0)));
      const S = Math.max(0, Math.min(1, successes));
      return [T, A, V, R, S];
    }

    // Calculate T, A, V, R, S markers from sequence raw counters
    function convertRawToMarkers() {
      return calculateMarkersFromRaw(
        sequenceRaw.duration,
        sequenceRaw.actions,
        sequenceRaw.unique_targets,
        sequenceRaw.frictions,
        sequenceRaw.recoveries,
        sequenceRaw.successes
      );
    }

    // Rebuild ribbon nodes list
    function rebuildRibbonFromRaw() {
      const ribbon = document.getElementById('action-sequence-ribbon');
      if (!ribbon) return;

      ribbon.innerHTML = '';
      sequenceArray = [];

      for (let i = 0; i < sequenceRaw.actions; i++) sequenceArray.push('🔵');
      for (let i = 0; i < sequenceRaw.frictions; i++) sequenceArray.push('🔴');
      for (let i = 0; i < sequenceRaw.recoveries; i++) sequenceArray.push('🟢');
      for (let i = 0; i < sequenceRaw.successes; i++) sequenceArray.push('🟡');
      const whiteNodesCount = Math.round(sequenceRaw.duration / 30);
      for (let i = 0; i < whiteNodesCount; i++) sequenceArray.push('⚪');

      if (sequenceArray.length === 0) {
        ribbon.innerHTML = '<span class="empty-ribbon-text">Reeks is leeg. Klik op objecten hierboven.</span>';
        document.getElementById('sequence-counters-label').textContent = 'Reeks details: 0 acties, 0 weerstand, 0 herstel, 0 succes (0s)';
      } else {
        sequenceArray.forEach(icon => {
          const span = document.createElement('span');
          span.className = 'ribbon-item';
          span.textContent = icon;
          ribbon.appendChild(span);
        });
        document.getElementById('sequence-counters-label').textContent = `Reeks details: ${sequenceRaw.actions} acties, ${sequenceRaw.frictions} weerstand, ${sequenceRaw.recoveries} herstel, ${sequenceRaw.successes} succes (${sequenceRaw.duration}s)`;
      }
    }

