---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Verken de onderdelen en kies vanuit het overzicht waar je verder wilt werken.">
  


  <!-- Mobile Stacked Flowchart (Base CSS) -->
  <section class="mobile-flow-section">
    <div class="section-header-row">
      <span class="eyebrow">Dashboard Kaart</span>
      <h2 class="section-title">Leerpret Structuurkaart</h2>
      <p class="muted-text">Volg de stroom van gedragsspoor tot leerpret-score. Tap op een stap om die te openen.</p>
    </div>

    <div class="mobile-flow-list">
      
      <a href="/park" class="flow-step-card teal-accent">
        <div class="step-num">1</div>
        <div class="step-details">
          <h4>Leerattractie</h4>
          <p>Digitale pilots (bijv. Drukwerkplaats of LEARNgame) waar acties plaatsvinden.</p>
        </div>
        <span class="arrow-right">→</span>
      </a>

      <div class="flow-divider">↓</div>

      <a href="/learningbox" class="flow-step-card teal-accent">
        <div class="step-num">2</div>
        <div class="step-details">
          <h4>Leerbox (Digitale Tweeling)</h4>
          <p>Definieert de toegestane routes en didactische markers.</p>
        </div>
        <span class="arrow-right">→</span>
      </a>

      <div class="flow-divider">↓</div>

      <a href="/engine" class="flow-step-card green-accent" id="home-flow-engine">
        <div class="step-num">3</div>
        <div class="step-details">
          <h4>Leerpret Engine</h4>
          <p>Vertaalt gedragsspoor-statements naar engagement vectoren.</p>
        </div>
        <span class="arrow-right">→</span>
      </a>

      <div class="flow-divider">↓</div>

      <a href="/service" class="flow-step-card blue-accent">
        <div class="step-num">4</div>
        <div class="step-details">
          <h4>Service API</h4>
          <p>FastAPI endpoints die de dashboards en de engine voeden.</p>
        </div>
        <span class="arrow-right">→</span>
      </a>

      <div class="flow-divider">↓</div>

      <div class="flow-step-card gray-accent">
        <div class="step-num">5</div>
        <div class="step-details">
          <h4>Rapportage</h4>
          <p>Samenvatting van scores en diagnostische archetype-mix.</p>
        </div>
      </div>

      <div class="flow-divider">↓</div>

      <a href="/service?role=learner" class="flow-step-card violet-accent">
        <div class="step-num">6</div>
        <div class="step-details">
          <h4>Lerende</h4>
          <p>Ontvangt direct feedback in de vorm van actieve leerpret.</p>
        </div>
        <span class="arrow-right">→</span>
      </a>

    </div>
  </section>

  <!-- Desktop Interactive SVG map (Hidden on mobile) -->
  <section class="desktop-map-section">
    <div class="section-header-row">
      <span class="eyebrow">Interactieve Kaart</span>
      <h2 class="section-title">Dashboardstructuur</h2>
    </div>
    <div class="home-map">
      <svg class="home-structure-svg" viewBox="0 0 1280 620" role="img" aria-labelledby="home-map-title home-map-desc">
        <title id="home-map-title">Leerpretengine dashboardstructuur</title>
        <desc id="home-map-desc">Klikbare kaart: de Leerpretarchitect ontwerpt de leerbox; de Leerprettechnoloog bouwt aan de engine en service; de leerattractie levert leerboxmetadata en ontvangt een rapport; de lerende levert acties en krijgt leerpret terug.</desc>
        <defs>
          <marker id="home-arrow" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto">
            <path d="M2,2 L10,6 L2,10 Z" fill="#ea9c72"></path>
          </marker>
        </defs>

        <!-- Uitleg linksboven: de rollen in het dashboard. -->
        <g class="home-explanation-panel" transform="translate(30 18)" aria-label="Uitleg van de rollen">
          <rect width="300" height="156" rx="12"></rect>
          <text x="18" y="34" class="home-explanation-title">Meerdere perspectieven</text>
          <text x="18" y="61" class="home-explanation-text">
            <tspan x="18" dy="0">Het dashboard kent meerdere perspectieven.</tspan>
            <tspan x="18" dy="22">Wat zichtbaar is, hangt af van de rol.</tspan>
            <tspan x="18" dy="22">De Lerende staat voorop; de overige</tspan>
            <tspan x="18" dy="22">rollen en onderdelen zijn dienend.</tspan>
          </text>
          <a href="/help" aria-label="Meer uitleg over de rollen">
            <text x="282" y="146" class="home-explanation-more" text-anchor="end">Meer…</text>
          </a>
        </g>

        <!-- Uitleg rechtsboven: de onderdelen en informatiestroom. -->
        <g class="home-explanation-panel" transform="translate(950 18)" aria-label="Uitleg van de Service en Leerpret-engine">
          <rect width="300" height="156" rx="12"></rect>
          <text x="18" y="34" class="home-explanation-title">Opzet van de Service</text>
          <text x="18" y="59" class="home-explanation-text">
            <tspan x="18" dy="0">Rollen maken via de Service contact</tspan>
            <tspan x="18" dy="19">met de Leerpret-engine. Die is gebouwd</tspan>
            <tspan x="18" dy="19">op basis van Artikelen en wordt getraind</tspan>
            <tspan x="18" dy="19">met simulatie- en praktijkdata.</tspan>
          </text>
          <a href="/help" aria-label="Meer uitleg over de Service en Leerpret-engine">
            <text x="282" y="146" class="home-explanation-more" text-anchor="end">Meer…</text>
          </a>
        </g>

        <!-- De bestaande kaart is omlaag geschoven om ruimte te maken voor de rolbediening. -->
        <g class="home-map-main" transform="translate(0 170)">
        
        <!-- Service Shell -->
        <g class="home-service-shell cursor-pointer" data-href="/service" role="button" tabindex="0" aria-label="Service" transform="translate(430 54)">
          <title>Service: verbindt de rollen met de Leerpret-engine, die op Artikelen is gebouwd en met simulatie- en praktijkdata wordt getraind.</title>
          <rect width="448" height="330" rx="14"></rect>
          <text x="28" y="46" class="home-map-label">Service</text>
        </g>
        
        <!-- Flows -->
        <path class="home-flow secondary" d="M392 174 C408 174 418 174 430 174" marker-end="url(#home-arrow)"></path>
        <path class="home-flow secondary" d="M430 264 C414 264 404 264 392 264" marker-end="url(#home-arrow)"></path>
        <path class="home-flow learner-flow" d="M1060 140 C994 140 944 140 878 140" marker-end="url(#home-arrow)"></path>
        <path class="home-flow learner-flow" d="M878 302 C944 302 994 302 1060 302" marker-end="url(#home-arrow)"></path>
        
