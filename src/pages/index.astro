  <!-- Client-side logic for Home view -->
  <script>
    // Get current active role
    const activeRole = localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'architect';
    const isTechnologist = activeRole === 'technologist';
    const isArchitect = activeRole === 'architect';

    // 1. Enforce access rules for Engine Elements
    const engineMobileLink = document.getElementById('home-flow-engine');
    const engineSvgNode = document.querySelector('.home-engine-core');

    if (!isTechnologist && !isArchitect) {
      if (engineMobileLink) {
        engineMobileLink.removeAttribute('href');
        engineMobileLink.style.opacity = '0.5';
        engineMobileLink.style.pointerEvents = 'none';
        const arrow = engineMobileLink.querySelector('.arrow-right');
        if (arrow) arrow.textContent = '🔒';
      }
      if (engineSvgNode) {
        engineSvgNode.removeAttribute('data-href');
        engineSvgNode.classList.remove('cursor-pointer');
        engineSvgNode.style.opacity = '0.35';
        engineSvgNode.style.pointerEvents = 'none';
        engineSvgNode.setAttribute('aria-disabled', 'true');
        // Add a visual lock text or indicator inside the SVG group if needed
      }
    }

    // 2. Enforce access rules for Data Elements
    const dataSvgNode = document.querySelector('.home-data-store');
    
    if (!isTechnologist && !isArchitect) {
      if (dataSvgNode) {
        dataSvgNode.removeAttribute('data-href');
        dataSvgNode.classList.remove('cursor-pointer');
        dataSvgNode.style.opacity = '0.35';
        dataSvgNode.style.pointerEvents = 'none';
        dataSvgNode.setAttribute('aria-disabled', 'true');
      }
    }

    const getSubpath = (path) => {
      const base = window.location.pathname.startsWith('/LeerpretDashboard') ? '/LeerpretDashboard' : '';
      if (!path) return base || '/';
      if (path.startsWith('http://') || path.startsWith('https://')) return path;
      if (base && path.startsWith(base)) return path;
      return `${base}${path.startsWith('/') ? '' : '/'}${path}`;
    };

    // Navigation trigger on SVG Map nodes with data-href
    document.querySelectorAll('[data-href]').forEach(node => {
      node.addEventListener('click', () => {
        const href = node.getAttribute('data-href');
        if (href) window.location.href = getSubpath(href);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          const href = node.getAttribute('data-href');
          if (href) window.location.href = getSubpath(href);
        }
      });
    });
  </script>
