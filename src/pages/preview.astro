---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Preview" description="Test de gekozen leerbox zoals een lerende die ziet en controleer de interacties.">
  <div class="preview-page-layout">
    <aside class="mobile-card preview-page-menu" aria-label="Previewmenu">
      <a class="preview-back-link" id="preview-back-to-learningbox" href="/learningbox">&larr; Terug naar Leerbox</a>
      <div class="preview-leerbox-context">
        <span class="eyebrow">Leerbox</span>
        <label for="preview-twin-select">Actieve leerbox</label>
        <select id="preview-twin-select" class="spacious-select"><option value="">Laden...</option></select>
        <div class="preview-context-actions">
          <a class="preview-compact-action" id="preview-description-link" href="/learningbox" aria-label="Beschrijving bekijken" title="Beschrijving bekijken"><svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6V4a2 2 0 0 1 2-2h8l4 4v11a2 2 0 0 1-2 2h-2"/><rect x="2" y="6" width="16" height="16" rx="2"/><path d="M6 11h8M6 15h8M6 19h5"/></svg></a>
          <a class="preview-compact-action" id="preview-editor-link" href="/editor" aria-label="Leerbox bewerken" title="Leerbox bewerken" hidden><svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/><path d="m14 7 3 3M5.5 16l3 3"/></svg></a>
          <span class="preview-compact-action active" aria-label="Actieve Preview" title="Preview"><svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></span>
          <div class="twin-status-badge status-concept" id="preview-twin-status" role="progressbar" aria-label="Voortgang leerbox" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">concept</div>
        </div>
      </div>
      <p class="preview-access-note" id="preview-access-note"></p>
      <p class="preview-telemetry-status" id="preview-telemetry-status">Interactieregistratie controleren...</p>
      <details class="preview-overlay-menu" open>
        <summary><span>Didactische overlay</span><strong>Gevatte Leerbox</strong></summary>
        <section class="captured-overlay" aria-label="Gevatte Leerbox">
          <div class="captured-overlay-heading"><span class="eyebrow">Live markers</span><span class="live-event-total" id="preview-event-total">0 acties</span></div>
          <div class="live-marker-dashboard" id="preview-marker-dashboard"></div>
          <div class="sensor-mapping-flow" id="preview-mapping-flow"></div>
        </section>
      </details>
    </aside>

    <main class="preview-page-content">
      <div class="preview-page-message" id="preview-page-message">Preview laden...</div>
      <section class="preview-stage" id="preview-stage" hidden>
        <header class="preview-stage-header">
          <span class="preview-stage-icon"><svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></span>
          <div class="preview-stage-title"><span class="eyebrow">Preview</span><h2 id="preview-title">Leerbox</h2></div>
          <div class="preview-device-controls" role="group" aria-label="Previewformaat">
            <button type="button" class="preview-device-button active" data-preview-device="laptop" aria-pressed="true" title="Laptopweergave">&#128187; <span>Laptop</span></button>
            <button type="button" class="preview-device-button" data-preview-device="mobile" aria-pressed="false" title="Mobiele weergave">&#128241; <span>Mobiel</span></button>
            <a class="preview-standalone-link" id="preview-standalone-link" href="#" target="_blank" rel="noopener" title="Open de Leerbox in een apart venster">Losmaken &#8599;</a>
            <output id="preview-device-size" class="preview-device-size">1440 &times; 900</output>
          </div>
        </header>
        <div class="preview-device-area" id="preview-device-area">
          <div class="preview-device-scale-box" id="preview-device-scale-box">
            <div class="preview-device-frame laptop" id="preview-device-frame">
              <div class="preview-device-browserbar" aria-hidden="true"><i></i><i></i><i></i><span id="preview-device-address">Leerbox-preview</span></div>
              <iframe id="preview-iframe" class="preview-iframe" title="Preview van de Leerbox" src=""></iframe>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    import { apiGet, apiPost, apiRootUrl, escapeHtml, initSettings } from '../js/api.js';

    const parameters = new URLSearchParams(window.location.search);
    let role = parameters.get('role') || localStorage.getItem('active_role') || localStorage.getItem('leerpret.poc.role') || 'guest';
    let activeTwinId = parameters.get('id') || localStorage.getItem('leerpret.leerbox.id') || '';
    let twins = [];
    let activeCapture = null;
    let previewEvents = [];
    let telemetryChecked = false;
    let telemetryEnabled = false;
    let telemetryCheckVersion = 0;
    let pendingTelemetryEvents = [];
    let activeDevice = localStorage.getItem('leerpret.preview.device') === 'mobile' ? 'mobile' : 'laptop';

    const previewDevices = {
      laptop: { width: 1440, height: 900, browserbar: 34 },
      mobile: { width: 390, height: 844, browserbar: 28 }
    };

    const publicStatuses = new Set(['pilot', 'digital_twin', 'active', 'actief', 'definitief', 'afgerond', 'af']);
    const isPublicReader = () => ['learner', 'guest'].includes(role);
    const statusIsPublic = (status) => publicStatuses.has(String(status || '').toLowerCase());

    async function checkPreviewTelemetryLogin() {
      const checkVersion = ++telemetryCheckVersion;
      const status = document.getElementById('preview-telemetry-status');
      try {
        const session = await apiGet('/auth/session');
        if (checkVersion !== telemetryCheckVersion) return;
        telemetryEnabled = Boolean(session.authenticated && session.user?.id);
        if (status) status.textContent = telemetryEnabled
          ? `Interactieregistratie actief voor ${session.user.label || session.user.id}.`
          : 'Log in om preview-interacties te registreren.';
      } catch (_) {
        if (checkVersion !== telemetryCheckVersion) return;
        telemetryEnabled = false;
        if (status) status.textContent = 'Log in om preview-interacties te registreren.';
      } finally {
        if (checkVersion !== telemetryCheckVersion) return;
        telemetryChecked = true;
        const queued = pendingTelemetryEvents;
        pendingTelemetryEvents = [];
        if (telemetryEnabled && queued.length) await persistPreviewEvents(queued);
      }
    }

    function normalizedTelemetryEvent(event) {
      const objectId = event?.learningObjectID || event?.learning_object_id || event?.leerobject_id || event?.object_id || event?.objectId || event?.stage || 'unknown-object';
      const action = event?.actionType || event?.action_type || event?.action || event?.event || 'interaction';
      const timestamp = Number.isNaN(Date.parse(event?.timestamp)) ? new Date().toISOString() : new Date(event.timestamp).toISOString();
      const sessionId = event?.sessionID || event?.session_id || null;
      return {
        timestamp,
        object_id: String(objectId),
        action: String(action),
        client_event_id: String(event?.event_id || event?.eventId || [sessionId, timestamp, objectId, action].join(':')),
        session_id: sessionId ? String(sessionId) : null,
        result: event?.result == null ? null : String(event.result),
        object_role: event?.objectRole == null ? null : String(event.objectRole),
        metadata: {
          stage: event?.stage == null ? null : String(event.stage),
          strategy: event?.strategy == null ? null : String(event.strategy),
          marker: event?.marker == null ? null : String(event.marker),
        },
      };
    }

    async function persistPreviewEvents(events) {
      if (!telemetryEnabled || !activeTwinId) return;
      const status = document.getElementById('preview-telemetry-status');
      const results = await Promise.allSettled(events.map((event) =>
        apiPost(`/leerbox/${encodeURIComponent(activeTwinId)}/preview-interactie`, normalizedTelemetryEvent(event))
      ));
      const failures = results.filter((result) => result.status === 'rejected').length;
      if (failures && status) status.textContent = `${failures} preview-interactie(s) konden niet worden opgeslagen.`;
    }

    function receivePreviewEvents(events) {
      const additions = Array.isArray(events) ? events : [];
      previewEvents.push(...additions);
      renderOverlay();
      if (!telemetryChecked) pendingTelemetryEvents.push(...additions);
      else if (telemetryEnabled) persistPreviewEvents(additions);
    }

    function fitPreviewDevice() {
      const area = document.getElementById('preview-device-area');
      const scaleBox = document.getElementById('preview-device-scale-box');
      const frame = document.getElementById('preview-device-frame');
      if (!area || !scaleBox || !frame) return;
      const device = previewDevices[activeDevice];
      const bezel = activeDevice === 'mobile' ? 18 : 20;
      const frameWidth = device.width + bezel;
      const frameHeight = device.height + device.browserbar;
      const outerFrameHeight = frameHeight + bezel;
      const availableWidth = Math.max(280, area.clientWidth - 32);
      const scale = Math.min(1, availableWidth / frameWidth);
      frame.style.width = `${device.width}px`;
      frame.style.height = `${frameHeight}px`;
      frame.style.transform = `scale(${scale})`;
      scaleBox.style.width = `${frameWidth * scale}px`;
      scaleBox.style.height = `${outerFrameHeight * scale}px`;
      document.getElementById('preview-device-size').textContent = `${device.width} × ${device.height} · ${Math.round(scale * 100)}%`;
    }

    function setPreviewDevice(deviceName) {
      if (!previewDevices[deviceName]) return;
      activeDevice = deviceName;
      localStorage.setItem('leerpret.preview.device', deviceName);
      const frame = document.getElementById('preview-device-frame');
      frame.classList.toggle('laptop', deviceName === 'laptop');
      frame.classList.toggle('mobile', deviceName === 'mobile');
      document.querySelectorAll('[data-preview-device]').forEach((button) => {
        const active = button.getAttribute('data-preview-device') === deviceName;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      fitPreviewDevice();
    }

    function statusPresentation(status) {
      const key = String(status || 'concept').toLowerCase();
      const labels = { proto_leerbox: 'prototype', concept: 'concept', pilot: 'pilot', af: 'af', digital_twin: 'af', active: 'af', actief: 'af', definitief: 'af', afgerond: 'af' };
      const progress = { concept: 0, proto_leerbox: 25, pilot: 60, af: 100, digital_twin: 100, active: 100, actief: 100, definitief: 100, afgerond: 100 };
      return { label: labels[key] || key.replaceAll('_', ' '), className: `status-${key.replaceAll('_', '-')}`, progress: progress[key] ?? 0 };
    }

    function sortTwinsByStatus(items) {
      const rank = {
        af: 4,
        digital_twin: 4,
        active: 4,
        actief: 4,
        definitief: 4,
        afgerond: 4,
        pilot: 3,
        proto_leerbox: 2,
        prototype: 2,
        concept: 1
      };
      return [...items].sort((a, b) => {
        const statusDiff = (rank[String(b.status || '').toLowerCase()] || 0) - (rank[String(a.status || '').toLowerCase()] || 0);
        if (statusDiff) return statusDiff;
        return String(a.title || a.id).localeCompare(String(b.title || b.id), 'nl', { sensitivity: 'base' });
      });
    }

    function markerForEvent(event, capture) {
      const explicit = String(event?.marker || event?.marker_role || event?.markerRole || '').toUpperCase();
      if (['T', 'A', 'V', 'R', 'S'].includes(explicit)) return explicit;
      const objectId = event?.learningObjectID || event?.learning_object_id || event?.object_id || event?.objectId;
      const object = (capture?.objects || []).find((item) => (item.object_id || item.id) === objectId);
      const likely = object?.likely_marker_roles || object?.likelyMarkerRoles || [];
      const marker = Array.isArray(likely) ? likely.find((value) => ['T', 'A', 'V', 'R', 'S'].includes(String(value).toUpperCase())) : null;
      if (marker) return String(marker).toUpperCase();
      const objectRole = String(object?.role || event?.objectRole || '').toLowerCase();
      if (/resistance|barrier|recovery/.test(objectRole)) return 'R';
      if (/success|reward/.test(objectRole)) return 'S';
      if (/variation|choice|exploration/.test(objectRole)) return 'V';
      return 'A';
    }

    function renderOverlay() {
      if (!activeCapture) return;
      const mapping = activeCapture.measurement?.marker_mapping || activeCapture.marker_mapping || {};
      const counts = { T: 0, A: 0, V: 0, R: 0, S: 0 };
      previewEvents.forEach((event) => { if (event?.timestamp) counts.T += 1; counts[markerForEvent(event, activeCapture)] += 1; });
      const names = { T: 'Tijd', A: 'Activiteit', V: 'Variatie', R: 'Veerkracht', S: 'Succes' };
      document.getElementById('preview-marker-dashboard').innerHTML = Object.keys(names).map((marker) => `<article class="live-marker-card ${counts[marker] ? 'is-live' : ''}"><strong>${marker}</strong><span>${names[marker]}</span><b>${counts[marker]}</b><small>${escapeHtml(mapping[marker] || 'Nog niet gekoppeld')}</small></article>`).join('');

      const objects = activeCapture.objects || [];
      const objectById = new Map(objects.map((item) => [item.object_id || item.id, item]));
      const route = activeCapture.interaction_route || activeCapture.route || [];
      const rows = route.length ? route : objects.map((item, index) => ({ step: index + 1, object_id: item.object_id || item.id }));
      document.getElementById('preview-mapping-flow').innerHTML = rows.slice(0, 20).map((step, index) => {
        const id = step.object_id || step.id;
        const object = objectById.get(id) || {};
        const markers = object.likely_marker_roles || [];
        return `<div class="mapping-flow-row"><span class="mapping-step">${escapeHtml(step.step || index + 1)}</span><div><strong>${escapeHtml(object.label || id || 'Leerobject')}</strong><small>${escapeHtml(step.participant_action || object.role || 'actie')}</small></div><span class="mapping-arrow" aria-hidden="true">&#8594;</span><div class="mapping-markers">${markers.length ? markers.map((marker) => `<b>${escapeHtml(marker)}</b>`).join('') : `<b>${markerForEvent({ object_id: id }, activeCapture)}</b>`}</div></div>`;
      }).join('') || '<p class="muted-text">Geen object- of routemapping beschikbaar.</p>';
      document.getElementById('preview-event-total').textContent = `${previewEvents.length} ${previewEvents.length === 1 ? 'actie' : 'acties'}`;
    }

    function updateContext(twin) {
      const status = statusPresentation(twin.status);
      const badge = document.getElementById('preview-twin-status');
      badge.textContent = status.label;
      badge.className = `twin-status-badge ${status.className}`;
      badge.setAttribute('aria-valuenow', String(status.progress));
      badge.setAttribute('aria-valuetext', status.label);
      const query = new URLSearchParams({ role, id: twin.id });
      document.getElementById('preview-back-to-learningbox').href = `/learningbox?${query}`;
      document.getElementById('preview-description-link').href = `/learningbox?${query}`;
      const editorLink = document.getElementById('preview-editor-link');
      editorLink.hidden = !['architect', 'technologist'].includes(role);
      editorLink.href = `/editor?${query}`;
      const note = document.getElementById('preview-access-note');
      note.textContent = statusIsPublic(twin.status) ? 'Deze Preview is vanaf PILOT voor iedereen zichtbaar.' : 'Deze Preview is nog alleen intern zichtbaar.';
    }

    function generatedPreviewFor(twin) {
      try {
        const generated = JSON.parse(sessionStorage.getItem('leerpret.generatedPreview') || 'null');
        if (!generated || generated.leerbox_id !== twin.id) return null;
        if (isPublicReader() && !statusIsPublic(generated.capture?.metadata?.status)) return null;
        return generated;
      } catch (_) { return null; }
    }

    function showPreview(twin) {
      updateContext(twin);
      activeCapture = twin;
      previewEvents = [];
      const generated = generatedPreviewFor(twin);
      let url;
      if (generated) {
        activeCapture = generated.capture;
        url = new URL(generated.preview_url, apiRootUrl());
      } else {
        const slug = String(twin.id || '').replace(/^leerbox-/, '');
        url = new URL(`${apiRootUrl()}/tools/leerbox/${encodeURIComponent(slug)}/`);
      }
      url.searchParams.set('role', role);
      document.getElementById('preview-title').textContent = twin.title || twin.id;
      document.getElementById('preview-device-address').textContent = twin.title || twin.id;
      document.getElementById('preview-standalone-link').href = url.toString();
      document.getElementById('preview-iframe').src = url.toString();
      document.getElementById('preview-page-message').hidden = true;
      document.getElementById('preview-stage').hidden = false;
      renderOverlay();
    }

    async function loadPreviewPage() {
      initSettings();
      const endpoint = isPublicReader() ? '/public/leerbox-previews' : '/simulator/datasets';
      const response = await apiGet(endpoint);
      twins = sortTwinsByStatus(response.leerbox_twins || []);
      if (isPublicReader()) twins = twins.filter((twin) => statusIsPublic(twin.status));
      const select = document.getElementById('preview-twin-select');
      if (!twins.length) {
        select.innerHTML = '<option value="">Geen toegankelijke Previews</option>';
        document.getElementById('preview-page-message').textContent = 'Voor deze rol zijn nog geen Leerboxen met status PILOT of AF beschikbaar.';
        return;
      }
      const requestedAccessible = twins.some((twin) => twin.id === activeTwinId);
      activeTwinId = requestedAccessible ? activeTwinId : twins[0].id;
      select.innerHTML = twins.map((twin) => `<option value="${escapeHtml(twin.id)}">${escapeHtml(twin.title || twin.id)}</option>`).join('');
      select.value = activeTwinId;
      localStorage.setItem('leerpret.leerbox.id', activeTwinId);
      showPreview(twins.find((twin) => twin.id === activeTwinId));
      select.addEventListener('change', () => {
        activeTwinId = select.value;
        localStorage.setItem('leerpret.leerbox.id', activeTwinId);
        const url = new URL(window.location.href); url.searchParams.set('id', activeTwinId); url.searchParams.set('role', role); url.searchParams.delete('generated'); history.replaceState({}, '', url);
        showPreview(twins.find((twin) => twin.id === activeTwinId));
      });
    }

    window.addEventListener('message', (event) => {
      const frame = document.getElementById('preview-iframe');
      if (event.origin !== new URL(apiRootUrl()).origin || event.source !== frame?.contentWindow) return;
      if (event.data?.type === 'leerpret-preview-events') {
        receivePreviewEvents(event.data.events);
      }
    });

    window.addEventListener('service-connection-changed', (event) => {
      if (event.detail?.authorized) checkPreviewTelemetryLogin();
    });

    window.addEventListener('DOMContentLoaded', () => {
      initSettings();
      checkPreviewTelemetryLogin();
      document.querySelectorAll('[data-preview-device]').forEach((button) => button.addEventListener('click', () => setPreviewDevice(button.getAttribute('data-preview-device'))));
      if (window.matchMedia('(max-width: 899px)').matches) document.querySelector('.preview-overlay-menu')?.removeAttribute('open');
      setPreviewDevice(activeDevice);
      new ResizeObserver(fitPreviewDevice).observe(document.getElementById('preview-device-area'));
      loadPreviewPage().then(fitPreviewDevice).catch((error) => {
        document.getElementById('preview-page-message').textContent = `Preview kon niet worden geladen: ${error.message || error}`;
      });
    });
  </script>
</Layout>

<style is:global>
