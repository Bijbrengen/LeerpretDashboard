---
interface Props {
  scope: 'engine' | 'service' | 'data';
  title: string;
}

const { scope, title } = Astro.props;
---

<div class="source-browser-card" data-source-browser data-source-scope={scope} data-source-review-enabled={scope === 'engine' ? 'true' : 'false'} aria-label={`Codebrowser voor ${title}`}>
  <header class="source-titlebar">
    <span class="source-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <strong>{title} — Code</strong>
  </header>
  <div class="source-workbench">
    <aside class="source-explorer" aria-label="Bestandsverkenner">
      <div class="source-explorer-heading">EXPLORER</div>
      {scope === 'engine' && (
        <div class="source-review-filters" data-source-review-filters>
          <div class="source-filter-toggle" role="group" aria-label="Codebestanden filteren">
            <button type="button" class="active" data-source-filter="todo" aria-pressed="true">To-do</button>
            <button type="button" data-source-filter="all" aria-pressed="false">Alle bestanden</button>
          </div>
          <p data-source-review-summary>Reviewstatus ladenâ€¦</p>
        </div>
      )}
      <div class="source-file-tree" data-source-tree>
        <p class="source-loading">Bestanden laden…</p>
      </div>
      <details class="source-outline-panel" data-source-outline open>
        <summary>OUTLINE</summary>
        <div class="source-outline-tree" data-source-outline-tree>
          <p class="source-outline-empty">Open een bestand om de symbolen te bekijken.</p>
        </div>
      </details>
    </aside>
    <section class="source-editor" aria-label="Codeweergave">
      <div class="source-editor-tabbar">
        <span class="source-file-type">PY</span>
        <strong data-source-tab>Selecteer een bestand</strong>
        <button type="button" class="source-test-button" data-source-test hidden>Unittest</button>
        {scope === 'engine' && <button type="button" class="source-approve-button" data-source-approve hidden>Gecheckt</button>}
      </div>
      <nav class="source-breadcrumbs" data-source-breadcrumbs aria-label="Codepositie">
        <span>Geen bestand geselecteerd</span>
      </nav>
      <div class="source-editor-scroll">
        <ol class="source-code-lines" data-source-lines aria-live="polite">
          <li><code>Kies links een bestand om de broncode te bekijken.</code></li>
        </ol>
      </div>
      <section class="source-test-result" data-source-test-result hidden aria-live="polite"></section>
      <footer class="source-statusbar">
        <span data-source-path>Geen bestand geselecteerd</span>
        <span data-source-meta>Python · alleen-lezen</span>
      </footer>
    </section>
  </div>
</div>

<script>
  import { initializeSourceBrowsers } from '../js/sourceBrowser.js';
  window.addEventListener('DOMContentLoaded', () => initializeSourceBrowsers());
</script>

<style is:global>
  .source-browser-card{background:#181818;border:1px solid #3c3c3c;border-radius:12px;box-shadow:0 18px 42px rgba(15,23,42,.18);color:#d4d4d4;overflow:hidden}.source-titlebar{align-items:center;background:#323233;border-bottom:1px solid #454545;display:grid;font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;font-size:.78rem;grid-template-columns:76px 1fr 76px;min-height:38px;padding:0 12px;text-align:center}.source-window-dots{display:flex;gap:6px}.source-window-dots i{background:#ff5f57;border-radius:50%;height:10px;width:10px}.source-window-dots i:nth-child(2){background:#febc2e}.source-window-dots i:nth-child(3){background:#28c840}.source-workbench{display:grid;grid-template-columns:minmax(190px,250px) minmax(0,1fr);min-height:560px}.source-explorer{background:#252526;border-right:1px solid #3c3c3c;min-width:0;overflow:auto}.source-explorer-heading{color:#bbb;font-size:.68rem;font-weight:750;letter-spacing:.08em;padding:12px 14px 8px}.source-file-tree{color:#ccc;font-family:"Plus Jakarta Sans",system-ui,sans-serif;font-size:.72rem;padding-bottom:12px}.source-loading{color:#a0a0a0;margin:8px 14px}.source-folder{margin:0}.source-folder summary{color:#d7d7d7;cursor:pointer;font-weight:700;overflow:hidden;padding:5px 10px 5px calc(10px + var(--source-depth,0) * 12px);text-overflow:ellipsis;white-space:nowrap}.source-file-button{align-items:center;background:transparent;border:0;color:#ccc;cursor:pointer;display:flex;font:inherit;gap:7px;overflow:hidden;padding:5px 10px 5px calc(14px + var(--source-depth,1) * 12px);text-align:left;width:100%}.source-file-button:hover,.source-file-button:focus{background:#2a2d2e;outline:none}.source-file-button.active{background:#37373d;color:#fff}.source-file-button span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-python-icon,.source-file-type{color:#4fc1ff;flex:0 0 auto;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.6rem;font-weight:900}.source-editor{background:#1e1e1e;display:grid;grid-template-rows:36px minmax(0,1fr) 24px;min-width:0}.source-editor-tabbar{align-items:center;background:#252526;border-bottom:1px solid #2d2d2d;display:flex;gap:8px;min-width:0;padding:0 14px}.source-editor-tabbar strong{color:#e7e7e7;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-editor-scroll{max-height:500px;overflow:auto}.source-code-lines{color:#d4d4d4;counter-reset:source-line;font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;font-size:.77rem;line-height:1.55;list-style:none;margin:0;min-width:max-content;padding:12px 18px 28px 64px}.source-code-lines li{counter-increment:source-line;min-height:1.55em;position:relative;white-space:pre}.source-code-lines li::before{color:#858585;content:counter(source-line);left:-54px;position:absolute;text-align:right;width:38px}.source-code-lines code{color:inherit;font:inherit}.source-statusbar{align-items:center;background:#007acc;color:#fff;display:flex;font-size:.64rem;gap:12px;justify-content:space-between;min-width:0;padding:0 10px}.source-statusbar span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@media(max-width:720px){.source-workbench{grid-template-columns:1fr;grid-template-rows:minmax(150px,220px) minmax(420px,1fr)}.source-explorer{border-bottom:1px solid #3c3c3c;border-right:0}}
  .source-review-filters{border-bottom:1px solid #3c3c3c;padding:0 10px 9px}.source-filter-toggle{background:#1f1f1f;border:1px solid #454545;border-radius:6px;display:grid;grid-template-columns:1fr 1fr;overflow:hidden}.source-filter-toggle button{background:transparent;border:0;color:#aaa;cursor:pointer;font:inherit;font-size:.66rem;font-weight:750;padding:6px 4px}.source-filter-toggle button.active{background:#0e639c;color:white}.source-review-filters p{color:#969696;font-size:.61rem;margin:7px 2px 0}.source-review-icon{align-items:center;border-radius:50%;display:flex;flex:0 0 auto;font-size:.62rem;font-weight:900;height:16px;justify-content:center;width:16px}.source-review-icon.is-approved{background:#2d6f3b;color:#d7ffd9}.source-review-icon.is-pending{background:#7a5a16;color:#ffe6a3}.source-approve-button{background:#237a3b;border:1px solid #3fa457;border-radius:5px;color:white;cursor:pointer;font:inherit;font-size:.64rem;font-weight:800;margin-left:auto;padding:4px 8px}.source-approve-button:hover{background:#2e8b47}.source-approve-button.is-approved{background:#2d3439;border-color:#5b6268;color:#b9c0c5}.source-approve-button:disabled{cursor:wait;opacity:.65}
  .source-workbench{grid-template-columns:minmax(210px,270px) minmax(0,1fr)}.source-explorer{display:flex;flex-direction:column;overflow:hidden}.source-file-tree{flex:1 1 55%;min-height:150px;overflow:auto}.source-editor{grid-template-rows:36px 30px minmax(0,1fr) auto 24px}.source-code-lines li.source-line-target{background:rgba(38,121,188,.24);box-shadow:inset 2px 0 #4fc1ff;outline:none}.source-outline-panel{border-top:1px solid #3c3c3c;flex:0 1 45%;min-height:34px;overflow:auto}.source-outline-panel>summary{background:#252526;color:#d7d7d7;cursor:pointer;font-size:.66rem;font-weight:800;letter-spacing:.07em;padding:9px 12px;position:sticky;top:0;z-index:2}.source-outline-tree{padding:3px 0 10px}.source-outline-empty{color:#8d8d8d;font-size:.66rem;line-height:1.4;margin:7px 12px}.source-symbol-button{align-items:center;background:transparent;border:0;color:#ccc;cursor:pointer;display:flex;font:inherit;font-size:.68rem;gap:7px;overflow:hidden;padding:4px 8px 4px calc(10px + var(--symbol-depth,0) * 14px);text-align:left;width:100%}.source-symbol-button:hover,.source-symbol-button:focus,.source-symbol-button.active{background:#37373d;color:white;outline:none}.source-symbol-button span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-symbol-icon{align-items:center;display:flex;flex:0 0 auto;height:15px;justify-content:center;width:15px}.source-symbol-icon svg{height:14px;width:14px}.source-symbol-icon.class{color:#e5c07b}.source-symbol-icon.function{color:#c586c0}.source-symbol-icon.object{color:#9cdcfe}.source-breadcrumbs{align-items:center;background:#1e1e1e;border-bottom:1px solid #2d2d2d;display:flex;min-width:0;overflow-x:auto;padding:0 10px}.source-breadcrumb-item{align-items:center;display:flex;flex:0 0 auto;position:relative}.source-breadcrumb-item:not(:last-child)::after{color:#707070;content:'›';font-size:.8rem;margin:0 2px}.source-breadcrumb-button{background:transparent;border:0;color:#bcbcbc;cursor:pointer;font:inherit;font-size:.67rem;padding:5px 4px;white-space:nowrap}.source-breadcrumb-button:hover,.source-breadcrumb-button[aria-expanded=true]{color:white}.source-breadcrumb-menu{background:#252526;border:1px solid #454545;box-shadow:0 8px 20px rgba(0,0,0,.32);display:grid;left:0;max-height:240px;min-width:180px;overflow:auto;position:fixed;z-index:30}.source-breadcrumb-menu[hidden]{display:none}.source-breadcrumb-option{align-items:center;background:transparent;border:0;color:#ddd;cursor:pointer;display:flex;font:inherit;font-size:.68rem;gap:7px;padding:6px 9px;text-align:left;white-space:nowrap}.source-breadcrumb-option:hover{background:#094771}.source-breadcrumb-option svg{height:13px;width:13px}@media(max-width:720px){.source-workbench{grid-template-rows:minmax(220px,320px) minmax(420px,1fr)}}
  .source-test-button{background:#0e639c;border:1px solid #3096d1;border-radius:5px;color:white;cursor:pointer;font:inherit;font-size:.64rem;font-weight:800;margin-left:auto;padding:4px 9px}.source-test-button:hover{background:#1177bb}.source-test-button:disabled{cursor:wait;opacity:.65}.source-test-button+.source-approve-button{margin-left:0}.source-test-result{background:#151515;border-top:1px solid #3c3c3c;color:#d4d4d4;max-height:280px;overflow:auto;padding:12px 14px}.source-test-result[hidden]{display:none}.source-test-result-header{align-items:center;display:flex;gap:9px;justify-content:space-between;margin-bottom:9px}.source-test-result-header strong{font-size:.74rem}.source-test-badge{border-radius:999px;font-size:.61rem;font-weight:900;padding:3px 8px;text-transform:uppercase}.source-test-badge.passed{background:#255f35;color:#d7ffd9}.source-test-badge.failed,.source-test-badge.timeout{background:#7a2e2e;color:#ffd7d7}.source-test-io{display:grid;gap:9px;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.source-test-io article{background:#1e1e1e;border:1px solid #343434;border-radius:7px;min-width:0;padding:8px}.source-test-io h4{color:#9cdcfe;font-size:.66rem;letter-spacing:.06em;margin:0 0 6px;text-transform:uppercase}.source-test-io pre{color:#d4d4d4;font:500 .66rem/1.45 ui-monospace,SFMono-Regular,Consolas,monospace;margin:0;overflow:auto;white-space:pre-wrap}.source-test-streams{margin-top:9px}.source-test-streams details{border-top:1px solid #343434;padding:6px 0}.source-test-streams summary{cursor:pointer;font-size:.67rem;font-weight:750}.source-test-streams pre{color:#c8c8c8;font:500 .64rem/1.45 ui-monospace,SFMono-Regular,Consolas,monospace;margin:7px 0 0;white-space:pre-wrap}@media(max-width:720px){.source-test-io{grid-template-columns:1fr}}
</style>
