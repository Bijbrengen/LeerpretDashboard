<div class="data-structure-layout data-structure-layout-content-only" data-structure-viewer>
    <main class="structure-content">
      <header class="structure-header">
        <div>
          <span class="eyebrow">Leerpret datamodel</span>
          <h2 data-view-title>Datastroom en verbindingen</h2>
          <p data-view-description>Volg actuele objecten van Person-ID via Acties naar de Leerbox en meting.</p>
        </div>
        <div class="structure-actions">
          <span class="snapshot-state"><i></i> Demonstratieset</span>
          <button type="button" data-reset-view title="Herstel zoom en selectie">Alles tonen</button>
        </div>
      </header>

      <section class="structure-stage">
        <div class="structure-panel" data-structure-panel="network">
          <svg id="data-network-svg" role="img" aria-label="Interactieve netwerkgraaf van Leerpret-data"></svg>
        </div>
        <div class="structure-panel" data-structure-panel="erd" hidden>
          <svg id="data-erd-svg" role="img" aria-label="Interactief databaseschema van Leerpret-data"></svg>
        </div>

        <aside class="metadata-panel" data-metadata-panel hidden aria-live="polite">
          <header>
            <div><span data-metadata-type>Object</span><h3 data-metadata-title>Metadata</h3></div>
            <button type="button" data-close-metadata aria-label="Sluit metadata">Ã—</button>
          </header>
          <div class="metadata-relation-note"><i></i> Verbonden pad gemarkeerd</div>
          <p>Ruwe JSON-metadata</p>
          <pre><code data-metadata-json>{}</code></pre>
        </aside>
      </section>

      <footer class="structure-footer">
        <span><strong>8</strong> objecten</span><span><strong>11</strong> verbindingen</span><span><strong>6</strong> modellen</span>
        <p>De demonstratieset bevat uitsluitend fictieve, niet-herleidbare gegevens.</p>
      </footer>
    </main>
  </div>

<script>
  import { initializeDataStructureViewer } from '../js/dataStructureViewer.js';
  window.addEventListener('DOMContentLoaded', initializeDataStructureViewer);
</script>

