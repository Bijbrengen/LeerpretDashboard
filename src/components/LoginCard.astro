---
// LoginCard.astro - Minimalistic, privacy-by-design Google Sign-in component
---

<div class="login-card">
  <div class="login-card-header">
    <div class="shield-icon">🛡️</div>
    <h3>Veilig &amp; pseudoniem aanmelden</h3>
    <p class="login-subtitle">Toegang tot de Leerpret-engine via een afzonderlijke, verwijderbare accountkoppeling.</p>
  </div>

  <div class="login-action-area">
    <!-- Google Sign-In Trigger Button -->
    <button class="google-login-btn" id="google-login-trigger">
      <svg class="google-logo" viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      <span>Log in met Google</span>
    </button>
  </div>
  <label class="profile-choice">
    <input id="share-google-profile" type="checkbox" />
    <span>
      Deel eenmalig mijn naam en e-mailadres, zodat ik verhoogde rechten kan
      aanvragen. Zonder deze koppeling blijven alleen de basisfuncties beschikbaar.
    </span>
  </label>
  <p id="login-status" class="login-status" role="status" aria-live="polite"></p>

  <div class="privacy-bullet-points">
    <div class="privacy-bullet">
      <span class="bullet-check">✓</span>
      <div class="bullet-content">
        <strong>Privacy by Design</strong>
        <span>Wij slaan geen wachtwoorden of lokale accounts op. Inloggen verloopt volledig beveiligd via Google Sign-In.</span>
      </div>
    </div>

    <div class="privacy-bullet">
      <span class="bullet-check">✓</span>
      <div class="bullet-content">
        <strong>Pseudonieme koppeling</strong>
        <span>Naam en e-mailadres worden niet bij actiereeksen opgeslagen. Een unieke aanmeld-ID staat uitsluitend in een afzonderlijke, verwijderbare koppellaag.</span>
      </div>
    </div>

    <div class="privacy-bullet">
      <span class="bullet-check">✓</span>
      <div class="bullet-content">
        <strong>U Beheert Uw Data</strong>
        <span>U kunt de accountkoppeling verwijderen. De actiereeksen blijven voor training en groepsstatistiek bestaan onder stabiele pseudonieme persoon- en groepssleutels, met fictief verschoven tijdstippen en een verwijzing naar de gebruikte Leerbox-versie.</span>
      </div>
    </div>
  </div>

  <div class="login-card-footer">
    <p>
      <a href="/privacy">Lees hoe Leerpret actiereeksen verwerkt</a>.<br />
      Nog geen Google-account? 
      <a href="https://accounts.google.com/signup" target="_blank" rel="noopener noreferrer">Maak er gratis een aan</a>. 
      Ons systeem staat wegens privacyrichtlijnen geen lokale registraties toe.
    </p>
  </div>
</div>

<style>
  .login-card {
    background: var(--panel, #ffffff);
    border: 1px solid var(--line, #e2e8f0);
    border-radius: 16px;
    padding: 32px;
    max-width: 440px;
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .login-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
  }

  .login-card-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .shield-icon {
    font-size: 2.2rem;
    margin-bottom: 4px;
  }

  .login-card-header h3 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ink, #1e293b);
    font-family: var(--font-heading, 'Outfit', sans-serif);
  }

  .login-subtitle {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted, #64748b);
    line-height: 1.4;
  }

  .privacy-bullet-points {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .privacy-bullet {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .bullet-check {
    color: var(--blue, #3b82f6);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.2;
  }

  .bullet-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bullet-content strong {
    font-size: 0.88rem;
    color: var(--ink, #1e293b);
  }

  .bullet-content span {
    font-size: 0.78rem;
    color: var(--muted, #64748b);
    line-height: 1.45;
  }

  .login-action-area {
    display: flex;
    justify-content: center;
  }

  .google-login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #ffffff;
    color: #1f2937;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    width: 100%;
    font-family: var(--font-body, inherit);
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .google-login-btn:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
  }

  .google-logo {
    flex-shrink: 0;
  }

  .login-status {
    min-height: 1.25rem;
    margin: -12px 0 0;
    color: var(--muted, #64748b);
    font-size: 0.78rem;
    text-align: center;
  }

  .login-status.is-error {
    color: #b91c1c;
  }

  .profile-choice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--muted, #64748b);
  }

  .login-card-footer {
    border-top: 1px dashed var(--line, #e2e8f0);
    padding-top: 16px;
    text-align: center;
  }

  .login-card-footer p {
    margin: 0;
    font-size: 0.74rem;
    color: var(--muted, #64748b);
    line-height: 1.5;
  }

  .login-card-footer a {
    color: var(--blue, #3b82f6);
    text-decoration: none;
    font-weight: 700;
  }

  .login-card-footer a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { apiPost } from '../js/api.js';
  const loginBtn = document.getElementById('google-login-trigger');
  const loginStatus = document.getElementById('login-status');
  const profileChoice = document.getElementById('share-google-profile');

  function getDashboardBase() {
    if (typeof window === 'undefined') return '/';
    return window.location.pathname.startsWith('/LeerpretDashboard') ? '/LeerpretDashboard/' : '/';
  }

  function safeReturnTarget(rawTarget) {
    const base = getDashboardBase();
    if (!rawTarget) return base;
    try {
      const target = new URL(rawTarget, window.location.origin);
      const current = new URL(window.location.href);
      const isSameOrigin = target.origin === current.origin;
      const isSameHost = target.hostname === current.hostname;
      const isLocalLoopback = ['127.0.0.1', 'localhost'].includes(target.hostname)
        && ['127.0.0.1', 'localhost'].includes(current.hostname)
        && target.protocol === current.protocol;
      return isSameOrigin || isSameHost || isLocalLoopback ? target.href : base;
    } catch {
      return base;
    }
  }

  function clearGoogleCallbackParameters() {
    const cleanUrl = new URL(window.location.href);
    ['code', 'state', 'scope', 'authuser', 'prompt', 'hd', 'iss'].forEach((name) => cleanUrl.searchParams.delete(name));
    window.history.replaceState({}, '', cleanUrl);
  }

  async function completeGoogleLogin() {
    const parameters = new URLSearchParams(window.location.search);
    const code = parameters.get('code');
    if (!code) return false;
    const expectedState = sessionStorage.getItem('leerpret.oauth.state');
    if (!expectedState || parameters.get('state') !== expectedState) {
      throw new Error('De Google-aanmelding kon niet veilig worden bevestigd.');
    }
    const shareProfile = sessionStorage.getItem('leerpret.oauth.shareProfile') === 'true';
    const redirectUri = sessionStorage.getItem('leerpret.oauth.redirectUri')
      || `${window.location.origin}${window.location.pathname}`;
    if (new URL(redirectUri).origin !== window.location.origin) {
      throw new Error('De terugkeer-URL van de Google-aanmelding is ongeldig.');
    }
    if (loginBtn) loginBtn.disabled = true;
    let result;
    try {
      result = await apiPost('/auth/google-code', {
        code,
        redirect_uri: redirectUri,
        share_profile: shareProfile
      }, { 'X-Requested-With': 'XmlHttpRequest' });
    } catch (error) {
      // Alleen een antwoord van de Engine bewijst dat Google de code definitief
      // heeft verwerkt of geweigerd. Bij een loader-/netwerkfout blijft de code
      // staan, zodat verversen veilig opnieuw kan proberen.
      if (error && typeof error === 'object' && error.status === 401) clearGoogleCallbackParameters();
      throw error;
    }
    clearGoogleCallbackParameters();
    if (!result?.session_token) {
      throw new Error('De Engine heeft geen browsersessie teruggegeven.');
    }
    sessionStorage.setItem('leerpret.browserSession', result.session_token);
    if (shareProfile) await apiPost('/auth/access-request', {});
    
    localStorage.removeItem('leerpret.loggedOut');
    localStorage.setItem('api_key', 'google-session');
    localStorage.setItem('leerpret.apiKey', 'google-session');
    if (result && Array.isArray(result.roles) && result.roles.includes('architect')) {
      localStorage.setItem('active_role', 'architect');
      localStorage.setItem('leerpret.poc.role', 'architect');
    }

    const returnTarget = safeReturnTarget(sessionStorage.getItem('leerpret.oauth.return'));
    sessionStorage.removeItem('leerpret.oauth.state');
    sessionStorage.removeItem('leerpret.oauth.shareProfile');
    sessionStorage.removeItem('leerpret.oauth.redirectUri');
    sessionStorage.removeItem('leerpret.oauth.return');
    window.location.href = returnTarget;
    return true;
  }

  completeGoogleLogin().catch((error) => {
    if (loginBtn) loginBtn.disabled = false;
    if (loginStatus) {
      loginStatus.textContent = error instanceof Error ? error.message : 'Aanmelden is niet gelukt.';
      loginStatus.classList.add('is-error');
    }
  });

  if (loginBtn) {
    loginBtn.addEventListener('click', async () => {
      // Get role from URL query parameters, fallback to 'lerende'
      const urlParams = new URLSearchParams(window.location.search);
      const targetRole = urlParams.get('role') || 'lerende';
      const authScope = urlParams.get('auth_scope');
      const isLeerboxLogin = authScope === 'leerbox';
      const leerboxId = urlParams.get('leerbox_id') || '';
      const returnTarget = safeReturnTarget(urlParams.get('return'));
      const apiBase = String(
        urlParams.get('api')
        || localStorage.getItem('api_base')
        || window.LEERPRET_CONFIG.apiBase
      ).replace(/\/+$/, '');

      loginBtn.disabled = true;
      if (loginStatus) {
        loginStatus.textContent = isLeerboxLogin
          ? 'Beperkte leerbox-sessie maken…'
          : 'Sessie maken…';
        loginStatus.classList.remove('is-error');
      }

      // Dit is nog de lokale ontwikkelsimulatie van Google Sign-In. De
      // organisatiegegevens blijven in de centrale login en komen niet in de
      // leerbox terecht.
      localStorage.removeItem('leerpret.loggedOut');
      localStorage.setItem('api_base', apiBase);
      localStorage.setItem('leerpret.apiBase', apiBase);

      try {
        const googleConfig = await import('../js/api.js').then(({ apiGet }) => apiGet('/auth/google/config'));
        if (googleConfig.enabled) {
          const shareProfile = Boolean(profileChoice?.checked);
          const oauthState = crypto.randomUUID();
          const redirectUri = `${window.location.origin}${window.location.pathname}`;
          sessionStorage.setItem('leerpret.oauth.state', oauthState);
          sessionStorage.setItem('leerpret.oauth.shareProfile', String(shareProfile));
          sessionStorage.setItem('leerpret.oauth.redirectUri', redirectUri);
          sessionStorage.setItem('leerpret.oauth.return', returnTarget);
          const authorization = new URL('https://accounts.google.com/o/oauth2/v2/auth');
          authorization.searchParams.set('client_id', googleConfig.client_id);
          authorization.searchParams.set('redirect_uri', redirectUri);
          authorization.searchParams.set('response_type', 'code');
          authorization.searchParams.set('scope', shareProfile ? googleConfig.optional_profile_scope : googleConfig.scope);
          authorization.searchParams.set('state', oauthState);
          authorization.searchParams.set('prompt', 'select_account');
          window.location.href = authorization.toString();
          return;
        }
        const organization = localStorage.getItem('org_id') || 'local-dev';
        const apiKey = localStorage.getItem('api_key') || 'leerpret-local-dev';
        const endpoint = isLeerboxLogin ? '/auth/leerbox/session' : '/auth/session';
        const body = isLeerboxLogin
          ? { organization, api_key: apiKey, leerbox_id: leerboxId }
          : { organization, api_key: apiKey };
        if (isLeerboxLogin && !leerboxId) throw new Error('De leerbox-ID ontbreekt.');

        await apiPost(endpoint, body);

        if (!isLeerboxLogin) {
          localStorage.setItem('org_id', organization);
          localStorage.setItem('leerpret.organization', organization);
          localStorage.setItem('api_key', apiKey);
          localStorage.setItem('leerpret.apiKey', apiKey);
          localStorage.setItem('active_role', targetRole);
          localStorage.setItem('leerpret.poc.role', targetRole);
        }
        // Zowel de leerbox- als de organisatie-login honoreren een veilige
        // return (bv. terug naar de standalone editor). safeReturnTarget valt
        // terug op '/' als er geen geldige return is meegegeven.
        window.location.href = returnTarget;
      } catch (error) {
        if (loginStatus) {
          loginStatus.textContent = error instanceof Error ? error.message : 'Aanmelden is niet gelukt.';
          loginStatus.classList.add('is-error');
        }
        loginBtn.disabled = false;
      }
    });
  }
</script>
